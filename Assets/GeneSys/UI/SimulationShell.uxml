<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="SimulationTheme.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="left-column" class="left-column" picking-mode="Ignore">
            <ui:VisualElement name="clock-panel" class="clock-panel">
                <ui:VisualElement class="clock-buttons">
                    <ui:Button name="play" text="Pause" />
                    <ui:Button name="step" text="Step" />
                    <ui:Button name="regenerate" text="Regenerate" class="row-last" />
                </ui:VisualElement>
                <ui:Slider name="speed" label="Speed" low-value="0.05" high-value="8" show-input-field="true" />
                <ui:DropdownField name="overlay" label="Overlay" />
                <ui:Label name="status" text="Initializing GeneSys..." class="status" />
            </ui:VisualElement>

            <ui:VisualElement name="inspector-panel" class="inspector-panel">
                <ui:Label text="Inspector" class="section-title inspector-title" />
                <ui:Label name="inspection" text="No cell selected." class="inspection" />
            </ui:VisualElement>

            <ui:VisualElement name="tools-drawer" class="drawer tools-drawer">
                <ui:Button name="tools-header" text="Tools ▾" class="drawer-header" />
                <ui:VisualElement name="tools-body" class="drawer-body">
                    <ui:Label text="Brush and Material Tools" class="section-title" />
                    <ui:DropdownField name="brush-mode" label="Brush Mode" />
                    <ui:DropdownField name="material" label="Material" />
                    <ui:SliderInt name="brush-radius" label="Radius" low-value="1" high-value="64" show-input-field="true" />
                    <ui:Slider name="brush-strength" label="Strength" low-value="0.01" high-value="10" show-input-field="true" />
                    <ui:Label text="Selected Material Properties" class="section-title" />
                    <ui:ScrollView name="material-settings" class="settings-scroll" />
                    <ui:VisualElement class="command-row">
                        <ui:Button name="validate" text="Validate" />
                        <ui:Button name="save" text="Save" />
                        <ui:Button name="load" text="Load" class="row-last" />
                    </ui:VisualElement>
                    <ui:Label text="Left drag paints. Right click inspects. Middle drag pans. Mouse wheel zooms. Q/E rotates. Validation checks finite values and tracked water conservation." class="help" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="right-column" class="right-column" picking-mode="Ignore">
            <ui:VisualElement name="settings-drawer" class="drawer settings-drawer collapsed">
                <ui:Button name="settings-header" text="Simulation Settings ▸" class="drawer-header" />
                <ui:VisualElement name="settings-body" class="drawer-body collapsed">
                    <ui:VisualElement class="tab-row">
                        <ui:Button name="tab-world" text="World" class="tab-button tab-button--active" />
                        <ui:Button name="tab-geology" text="Geo" class="tab-button" />
                        <ui:Button name="tab-hydrology" text="Water" class="tab-button" />
                        <ui:Button name="tab-weather" text="Weather" class="tab-button" />
                        <ui:Button name="tab-performance" text="Perf" class="tab-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tab-row tab-row-secondary">
                        <ui:Button name="tab-ecology" text="Ecology" class="tab-button" />
                        <ui:Button name="tab-combustion" text="Fire" class="tab-button" />
                        <ui:Button name="tab-storm" text="Storm" class="tab-button" />
                        <ui:Button name="tab-probe" text="Probe" class="tab-button" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-world" class="settings-page">
                        <ui:Label text="World" class="section-title" />
                        <ui:Label name="world-metrics" text="Ocean coverage -- | Basins --" class="help" />
                        <ui:ScrollView name="settings-container" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-geology" class="settings-page hidden">
                        <ui:Label text="Geology" class="section-title" />
                        <ui:Label text="Select Fault/Stress or Pressure overlays to tune faults, extrusion, magma pressure, viscosity, cooling, and Magma Eruption. Ash appears in the Material overlay." class="help" />
                        <ui:ScrollView name="settings-geology" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-hydrology" class="settings-page hidden">
                        <ui:Label text="Hydrology" class="section-title" />
                        <ui:Label text="Moisture, groundwater, nutrient/soil quality, and flow overlays expose infiltration, aquifers, caves, erosion, deposition, and ash fertilization." class="help" />
                        <ui:ScrollView name="settings-hydrology" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-weather" class="settings-page hidden">
                        <ui:Label text="Weather" class="section-title" />
                        <ui:Label text="Temperature, pressure, wind, and vapor overlays show orbital heating and the complete water cycle." class="help" />
                        <ui:ScrollView name="settings-weather" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-ecology" class="settings-page hidden">
                        <ui:Label text="Ecology" class="section-title" />
                        <ui:Label text="Mycology overlay shows spores and colony strength. Colonized soil tints forest green and sediment sage green in the Material view. Growth requires soil or sediment inside the temperature and moisture bands; survival is the wider outer range." class="help" />
                        <ui:ScrollView name="settings-ecology" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-combustion" class="settings-page hidden">
                        <ui:Label text="Combustion" class="section-title" />
                        <ui:Label text="Fire needs heat, oxygen, and mycology fuel. Burning dumps heat and pressure into weather, flashes nearby water into steam, and can smother itself. Use the Fire and Oxygen overlays, or the Ignite brush." class="help" />
                        <ui:ScrollView name="settings-combustion" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-storm" class="settings-page hidden">
                        <ui:Label text="Storm and Lightning" class="section-title" />
                        <ui:Label text="Cloud, updraft, and mixed-phase temperatures separate atmospheric charge. Breakdown fires a sheet across the sky or a strike that prefers conductive ground, dumping heat, thunder, charge, and ignition. Use the Storm Charge overlay." class="help" />
                        <ui:ScrollView name="settings-storm" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-probe" class="settings-page hidden">
                        <ui:Label text="Probe" class="section-title" />
                        <ui:Label text="The probe orbits clockwise along the atmosphere glow, opposite the sun. Hold HUD icons to deposit vapor, water, soil, heat, or cool at the outer ring ahead of its path. Use the camera card to follow the orbiter or return to the globe view." class="help" />
                        <ui:ScrollView name="settings-probe" class="settings-scroll" />
                    </ui:VisualElement>

                    <ui:VisualElement name="page-performance" class="settings-page hidden">
                        <ui:Label text="Performance" class="section-title" />
                        <ui:Label text="Graphics controls tune ambient space visuals without changing simulation physics. Validation settings remain below." class="help" />
                        <ui:ScrollView name="settings-performance" class="settings-scroll" />
                        <ui:VisualElement class="command-row">
                            <ui:Button name="save-preset" text="Save Preset" />
                            <ui:Button name="load-preset" text="Load Preset" class="row-last" />
                        </ui:VisualElement>
                        <ui:Button name="restore-defaults" text="Restore Default Settings" />
                        <ui:Label text="Restores all simulation settings to their initial values and regenerates the world. Use the Validation preset for fast iteration." class="help" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="status-drawer" class="drawer status-drawer">
                <ui:Button name="status-header" text="Simulation Status ▾" class="drawer-header" />
                <ui:VisualElement name="status-body" class="drawer-body">
                    <ui:Label name="simulation-status" text="Gathering world stats..." class="status-stats" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="probe-dock" class="probe-dock" picking-mode="Ignore">
            <ui:VisualElement name="probe-dock-balance" class="probe-dock-balance" picking-mode="Ignore" />
            <ui:VisualElement name="probe-tools-card" class="probe-tools-card" picking-mode="Position">
                <ui:Button name="probe-action-vapor" class="probe-tool-button probe-tool-vapor" tooltip="Hold to seed vapor" />
                <ui:Button name="probe-action-water" class="probe-tool-button probe-tool-water" tooltip="Hold to add water" />
                <ui:Button name="probe-action-soil" class="probe-tool-button probe-tool-soil" tooltip="Hold to drop soil" />
                <ui:Button name="probe-action-cool" class="probe-tool-button probe-tool-cool" tooltip="Hold to cool" />
                <ui:Button name="probe-action-heat" class="probe-tool-button probe-tool-heat probe-tool-last" tooltip="Hold to heat" />
            </ui:VisualElement>
            <ui:VisualElement name="probe-camera-card" class="probe-camera-card" picking-mode="Position">
                <ui:Button name="probe-camera-follow" class="probe-camera-button probe-camera-follow" tooltip="Follow probe" />
                <ui:Button name="probe-camera-globe" class="probe-camera-button probe-camera-globe probe-camera-last probe-camera-button--active" tooltip="Globe camera" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="preset-overlay" class="preset-overlay hidden" picking-mode="Position">
            <ui:VisualElement name="preset-dialog" class="preset-dialog">
                <ui:Label name="preset-dialog-title" text="Save Preset" class="section-title" />
                <ui:VisualElement name="preset-save-group" class="preset-group">
                    <ui:Label text="Enter a filename for the current simulation settings." class="help" />
                    <ui:TextField name="preset-filename" label="Filename" />
                    <ui:Label name="preset-error" text="" class="preset-error hidden" />
                </ui:VisualElement>
                <ui:VisualElement name="preset-load-group" class="preset-group hidden">
                    <ui:Label text="Select a saved settings preset to load. The world will regenerate." class="help" />
                    <ui:ListView name="preset-list" class="preset-list" />
                    <ui:Label name="preset-empty" text="No presets found." class="help hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="command-row">
                    <ui:Button name="preset-cancel" text="Cancel" />
                    <ui:Button name="preset-confirm" text="Save" class="row-last" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="setting-tooltip" class="setting-tooltip hidden" picking-mode="Ignore">
            <ui:Label name="setting-tooltip-title" text="" class="setting-tooltip-title" />
            <ui:Label name="setting-tooltip-label" text="" class="setting-tooltip-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
