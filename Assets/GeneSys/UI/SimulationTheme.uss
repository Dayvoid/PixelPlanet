:root {
    --gs-bg-panel: rgba(8, 16, 32, 0.94);
    --gs-bg-inset: rgba(4, 10, 22, 0.9);
    --gs-bg-button: rgb(18, 36, 64);
    --gs-bg-button-hover: rgb(24, 52, 88);
    --gs-bg-button-active: rgb(16, 70, 96);
    --gs-border: rgb(40, 90, 140);
    --gs-border-strong: rgb(48, 140, 170);
    --gs-accent: rgb(72, 210, 230);
    --gs-text: rgb(210, 228, 240);
    --gs-text-muted: rgb(140, 165, 185);
}

.root {
    flex-grow: 1;
    color: rgb(210, 228, 240);
    font-size: 12px;
}

.left-column {
    position: absolute;
    top: 8px;
    left: 8px;
    bottom: 8px;
    width: 360px;
    flex-direction: column;
}

.right-column {
    position: absolute;
    top: 8px;
    right: 8px;
    bottom: 8px;
    width: 360px;
    flex-direction: column;
}

.clock-panel,
.inspector-panel,
.drawer {
    background-color: rgba(8, 16, 32, 0.94);
    border-width: 1px;
    border-color: rgb(40, 90, 140);
    border-radius: 12px;
    padding: 8px;
    overflow: hidden;
}

.clock-panel,
.inspector-panel {
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.clock-buttons {
    flex-direction: row;
    margin-bottom: 6px;
}

.clock-buttons > .unity-button {
    flex-grow: 1;
    margin-right: 4px;
}

.clock-buttons > .unity-button.row-last {
    margin-right: 0;
}

.status {
    margin-top: 4px;
    white-space: normal;
    color: rgb(72, 210, 230);
}

.inspector-title {
    margin-top: 0;
}

.inspection {
    min-height: 112px;
    padding: 8px;
    white-space: normal;
    background-color: rgba(4, 10, 22, 0.9);
    border-width: 1px;
    border-color: rgb(40, 90, 140);
    border-radius: 6px;
    color: rgb(210, 228, 240);
}

.tools-drawer {
    flex-grow: 1;
    min-height: 40px;
}

.tools-drawer.collapsed {
    flex-grow: 0;
}

.settings-drawer {
    flex-grow: 1;
    min-height: 40px;
    margin-bottom: 8px;
}

.settings-drawer.collapsed {
    flex-grow: 0;
}

.status-drawer {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 240px;
}

.status-drawer.collapsed {
    max-height: none;
}

.status-stats {
    white-space: normal;
    color: rgb(210, 228, 240);
    padding: 6px;
    background-color: rgba(4, 10, 22, 0.9);
    border-width: 1px;
    border-color: rgb(40, 90, 140);
    border-radius: 6px;
    min-height: 120px;
}

.drawer-header {
    flex-shrink: 0;
    width: 100%;
    height: 32px;
    margin-bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    background-image: none;
    background-color: rgb(18, 36, 64);
    border-width: 1px;
    border-color: rgb(48, 140, 170);
    border-radius: 8px;
    color: rgb(72, 210, 230);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 13px;
}

.drawer-header:hover {
    background-image: none;
    background-color: rgb(24, 52, 88);
    color: rgb(72, 210, 230);
}

.drawer-body {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
}

.drawer-body.collapsed {
    display: none;
    flex-grow: 0;
    margin-top: 0;
}

.command-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 6px;
}

.command-row > .unity-button {
    flex-grow: 1;
    margin-right: 4px;
}

.command-row > .unity-button.row-last {
    margin-right: 0;
}

.tab-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.tab-row-secondary {
    margin-top: -2px;
    margin-bottom: 8px;
}

.tab-row-secondary > .unity-button {
    flex-grow: 0;
    min-width: 72px;
}

.tab-row > .unity-button {
    flex-grow: 1;
    min-width: 45px;
    padding-left: 3px;
    padding-right: 3px;
}

.tab-button--active {
    background-image: none;
    background-color: rgb(16, 70, 96);
    border-color: rgb(72, 210, 230);
    color: rgb(72, 210, 230);
}

.settings-page {
    flex-grow: 1;
    min-height: 0;
}

.settings-page.hidden {
    display: none;
}

.section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 4px;
    margin-bottom: 6px;
    color: rgb(72, 210, 230);
}

.settings-scroll {
    flex-grow: 1;
    min-height: 0;
}

.settings-scroll .unity-base-field {
    margin-bottom: 2px;
}

.settings-scroll .unity-base-field:hover > .unity-base-field__label {
    color: rgb(72, 210, 230);
}

.help {
    white-space: normal;
    color: rgb(140, 165, 185);
    margin-top: 8px;
    flex-shrink: 0;
}

.probe-vapor-button {
    width: 64px;
    height: 64px;
    margin-top: 8px;
    margin-bottom: 8px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Concept/Art/Water-Icon-Sprite.png");
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 14px;
}

.probe-vapor-button:hover {
    background-image: url("project://database/Assets/Concept/Art/Water-Icon-Sprite.png");
    background-color: rgba(72, 210, 230, 0.12);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.probe-vapor-button:active,
.probe-vapor-button.probe-vapor-button--held {
    background-image: url("project://database/Assets/Concept/Art/Water-Icon-Sprite.png");
    background-color: rgba(72, 210, 230, 0.22);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.unity-button {
    background-image: none;
    background-color: rgb(18, 36, 64);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgb(48, 140, 170);
    border-radius: 8px;
    color: rgb(210, 228, 240);
}

.unity-button:hover {
    background-image: none;
    background-color: rgb(24, 52, 88);
    border-color: rgb(72, 210, 230);
    color: rgb(210, 228, 240);
}

.unity-button:active {
    background-image: none;
    background-color: rgb(16, 70, 96);
    color: rgb(72, 210, 230);
}

.unity-base-field {
    margin-top: 2px;
    margin-bottom: 2px;
    color: rgb(210, 228, 240);
}

.unity-base-field__label {
    color: rgb(210, 228, 240);
    min-width: 90px;
}

.unity-base-text-field__input,
.unity-base-popup-field__input,
.unity-base-field__input {
    background-image: none;
    background-color: rgba(4, 10, 22, 0.9);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgb(40, 90, 140);
    border-radius: 6px;
    color: rgb(210, 228, 240);
}

.unity-base-popup-field__text {
    color: rgb(210, 228, 240);
}

.unity-base-slider__tracker {
    background-image: none;
    background-color: rgba(4, 10, 22, 0.9);
    border-width: 1px;
    border-color: rgb(40, 90, 140);
    border-radius: 6px;
}

.unity-base-slider__dragger {
    background-image: none;
    background-color: rgb(72, 210, 230);
    border-radius: 6px;
}

.unity-toggle__checkmark {
    background-image: none;
    background-color: rgba(4, 10, 22, 0.9);
    border-width: 1px;
    border-color: rgb(48, 140, 170);
    border-radius: 4px;
}

.unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: rgb(16, 70, 96);
    border-color: rgb(72, 210, 230);
}

.unity-scroller {
    background-color: rgba(4, 10, 22, 0.5);
}

.unity-base-dropdown {
    background-color: rgba(8, 16, 32, 0.98);
    border-width: 1px;
    border-color: rgb(48, 140, 170);
    border-radius: 8px;
}

.unity-base-dropdown__container-outer,
.unity-base-dropdown__container-inner {
    background-color: rgba(8, 16, 32, 0.98);
    border-radius: 8px;
}

.unity-base-dropdown__item {
    color: rgb(210, 228, 240);
    background-color: rgba(8, 16, 32, 0.98);
    border-radius: 6px;
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:checked {
    background-color: rgb(16, 70, 96);
    color: rgb(72, 210, 230);
}

.unity-base-dropdown__label {
    color: rgb(210, 228, 240);
}

.preset-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.preset-overlay.hidden,
.preset-group.hidden,
.preset-error.hidden {
    display: none;
}

.preset-dialog {
    width: 320px;
    padding: 12px;
    background-color: rgba(8, 16, 32, 0.96);
    border-width: 1px;
    border-color: rgb(48, 140, 170);
    border-radius: 12px;
}

.preset-error {
    white-space: normal;
    color: rgb(230, 120, 120);
    margin-top: 6px;
    margin-bottom: 4px;
}

.preset-list {
    height: 180px;
    min-height: 180px;
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: rgba(4, 10, 22, 0.9);
    border-width: 1px;
    border-color: rgb(40, 90, 140);
    border-radius: 6px;
}

.setting-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    width: 280px;
    max-width: 280px;
    padding: 8px 10px;
    background-color: rgba(6, 14, 28, 0.97);
    border-width: 1px;
    border-color: rgb(72, 210, 230);
    border-radius: 8px;
    overflow: hidden;
}

.setting-tooltip.hidden {
    display: none;
}

.setting-tooltip-title {
    margin-bottom: 4px;
    -unity-font-style: bold;
    color: rgb(72, 210, 230);
    font-size: 12px;
    white-space: normal;
}

.setting-tooltip-label {
    white-space: normal;
    color: rgb(210, 228, 240);
    font-size: 11px;
}
