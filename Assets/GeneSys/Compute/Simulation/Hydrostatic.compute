#pragma kernel BuildSurfaceWaterColumns
#pragma kernel ComputeHydrostaticFaceFlux
#pragma kernel IntegrateHydrostaticColumns
#pragma target 5.0

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
Texture2D<float4> _StateRead;
RWStructuredBuffer<float4> _WaterColumns;
RWStructuredBuffer<float4> _WaterFaceFlux;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _HydrologyC; // runoffRate, pondingRate, fieldCapacityFraction, unused
float4 _WeatherC; // vaporPressureScale, solarAngle01, phaseHysteresis, magmaViscosity

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

#include "../../Shaders/Simulation/Common/SurfaceWater.hlsl"

[numthreads(64, 1, 1)]
void BuildSurfaceWaterColumns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int x = (int)id.x;
    int bedY;
    float volume;
    float temperature;
    float head;
    int waterTop;
    bool hadPixels;
    ProfileSurfaceColumn(x, bedY, volume, temperature, head, waterTop, hadPixels);
    _WaterColumns[x] = float4((float)bedY, volume, temperature, head);
}

[numthreads(64, 1, 1)]
void ComputeHydrostaticFaceFlux(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int left = (int)id.x;
    int right = (int)WrapTheta(left + 1, _GridSize.x);
    float4 leftCol = _WaterColumns[left];
    float4 rightCol = _WaterColumns[right];
    int bedL = (int)round(leftCol.x);
    int bedR = (int)round(rightCol.x);
    if (bedL < 0 || bedR < 0)
    {
        _WaterFaceFlux[left] = 0;
        return;
    }

    float volL = max(0.0, leftCol.y);
    float volR = max(0.0, rightCol.y);
    float headL = leftCol.w;
    float headR = rightCol.w;
    float bedTopL = (float)(bedL + 1);
    float bedTopR = (float)(bedR + 1);
    float saddle = max(bedTopL, bedTopR);
    float delta = headL - headR;
    if (abs(delta) <= 1e-5)
    {
        _WaterFaceFlux[left] = 0;
        return;
    }

    bool leftDonates = delta > 0.0;
    float donorHead = leftDonates ? headL : headR;
    float recvHead = leftDonates ? headR : headL;
    float donorVol = leftDonates ? volL : volR;
    float recvVol = leftDonates ? volR : volL;
    int recvBed = leftDonates ? bedR : bedL;
    float donorBedTop = leftDonates ? bedTopL : bedTopR;
    float donorTemp = leftDonates ? leftCol.z : rightCol.z;
    if (donorHead <= saddle + 1e-5 || donorVol <= 1e-6)
    {
        _WaterFaceFlux[left] = 0;
        return;
    }
    // Freeze from the liquid column, not the rock/ice bed. Film lives on the bed cell so
    // frozen ground still holds (column T is the film T). Landed rain and meltwater keep
    // their own temperature; using the bed blocked every warm drop on a cold shelf.
    if (donorTemp <= WATER_MELT_TEMP)
    {
        _WaterFaceFlux[left] = 0;
        return;
    }

    float donorSurplus = max(0.0, donorHead - saddle);
    float recvSurplus = max(0.0, recvHead - saddle);
    bool standingWaterCoupled = (recvHead > saddle + 1e-5);

    float amount = 0.0;
    if (standingWaterCoupled)
    {
        // Both columns have water surfaces above the saddle: true hydrostatic pressure leveling
        // of a continuous standing water body (lake/ocean).
        float effectiveDelta = donorSurplus - recvSurplus;
        if (effectiveDelta > 1e-5)
        {
            float mobility = max(0.0, _HydrologyC.x);
            amount = effectiveDelta * 0.5 * min(0.9, mobility * _DeltaTime * 8.0);
            amount = min(amount, donorVol * 0.35);
            amount = min(amount, effectiveDelta * 0.5);
        }
    }
    else
    {
        // Receiver is below the terrain saddle lip: this is overland runoff or water spilling
        // down a step/slope. Driving head is the water surplus above the weir, NOT the canyon depth.
        float stepGrade = (float)abs(bedL - bedR);
        float slopeFactor = 1.0 / sqrt(1.0 + stepGrade * stepGrade);
        float pondKnob = max(0.0, _HydrologyC.y);
        float retentionCap = (pondKnob > 1e-4) ? (saturate(pondKnob) * PRECIP_MIN_DROP * slopeFactor) : 0.0;
        float movable = max(0.0, donorSurplus - retentionCap);
        if (movable > 1e-6)
        {
            float runoffSpeed = max(0.0, _HydrologyC.x);
            float slopeBoost = 1.0 + min(3.0, stepGrade * 0.5);
            float spillRate = min(0.35, runoffSpeed * _DeltaTime * slopeBoost * 0.25);
            amount = min(movable * 0.5, movable * spillRate);
        }
    }

    float sky = max(0.0, (float)(_GridSize.y - recvBed - 1) - recvVol);
    amount = min(amount, sky);
    // A landed rain/melt pixel is depth 1. Once a neighbor picks up any film, later
    // iterations treat the pair as a coupled lake and sheet the drop away. Cap outflow
    // so ponding cannot dissolve a visible pixel into sub-threshold film.
    float donorDepth = max(0.0, donorHead - donorBedTop);
    bool rainScale = donorDepth <= 1.0 + 1e-4;
    bool shallowRecv = recvVol < 1.0 - 1e-4;
    if (max(0.0, _HydrologyC.y) > 1e-6 && rainScale && shallowRecv)
        amount = min(amount, max(0.0, donorVol - PRECIP_MIN_DROP) * 0.5);
    if (amount <= 1e-8)
    {
        _WaterFaceFlux[left] = 0;
        return;
    }

    float signedMass = leftDonates ? amount : -amount;
    _WaterFaceFlux[left] = float4(signedMass, signedMass * donorTemp, 0.0, 0.0);
}

// Settle the face exchange back into the column buffer so the flux pass can run again against
// the updated heads. Water finds its level by propagating pressure, not by diffusing one cell
// per tick, so the scheduler relaxes this pair of passes several times before touching the
// grid. Each thread writes only its own column and reads only faces, so the update is race
// free and the antisymmetric face exchange keeps the total volume exact.
[numthreads(64, 1, 1)]
void IntegrateHydrostaticColumns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int x = (int)id.x;
    float4 column = _WaterColumns[x];
    int bedY = (int)round(column.x);
    if (bedY < 0) return;

    float4 leftFlux = _WaterFaceFlux[WrapTheta(x - 1, _GridSize.x)];
    float4 rightFlux = _WaterFaceFlux[x];
    float volume = max(0.0, column.y);
    float outgoing = max(0.0, rightFlux.x) + max(0.0, -leftFlux.x);
    float incomingHeat = max(0.0, leftFlux.y) + max(0.0, -rightFlux.y);
    float newVolume = max(0.0, volume + leftFlux.x - rightFlux.x);
    float stay = max(0.0, volume - outgoing);
    float newTemp = newVolume > 1e-6 ? (stay * column.z + incomingHeat) / newVolume : column.z;
    _WaterColumns[x] = float4(column.x, newVolume, newTemp, (float)(bedY + 1) + newVolume);
}
