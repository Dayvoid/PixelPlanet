#pragma kernel ClearRootDemand
#pragma kernel CountRootDemand
#pragma kernel ResolveRootShare
#pragma kernel ApplyRootDebit
#pragma kernel GrassPhotosynthesis
#pragma kernel GrassLifecycle
#pragma kernel GrassPollenTransport
#pragma kernel GrassSeedTransport
#pragma kernel GrassGermination
#pragma kernel ClearGrassClaims
#pragma kernel ClaimDetritusDrops
#pragma kernel ApplyDetritusDrops
#pragma kernel ConfirmGrassDrops
#pragma kernel SeedGrass
#pragma kernel ApplyGrassEdits
#pragma target 5.1

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"
#include "../../Shaders/Simulation/Common/OrganismHistory.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2D<float> _LightRead;
Texture2DArray<float4> _GrassRead;
RWTexture2DArray<float4> _GrassWrite;
Texture2DArray<float4> _PropaguleRead;
RWTexture2DArray<float4> _PropaguleWrite;
Texture2DArray<uint> _GrassRootDemandRead;
RWTexture2DArray<uint> _GrassRootDemandWrite;
Texture2D<float4> _GrassRootShareRead;
RWTexture2D<float4> _GrassRootShareWrite;
Texture2D<uint> _GrassClaims;
RWTexture2D<uint> _GrassClaimsWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;
StructuredBuffer<BrushCommand> _BrushCommands;
int _BrushCount;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float4 _FloraC; // oxygenYield unused, unused, unused, baseMutationRate
float4 _FloraD; // toxinMutationScale, unused, unused, unused
float4 _GrassA; // growth, decay, photosynthesis, oxygen
float4 _GrassB; // exudation, reproductionThreshold, maintenance, nightDrain
float4 _GrassC; // minLight, rootUptake, rootCohesionScale, initialBiomass
float4 _GrassD; // growthTempMin, growthTempMax, growthMoistureMin, growthMoistureMax
float4 _GrassE; // survivalTempMin, survivalTempMax, survivalMoistureMin, survivalMoistureMax
float4 _GrassF; // pollenEmit, pollenAir, pollenWater, pollenSettle
float4 _GrassG; // seedAir, seedWater, seedGravity, seedDiffusion
float4 _GrassH; // nectarRate, seedAtWorldgen, geneExpressionRange, canopyOpacity
float4 _GrassI; // dayLengthSeconds, ticksPerSecond, 0, 0
float4 _DetritusA;
float4 _DetritusB;
float4 _WeatherC;
float4 _WeatherF;

int2 C(int2 value) { return ClampCell(value, _GridSize); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
float4 Eco(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
float LightOf(int2 value) { return _LightRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

float MoistureOf(float4 state, float4 aux)
{
    return max(0.0, state.z) + max(0.0, aux.y);
}

float SolarDayDt()
{
    return max(0.0, _DeltaTime) / max(1.0, _GrassI.x);
}

float GrassHash(int2 cell, uint slot, uint salt)
{
    return Hash01((uint)cell.x * 73856093u + (uint)cell.y * 19349663u + slot * 83492791u + salt + (uint)_Seed * 31337u + (uint)_Tick * 6151u);
}

bool IsPropaguleCarrier(uint material)
{
    return IsSporeCarrier(material);
}

bool IsPropaguleDeposit(uint material)
{
    return material == 7u || material == 8u || IsDetritusMaterial(material);
}


void CopyGrassSlot(int2 cell, uint slot, out float4 life, out uint4 genome, out float4 phenology, out uint4 donor)
{
    life = SampleGrassLife(_GrassRead, cell, slot);
    genome = SampleGrassGenome(_GrassRead, cell, slot);
    phenology = SampleGrassPhenology(_GrassRead, cell, slot);
    donor = SampleGrassDonor(_GrassRead, cell, slot);
}

uint LivingRootMask(int2 cell, uint slot, uint4 genome)
{
    uint mask = GrassRootMask(genome, cell, slot, _Seed);
    uint valid = 0u;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
    {
        if ((mask & (1u << bit)) == 0u) continue;
        int2 target = GrassRootTarget(cell, bit, _GridSize);
        if (target.y < 0) continue;
        uint material = M(target);
        if (IsGroundwaterHost(material, D(material)))
            valid |= 1u << bit;
    }
    return valid;
}

uint DemandMilligrams(float4 life, uint4 genome, uint tapCount)
{
    float expression = saturate(_GrassH.z);
    float metabolic = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_METABOLIC), expression);
    float demand = saturate(life.x) * metabolic * max(0.0, _GrassC.y) * max(0.0, _DeltaTime);
    uint mg = (uint)ceil(max(0.0, demand) * 1000.0);
    if (tapCount == 0u || mg == 0u) return 0u;
    return max(1u, mg / tapCount);
}

uint NutrientMilligrams(float4 life, uint4 genome, uint tapCount)
{
    float expression = saturate(_GrassH.z);
    float metabolic = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_METABOLIC), expression);
    float demand = saturate(life.x) * metabolic * max(0.0, _GrassC.y) * 0.45 * max(0.0, _DeltaTime);
    uint mg = (uint)ceil(max(0.0, demand) * 1000.0);
    if (tapCount == 0u || mg == 0u) return 0u;
    return max(1u, mg / tapCount);
}

uint CountMaskBits(uint mask)
{
    uint count = 0u;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
        if ((mask & (1u << bit)) != 0u) count++;
    return count;
}

uint CollectSymbiosis(int2 cell, uint mask)
{
    uint traits = 0u;
    float bestRare = 0.0;
    uint rareTraits = 0u;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
    {
        if ((mask & (1u << bit)) == 0u) continue;
        int2 target = GrassRootTarget(cell, bit, _GridSize);
        float4 ecology = Eco(target);
        uint local = SanitizeMycologyTraits((uint)round(ecology.z));
        traits |= local;
        if (local != 0u && saturate(ecology.y) >= bestRare)
        {
            bestRare = saturate(ecology.y);
            rareTraits = local;
        }
    }
    return rareTraits != 0u ? rareTraits : traits;
}

bool InGrassGrowth(float temp, float moisture, uint4 genome, uint traits)
{
    float expression = saturate(_GrassH.z);
    float tShift = FloraExpressShift(DecodeGene(genome, GRASS_GENE_TEMP_OPTIMUM), expression) * 8.0;
    float tTol = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_TEMP_TOLERANCE), expression);
    float mShift = FloraExpressShift(DecodeGene(genome, GRASS_GENE_MOISTURE_OPTIMUM), expression) * 0.2;
    float mTol = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_MOISTURE_TOLERANCE), expression);
    float tMin = _GrassD.x + tShift - (tTol - 1.0) * 6.0;
    float tMax = _GrassD.y + tShift + (tTol - 1.0) * 6.0;
    float mMin = max(0.0, _GrassD.z + mShift - (mTol - 1.0) * 0.08);
    float mMax = _GrassD.w + mShift + (mTol - 1.0) * 0.08;
    if ((traits & MYCO_HEAT_RESISTANT) != 0u) tMax += 10.0;
    if ((traits & MYCO_HEAT_PRONE) != 0u) tMax -= 8.0;
    if ((traits & MYCO_DROUGHT_RESISTANT) != 0u) mMin *= 0.55;
    if ((traits & MYCO_DROUGHT_PRONE) != 0u) mMin *= 1.35;
    return temp >= tMin && temp <= tMax && moisture >= mMin && moisture <= mMax;
}

bool InGrassSurvival(float temp, float moisture, uint4 genome, uint traits)
{
    float expression = saturate(_GrassH.z);
    float tShift = FloraExpressShift(DecodeGene(genome, GRASS_GENE_TEMP_OPTIMUM), expression) * 8.0;
    float tTol = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_TEMP_TOLERANCE), expression);
    float mShift = FloraExpressShift(DecodeGene(genome, GRASS_GENE_MOISTURE_OPTIMUM), expression) * 0.2;
    float mTol = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_MOISTURE_TOLERANCE), expression);
    float tMin = _GrassE.x + tShift - (tTol - 1.0) * 8.0;
    float tMax = _GrassE.y + tShift + (tTol - 1.0) * 8.0;
    float mMin = max(0.0, _GrassE.z + mShift - (mTol - 1.0) * 0.1);
    float mMax = _GrassE.w + mShift + (mTol - 1.0) * 0.1;
    if ((traits & MYCO_HEAT_RESISTANT) != 0u) tMax += 14.0;
    if ((traits & MYCO_HEAT_PRONE) != 0u) tMax -= 10.0;
    if ((traits & MYCO_DROUGHT_RESISTANT) != 0u) mMin *= 0.4;
    if ((traits & MYCO_DROUGHT_PRONE) != 0u) mMin *= 1.5;
    return temp >= tMin && temp <= tMax && moisture >= mMin && moisture <= mMax;
}

float SampleRootReceipt(int2 cell, uint mask, uint perTapMg, int sliceShare)
{
    float received = 0.0;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
    {
        if ((mask & (1u << bit)) == 0u) continue;
        int2 target = GrassRootTarget(cell, bit, _GridSize);
        float4 share = _GrassRootShareRead.Load(int3(target, 0));
        received += (float)perTapMg * (sliceShare == 0 ? share.x : share.y);
    }
    return received;
}

int2 PreferredDropCell(int2 cell)
{
    int2 up = C(cell + int2(0, 1));
    if (IsFloraOpenHabitat(M(up))) return up;
    int2 left = C(cell + int2(-1, 1));
    if (IsFloraOpenHabitat(M(left))) return left;
    int2 right = C(cell + int2(1, 1));
    if (IsFloraOpenHabitat(M(right))) return right;
    int2 sideL = C(cell + int2(-1, 0));
    if (IsFloraOpenHabitat(M(sideL))) return sideL;
    int2 sideR = C(cell + int2(1, 0));
    if (IsFloraOpenHabitat(M(sideR))) return sideR;
    return up;
}

[numthreads(8, 8, 1)]
void ClearRootDemand(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    _GrassRootDemandWrite[uint3((uint2)cell, GRASS_ROOT_DEMAND_WATER)] = 0u;
    _GrassRootDemandWrite[uint3((uint2)cell, GRASS_ROOT_DEMAND_NUTRIENT)] = 0u;
    _GrassRootDemandWrite[uint3((uint2)cell, GRASS_ROOT_DEMAND_TAPS)] = 0u;
}

[numthreads(8, 8, 1)]
void CountRootDemand(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    if (!IsGrassAnchor(M(cell))) return;
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        uint4 genome = SampleGrassGenome(_GrassRead, cell, slot);
        uint stage = GrassStage(genome);
        if (!GrassStageLiving(stage)) continue;
        float4 life = SampleGrassLife(_GrassRead, cell, slot);
        uint mask = LivingRootMask(cell, slot, genome);
        uint taps = CountMaskBits(mask);
        if (taps == 0u) continue;
        uint waterMg = DemandMilligrams(life, genome, taps);
        uint nutrientMg = NutrientMilligrams(life, genome, taps);
        [unroll]
        for (uint bit = 0u; bit < 3u; bit++)
        {
            if ((mask & (1u << bit)) == 0u) continue;
            int2 target = GrassRootTarget(cell, bit, _GridSize);
            uint dummy;
            InterlockedAdd(_GrassRootDemandWrite[uint3((uint2)target, GRASS_ROOT_DEMAND_WATER)], waterMg, dummy);
            InterlockedAdd(_GrassRootDemandWrite[uint3((uint2)target, GRASS_ROOT_DEMAND_NUTRIENT)], nutrientMg, dummy);
            InterlockedAdd(_GrassRootDemandWrite[uint3((uint2)target, GRASS_ROOT_DEMAND_TAPS)], 1u, dummy);
        }
    }
}

[numthreads(8, 8, 1)]
void ResolveRootShare(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    float4 state = S(cell);
    float4 aux = A(cell);
    uint waterMg = _GrassRootDemandRead.Load(int4(cell, GRASS_ROOT_DEMAND_WATER, 0));
    uint nutrientMg = _GrassRootDemandRead.Load(int4(cell, GRASS_ROOT_DEMAND_NUTRIENT, 0));
    uint taps = _GrassRootDemandRead.Load(int4(cell, GRASS_ROOT_DEMAND_TAPS, 0));
    float takeW = min(MoistureOf(state, aux), waterMg / 1000.0);
    float takeN = min(max(0.0, aux.z), nutrientMg / 1000.0);
    _GrassRootShareWrite[cell] = float4(
        waterMg > 0u ? takeW / (float)waterMg : 0.0,
        nutrientMg > 0u ? takeN / (float)nutrientMg : 0.0,
        (float)taps,
        0.0);
}

[numthreads(8, 8, 1)]
void ApplyRootDebit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint waterMg = _GrassRootDemandRead.Load(int4(cell, GRASS_ROOT_DEMAND_WATER, 0));
    uint nutrientMg = _GrassRootDemandRead.Load(int4(cell, GRASS_ROOT_DEMAND_NUTRIENT, 0));
    float4 share = _GrassRootShareRead.Load(int3(cell, 0));
    float takeW = (float)waterMg * share.x;
    float takeN = (float)nutrientMg * share.y;
    if (takeW <= 0.0 && takeN <= 0.0)
        return;
    float4 state = _StateWrite[cell];
    float4 aux = _AuxWrite[cell];
    float fromGround = min(max(0.0, aux.y), takeW);
    aux.y = max(0.0, aux.y - fromGround);
    state.z = max(0.0, state.z - (takeW - fromGround));
    aux.z = max(0.0, aux.z - takeN);
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
}

[numthreads(8, 8, 1)]
void GrassPhotosynthesis(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    bool anchor = IsGrassAnchor(M(cell));
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 life;
        uint4 genome;
        float4 phenology;
        uint4 donor;
        CopyGrassSlot(cell, slot, life, genome, phenology, donor);
        uint stage = GrassStage(genome);
        if (!anchor || !GrassStageLiving(stage))
        {
            WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
            continue;
        }

        uint mask = LivingRootMask(cell, slot, genome);
        uint traits = CollectSymbiosis(cell, mask);
        phenology.w = asfloat(mask | (traits << 24));
        uint taps = CountMaskBits(mask);
        uint waterMg = DemandMilligrams(life, genome, max(1u, taps));
        uint nutrientMg = NutrientMilligrams(life, genome, max(1u, taps));
        float water = SampleRootReceipt(cell, mask, waterMg, 0);
        float nutrient = SampleRootReceipt(cell, mask, nutrientMg, 1);
        float moisture = water + MoistureOf(S(cell), A(cell)) * 0.15;
        float temp = S(cell).x;
        float light = max(0.0, LightOf(cell));
        float expression = saturate(_GrassH.z);
        float lightAff = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_LIGHT_AFFINITY), expression);
        bool growing = InGrassGrowth(temp, moisture, genome, traits);
        bool surviving = InGrassSurvival(temp, moisture, genome, traits);
        float metabolic = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_METABOLIC), expression);

        if (growing && light >= _GrassC.x)
        {
            float photo = max(0.0, _GrassA.z) * light * lightAff * saturate(0.35 + moisture) * saturate(0.4 + nutrient * 8.0) * _DeltaTime;
            life.y = saturate(life.y + photo);
            life.x = saturate(life.x + max(0.0, _GrassA.x) * photo * 0.65);
        }
        else
        {
            float drain = max(0.0, _GrassB.z) * metabolic * _DeltaTime;
            if (light < _GrassC.x)
                drain += max(0.0, _GrassB.w) * _DeltaTime;
            life.y = saturate(life.y - drain);
        }

        if (stage == GRASS_STAGE_FLOWERING || stage == GRASS_STAGE_SEEDING)
        {
            float flower = FloraExpressFactor(DecodeGene(genome, GRASS_GENE_FLOWER_SIZE), expression);
            life.z = saturate(max(life.z, life.y * saturate(_GrassH.x) * flower));
        }
        else
            life.z = max(0.0, life.z - _DeltaTime * 0.15);

        if (!surviving)
            life.y = saturate(life.y - max(0.0, _GrassA.y) * _DeltaTime);

        WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
    }
}

[numthreads(8, 8, 1)]
void GrassLifecycle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MATERNAL_SLICE);
    uint4 pollen = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_POLLEN_SLICE);
    uint4 mixedDonor = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MIXED_SLICE);
    float bestPollen = load.z;
    uint4 bestPollenGenome = pollen;

    bool anchor = IsGrassAnchor(material);
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 life;
        uint4 genome;
        float4 phenology;
        uint4 donor;
        CopyGrassSlot(cell, slot, life, genome, phenology, donor);
        uint stage = GrassStage(genome);
        if (!anchor)
        {
            if (GrassStageOccupied(stage))
                LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, FloraGeneration(genome), FloraLineage(genome), ORGANISM_CAUSE_DESICCATION);
            ClearGrassSlot(_GrassWrite, cell, slot);
            continue;
        }

        if (!GrassStageOccupied(stage))
        {
            WriteGrassSlot(_GrassWrite, cell, slot, 0.0, 0, 0.0, 0);
            continue;
        }

        uint mask = LivingRootMask(cell, slot, genome);
        uint traits = CollectSymbiosis(cell, mask);
        float temp = S(cell).x;
        float moisture = SampleRootReceipt(cell, mask, DemandMilligrams(life, genome, max(1u, CountMaskBits(mask))), 0)
            + MoistureOf(S(cell), A(cell)) * 0.15;
        bool surviving = InGrassSurvival(temp, moisture, genome, traits);
        float toxinAdd = Comb(cell).z * 8.0 + abs(S(cell).w) * (((traits & MYCO_ELECTRIC_PRONE) != 0u) ? 8.0 : 4.0);
        if ((traits & MYCO_ELECTRIC_RESISTANT) != 0u)
            toxinAdd *= 0.35;
        uint dose = (uint)clamp((int)FloraToxinDose(genome) + (int)round(toxinAdd * _DeltaTime)
            - (int)round(FloraExpressFactor(DecodeGene(genome, GRASS_GENE_METABOLIC), 1.0)), 0, 255);
        genome.w = PackFloraMeta(stage, FloraGeneration(genome), FloraLineage(genome), dose);

        phenology.z += SolarDayDt();
        float expression = saturate(_GrassH.z);
        float energyNeed = max(0.15, saturate(_GrassB.y) * FloraExpressFactor(DecodeGene(genome, GRASS_GENE_REPRODUCTION), expression));

        if (!surviving || dose >= 250u || life.y <= 0.01)
        {
            LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, FloraGeneration(genome), FloraLineage(genome),
                dose >= 250u ? ORGANISM_CAUSE_TOXIN : ORGANISM_CAUSE_DESICCATION);
            ClearGrassSlot(_GrassWrite, cell, slot);
            continue;
        }

        if (stage == GRASS_STAGE_SEEDLING && life.x >= 0.22)
        {
            stage = GRASS_STAGE_ADULT;
            genome.w = PackFloraMeta(stage, FloraGeneration(genome), FloraLineage(genome), FloraToxinDose(genome));
        }

        if (stage == GRASS_STAGE_ADULT && asuint(phenology.x) == 0u)
        {
            float cadence = 3.0 + GrassHash(cell, slot, 11u);
            if (phenology.z >= cadence && life.y >= energyNeed)
            {
                stage = GRASS_STAGE_FLOWERING;
                genome.w = PackFloraMeta(stage, FloraGeneration(genome), FloraLineage(genome), FloraToxinDose(genome));
                phenology.x = asfloat(1u);
                phenology.y = 0.0;
                donor = 0;
            }
        }

        if (stage == GRASS_STAGE_FLOWERING)
        {
            phenology.y += SolarDayDt();
            float4 aboveLoad = SamplePropaguleLoad(_PropaguleRead, C(cell + int2(0, 1)));
            uint4 abovePollen = SamplePropaguleGenome(_PropaguleRead, C(cell + int2(0, 1)), PROPAGULE_POLLEN_SLICE);
            if (aboveLoad.z > bestPollen)
            {
                bestPollen = aboveLoad.z;
                bestPollenGenome = abovePollen;
            }
            if (load.z > 1e-5 && FloraLineage(pollen) != FloraLineage(genome) && FloraLineage(pollen) != 0u)
            {
                donor = pollen;
                donor.w = max(1u, donor.w);
            }
            if (aboveLoad.z > 1e-5 && FloraLineage(abovePollen) != FloraLineage(genome) && FloraLineage(abovePollen) != 0u)
            {
                if (aboveLoad.z >= load.z)
                {
                    donor = abovePollen;
                    donor.w = max(1u, donor.w);
                }
            }

            float emit = max(0.0, _GrassF.x) * saturate(life.z) * _DeltaTime;
            load.z += emit;
            ConsiderGenomeContribution(bestPollen, bestPollenGenome, emit, genome);

            float releaseAfter = 1.0 + GrassHash(cell, slot, 29u);
            if (phenology.y >= releaseAfter)
                stage = GRASS_STAGE_SEEDING;
            genome.w = PackFloraMeta(stage, FloraGeneration(genome), FloraLineage(genome), FloraToxinDose(genome));
        }

        if (stage == GRASS_STAGE_SEEDING && asuint(phenology.x) == 1u)
        {
            bool pollinated = donor.w != 0u && FloraLineage(donor) != FloraLineage(genome);
            uint salt = (uint)cell.x * 1103515245u + (uint)cell.y * 12345u + slot * 7919u + (uint)_Tick;
            float cloneCount = pollinated ? 2.0 : (1.0 + floor(GrassHash(cell, slot, 47u) * 3.0));
            float mixedCount = pollinated ? (3.0 + floor(GrassHash(cell, slot, 53u) * 4.0)) : 0.0;
            load.x += cloneCount;
            load.y += mixedCount;
            uint4 released = MutateGrassGenome(genome, _FloraC.w, _FloraD.x, salt);
            ConsiderGenomeContribution(load.x, maternal, cloneCount, released);
            if (pollinated)
            {
                uint4 mixed = MutateGrassGenome(CombineGrassGenomes(genome, donor, salt), _FloraC.w, _FloraD.x, salt + 17u);
                ConsiderGenomeContribution(load.y, mixedDonor, mixedCount, mixed);
            }
            LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_REPRODUCE, FloraGeneration(genome) + 1u, FloraLineage(genome), ORGANISM_CAUSE_NONE);
            stage = GRASS_STAGE_ADULT;
            genome.w = PackFloraMeta(stage, FloraGeneration(genome), FloraLineage(genome), FloraToxinDose(genome));
            phenology.x = asfloat(2u); // drop pending
            phenology.y = 0.0;
            phenology.z = 0.0;
            life.y = saturate(life.y * 0.55);
            life.z = 0.0;
            donor = 0;
        }

        WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
    }

    WritePropagule(_PropaguleWrite, cell, float4(load.x, load.y, bestPollen, load.w), maternal, bestPollenGenome, mixedDonor);
}

float4 NeighborPropaguleLoad(int2 cell)
{
    return SamplePropaguleLoad(_PropaguleRead, C(cell));
}

[numthreads(8, 8, 1)]
void GrassPollenTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MATERNAL_SLICE);
    uint4 pollen = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_POLLEN_SLICE);
    uint4 mixedDonor = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MIXED_SLICE);
    float pollenMass = load.z;
    float remaining = pollenMass;
    float incoming = 0.0;
    float best = pollenMass;
    uint4 bestGenome = pollen;
    float2 flow = F(cell);
    float cfl = max(0.05, _WeatherF.w);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

    if (IsPropaguleCarrier(material))
    {
        float air = IsSporeAirCarrier(material) ? max(0.0, _GrassF.y) : 0.0;
        float water = IsSporeWaterCarrier(material) ? max(0.0, _GrassF.z) : 0.0;
        float rate = air + water;
        float4 valid = float4(1, 1, cell.y > 0 ? 1 : 0, cell.y + 1 < _GridSize.y ? 1 : 0);
        float4 flux = DonorFaceFlux(flow, remaining, rate, valid, TangentialEdgeWeight(cell.y, _GridSize.y), _DeltaTime, cfl);
        remaining = max(0.0, remaining - flux.x - flux.y - flux.z - flux.w);
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 neighbor = C(cell - offsets[i]);
            if (!IsPropaguleCarrier(M(neighbor))) continue;
            float2 nFlow = F(neighbor);
            float nRate = (IsSporeAirCarrier(M(neighbor)) ? max(0.0, _GrassF.y) : 0.0)
                + (IsSporeWaterCarrier(M(neighbor)) ? max(0.0, _GrassF.z) : 0.0);
            float4 nValid = float4(1, 1, neighbor.y > 0 ? 1 : 0, neighbor.y + 1 < _GridSize.y ? 1 : 0);
            float4 nFlux = DonorFaceFlux(nFlow, NeighborPropaguleLoad(neighbor).z, nRate, nValid,
                TangentialEdgeWeight(neighbor.y, _GridSize.y), _DeltaTime, cfl);
            float received = i == 0 ? nFlux.y : i == 1 ? nFlux.x : i == 2 ? nFlux.w : nFlux.z;
            incoming += received;
            ConsiderGenomeContribution(best, bestGenome, received, SamplePropaguleGenome(_PropaguleRead, neighbor, PROPAGULE_POLLEN_SLICE));
        }
        remaining = max(0.0, remaining - remaining * saturate(max(0.0, _GrassF.w) * _DeltaTime));
    }
    else if (IsGrassAnchor(material))
    {
        int2 above = C(cell + int2(0, 1));
        if (IsPropaguleCarrier(M(above)))
        {
            float deposit = NeighborPropaguleLoad(above).z * saturate(max(0.0, _GrassF.w) * _DeltaTime);
            incoming += deposit;
            ConsiderGenomeContribution(best, bestGenome, deposit, SamplePropaguleGenome(_PropaguleRead, above, PROPAGULE_POLLEN_SLICE));
        }
        ConsiderGenomeContribution(best, bestGenome, pollenMass, pollen);
    }

    load.z = max(0.0, remaining + incoming);
    pollen = load.z > 1e-6 ? bestGenome : 0;
    WritePropagule(_PropaguleWrite, cell, load, maternal, pollen, mixedDonor);
}

[numthreads(8, 8, 1)]
void GrassSeedTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MATERNAL_SLICE);
    uint4 pollen = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_POLLEN_SLICE);
    uint4 mixedDonor = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MIXED_SLICE);
    float2 flow = F(cell);
    float cfl = max(0.05, _WeatherF.w);
    float remainingClone = load.x;
    float remainingMixed = load.y;
    float inClone = 0.0;
    float inMixed = 0.0;
    float bestClone = load.x;
    float bestMixed = load.y;
    uint4 bestMaternal = maternal;
    uint4 bestMixedGenome = mixedDonor;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

    if (IsPropaguleCarrier(material) || IsGrassAnchor(material) || IsPropaguleDeposit(material))
    {
        float air = IsSporeAirCarrier(material) ? max(0.0, _GrassG.x) : 0.0;
        float water = IsSporeWaterCarrier(material) ? max(0.0, _GrassG.y) : 0.0;
        float gravity = max(0.0, _GrassG.z);
        float rate = max(air + water, IsGrassAnchor(material) ? gravity * 0.25 : 0.0);
        float2 seedFlow = flow;
        seedFlow.y -= gravity;
        float4 valid = float4(1, 1, cell.y > 0 ? 1 : 0, cell.y + 1 < _GridSize.y ? 1 : 0);
        float4 fluxClone = DonorFaceFlux(seedFlow, remainingClone, max(rate, gravity), valid, TangentialEdgeWeight(cell.y, _GridSize.y), _DeltaTime, cfl);
        float4 fluxMixed = DonorFaceFlux(seedFlow, remainingMixed, max(rate, gravity), valid, TangentialEdgeWeight(cell.y, _GridSize.y), _DeltaTime, cfl);
        remainingClone = max(0.0, remainingClone - fluxClone.x - fluxClone.y - fluxClone.z - fluxClone.w);
        remainingMixed = max(0.0, remainingMixed - fluxMixed.x - fluxMixed.y - fluxMixed.z - fluxMixed.w);

        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 neighbor = C(cell - offsets[i]);
            uint nMat = M(neighbor);
            if (!(IsPropaguleCarrier(nMat) || IsGrassAnchor(nMat) || IsPropaguleDeposit(nMat))) continue;
            float2 nFlow = F(neighbor);
            nFlow.y -= gravity;
            float nAir = IsSporeAirCarrier(nMat) ? max(0.0, _GrassG.x) : 0.0;
            float nWater = IsSporeWaterCarrier(nMat) ? max(0.0, _GrassG.y) : 0.0;
            float nRate = max(nAir + nWater, IsGrassAnchor(nMat) ? gravity * 0.25 : 0.0);
            float4 nValid = float4(1, 1, neighbor.y > 0 ? 1 : 0, neighbor.y + 1 < _GridSize.y ? 1 : 0);
            float4 nLoad = NeighborPropaguleLoad(neighbor);
            float4 nClone = DonorFaceFlux(nFlow, nLoad.x, max(nRate, gravity), nValid, TangentialEdgeWeight(neighbor.y, _GridSize.y), _DeltaTime, cfl);
            float4 nMixed = DonorFaceFlux(nFlow, nLoad.y, max(nRate, gravity), nValid, TangentialEdgeWeight(neighbor.y, _GridSize.y), _DeltaTime, cfl);
            float recClone = i == 0 ? nClone.y : i == 1 ? nClone.x : i == 2 ? nClone.w : nClone.z;
            float recMixed = i == 0 ? nMixed.y : i == 1 ? nMixed.x : i == 2 ? nMixed.w : nMixed.z;
            inClone += recClone;
            inMixed += recMixed;
            ConsiderGenomeContribution(bestClone, bestMaternal, recClone, SamplePropaguleGenome(_PropaguleRead, neighbor, PROPAGULE_MATERNAL_SLICE));
            ConsiderGenomeContribution(bestMixed, bestMixedGenome, recMixed, SamplePropaguleGenome(_PropaguleRead, neighbor, PROPAGULE_MIXED_SLICE));
        }
    }

    load.x = max(0.0, remainingClone + inClone);
    load.y = max(0.0, remainingMixed + inMixed);
    if (load.x <= 1e-6) bestMaternal = 0;
    if (load.y <= 1e-6) bestMixedGenome = 0;
    WritePropagule(_PropaguleWrite, cell, load, bestMaternal, pollen, bestMixedGenome);
}

[numthreads(8, 8, 1)]
void GrassGermination(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MATERNAL_SLICE);
    uint4 pollen = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_POLLEN_SLICE);
    uint4 mixedDonor = SamplePropaguleGenome(_PropaguleRead, cell, PROPAGULE_MIXED_SLICE);
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 life;
        uint4 genome;
        float4 phenology;
        uint4 donor;
        CopyGrassSlot(cell, slot, life, genome, phenology, donor);
        if (!IsGrassAnchor(M(cell)))
        {
            WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
            continue;
        }
        uint stage = GrassStage(genome);
        if (GrassStageOccupied(stage))
        {
            WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
            continue;
        }
        bool useMixed = load.y >= 1.0;
        bool useClone = load.x >= 1.0;
        if (!useMixed && !useClone)
        {
            WriteGrassSlot(_GrassWrite, cell, slot, 0.0, 0, 0.0, 0);
            continue;
        }
        uint4 child = useMixed && mixedDonor.x + mixedDonor.y + mixedDonor.z != 0u ? mixedDonor : maternal;
        if (child.x + child.y + child.z == 0u)
            child = RandomGrassGenome((uint2)cell, slot, _Seed, _Tick);
        child = MutateGrassGenome(child, _FloraC.w, _FloraD.x, (uint)cell.x * 97u + slot * 13u + (uint)_Tick);
        child.w = PackFloraMeta(GRASS_STAGE_SEEDLING, min(FloraGeneration(child) + 1u, 255u), FloraLineage(child), 0u);
        life = float4(saturate(_GrassC.w * 0.45), 0.08, 0.0, 0.0);
        phenology = 0.0;
        donor = 0;
        if (useMixed) load.y = max(0.0, load.y - 1.0);
        else load.x = max(0.0, load.x - 1.0);
        LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_BIRTH, FloraGeneration(child), FloraLineage(child), ORGANISM_CAUSE_HATCHED);
        WriteGrassSlot(_GrassWrite, cell, slot, life, child, phenology, donor);
    }
    WritePropagule(_PropaguleWrite, cell, load, maternal, pollen, mixedDonor);
}

[numthreads(8, 8, 1)]
void ClearGrassClaims(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    _GrassClaimsWrite[id.xy] = GRASS_CLAIM_EMPTY;
}

[numthreads(8, 8, 1)]
void ClaimDetritusDrops(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 phenology = SampleGrassPhenology(_GrassRead, cell, slot);
        if (asuint(phenology.x) != 2u) continue;
        int2 dest = PreferredDropCell(cell);
        if (!IsFloraOpenHabitat(M(dest))) continue;
        uint packed = PackFaunaCell(cell, _GridSize) * 4u + slot;
        uint original;
        InterlockedMin(_GrassClaimsWrite[dest], packed, original);
    }
}

[numthreads(8, 8, 1)]
void ApplyDetritusDrops(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint winner = _GrassClaims.Load(int3(cell, 0));
    uint material = _MaterialWrite[cell];
    if (winner == GRASS_CLAIM_EMPTY || !IsFloraOpenHabitat(material))
        return;
    float4 state = _StateWrite[cell];
    float2 flow = _FlowWrite[cell];
    float4 aux = _AuxWrite[cell];
    float4 combustion = _CombustionWrite[cell];
    material = DETRITUS_ID;
    aux.z = saturate(max(aux.z, _DetritusB.y));
    aux.y = max(aux.y, _DetritusB.z);
    state.x = min(state.x, 28.0);
    flow *= 0.4;
    combustion = SeedCombustion(material, D(material));
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
}

[numthreads(8, 8, 1)]
void ConfirmGrassDrops(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 life;
        uint4 genome;
        float4 phenology;
        uint4 donor;
        CopyGrassSlot(cell, slot, life, genome, phenology, donor);
        if (asuint(phenology.x) == 2u)
        {
            int2 dest = PreferredDropCell(cell);
            uint packed = PackFaunaCell(cell, _GridSize) * 4u + slot;
            uint winner = _GrassClaims.Load(int3(dest, 0));
            if (winner == packed)
                phenology.x = asfloat(0u);
        }
        WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
    }
}

[numthreads(8, 8, 1)]
void SeedGrass(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
        ClearGrassSlot(_GrassWrite, cell, slot);
    if (_GrassH.y < 0.5) return;
    if (!IsGrassAnchor(M(cell))) return;
    uint above = M(cell + int2(0, 1));
    if (!(IsFloraOpenHabitat(above) || above == 9u || above == 10u)) return;
    if (GrassHash(cell, 0u, 3u) > 0.04) return;
    uint4 genome = RandomGrassGenome((uint2)cell, 0u, _Seed, _Tick);
    genome.w = PackFloraMeta(GRASS_STAGE_ADULT, 0u, FloraLineage(genome), 0u);
    WriteGrassSlot(_GrassWrite, cell, 0u, float4(saturate(_GrassC.w), 0.15, 0.0, 0.0), genome, 0.0, 0);
}

[numthreads(8, 8, 1)]
void ApplyGrassEdits(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint occupiedMask = 0u;
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 life;
        uint4 genome;
        float4 phenology;
        uint4 donor;
        CopyGrassSlot(cell, slot, life, genome, phenology, donor);
        WriteGrassSlot(_GrassWrite, cell, slot, life, genome, phenology, donor);
        if (GrassStageOccupied(GrassStage(genome)))
            occupiedMask |= 1u << slot;
    }
    if (_BrushCount <= 0) return;
    for (int i = 0; i < _BrushCount; i++)
    {
        BrushCommand command = _BrushCommands[i];
        int mode = (int)round(command.values.x);
        if (mode != 15) continue;
        int dx = abs(cell.x - command.center.x);
        dx = min(dx, _GridSize.x - dx);
        int dy = cell.y - command.center.y;
        if (dx * dx + dy * dy > command.radius * command.radius) continue;
        if (!IsGrassAnchor(M(cell))) continue;
        int slot = -1;
        [unroll]
        for (uint s = 0u; s < 3u; s++)
        {
            if ((occupiedMask & (1u << s)) == 0u)
            {
                slot = (int)s;
                break;
            }
        }
        if (slot < 0) continue;
        occupiedMask |= 1u << (uint)slot;
        uint4 genome = RandomGrassGenome((uint2)cell, (uint)slot, _Seed, _Tick);
        genome.w = PackFloraMeta(GRASS_STAGE_ADULT, 0u, FloraLineage(genome), 0u);
        float4 life = float4(saturate(max(_GrassC.w, command.values.y)), 0.2, 0.0, 0.0);
        WriteGrassSlot(_GrassWrite, cell, (uint)slot, life, genome, 0.0, 0);
        LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_BIRTH, 0u, FloraLineage(genome), ORGANISM_CAUSE_PAINTED);
    }
}
