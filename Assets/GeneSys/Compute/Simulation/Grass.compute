#pragma kernel RootDemand
#pragma kernel SoilDebit
#pragma kernel PhotosynthesisLifecycle
#pragma kernel PollenTransport
#pragma kernel SeedTransport
#pragma kernel Germination
#pragma kernel ClearDropClaims
#pragma kernel ClaimFlowerDrop
#pragma kernel ApplyFlowerDrop
#pragma kernel SeedGrass
#pragma kernel PaintGrass
#pragma kernel ClearGrassVisit
#pragma target 5.1

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"
#define GENESYS_DISABLE_ORGANISM_HISTORY_UAV
#include "../../Shaders/Simulation/Common/OrganismHistory.hlsl"

Texture2D<uint> _MaterialRead;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<float4> _EcologyRead;
Texture2D<float4> _CombustionRead;
Texture2D<float> _LightRead;
Texture2DArray<float4> _GrassRead;
RWTexture2DArray<float4> _GrassWrite;
Texture2DArray<float4> _PropaguleRead;
RWTexture2DArray<float4> _PropaguleWrite;
RWTexture2D<float4> _GrassRootFlux;
Texture2D<uint> _GrassDropClaims;
RWTexture2D<uint> _GrassDropClaimsWrite;
// Wasp visits recorded on earlier ticks. Read here, cleared by ClearGrassVisit right after.
Texture2DArray<float4> _GrassVisit;
RWTexture2DArray<float4> _GrassVisitWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float _TicksPerDay;
float _TicksPerSecond;
float4 _WeatherA;
float4 _WeatherC;
float4 _FloraC; // oxygenYield, exudation, reproductionThreshold, baseMutationRate
float4 _FloraD; // toxinMutationScale, geneExpressionRange, ...
float4 _MycologyE;
float4 _GrassA; // waterUptake, nutrientUptake, photosynthesis, growth
float4 _GrassB; // decay, maintenance, nightDrain, flowerEnergy
float4 _GrassC; // expression, growthTempMin, growthTempMax, growthMoistureMin
float4 _GrassD; // growthMoistureMax, survivalTempMin, survivalTempMax, survivalMoistureMin
float4 _GrassE; // survivalMoistureMax, minLight, adultBiomass, nectar
float4 _GrassF; // pollenEmit, pollenTransport, seedTransport, canopyOpacity
float4 _GrassG; // pollenWind, pollenWater, pollenSettle, seedWind
float4 _GrassH; // seedWater, seedSettle, initialBiomass, initialEnergy
float4 _GrassI; // seedAtWorldgen, cohesionBonus, detritusNutrient, detritusMoisture
float4 _GrassPaintCell; // x, y, radius

int2 C(int2 value) { return ClampCell(value, _GridSize); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
float4 Eco(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
float LightOf(int2 value) { return _LightRead.Load(int3(C(value), 0)); }
float4 FluxOf(int2 value) { return _GrassRootFlux[C(value)]; }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

bool IsOpenCarrier(uint material)
{
    float category = D(material).metadata.x;
    return material == 0u || material == 1u || material == 11u || category == 1.0;
}

bool IsExposedSoil(int2 cell, uint material)
{
    if (!IsGrassSoilAnchor(material)) return false;
    int2 offsets[4] = { int2(0, 1), int2(-1, 0), int2(1, 0), int2(0, -1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        if (IsOpenCarrier(M(C(n)))) return true;
    }
    return false;
}

float MoistureOf(float4 state, float4 aux)
{
    return max(0.0, state.z) + max(0.0, aux.y);
}

float HashCell(int2 cell, uint salt)
{
    return Hash01((uint)cell.x * 73856093u + (uint)cell.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 31337u + salt);
}

float TicksPerDay()
{
    return max(1.0, _TicksPerDay);
}

uint CountBits3(uint mask)
{
    uint count = 0u;
    [unroll]
    for (uint i = 0u; i < 3u; i++)
        if ((mask & (1u << i)) != 0u) count++;
    return max(1u, count);
}

float SlotWaterDemand(float4 life)
{
    return max(0.0, 1.0 - saturate(life.z)) * max(0.0, _GrassA.x) * _DeltaTime;
}

float SlotNutrientDemand(float4 life)
{
    return max(0.0, 1.0 - saturate(life.y)) * max(0.0, _GrassA.y) * _DeltaTime;
}

void GatherSlotDemand(int2 target, out float demandW, out float demandN, out float tapCount)
{
    demandW = 0.0;
    demandN = 0.0;
    tapCount = 0.0;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
    {
        int2 parent = GrassTapParent(target, bit, _GridSize);
        if (parent.y >= _GridSize.y) continue;
        uint expected = GrassTapBitForParent(bit);
        [unroll]
        for (uint slot = 0u; slot < 3u; slot++)
        {
            uint4 genome = SampleGrassGenome(_GrassRead, parent, slot);
            if (!GrassIsLiving(GrassStage(genome))) continue;
            uint mask = GrassRootMask(SampleGrassTiming(_GrassRead, parent, slot));
            if ((mask & (1u << expected)) == 0u) continue;
            float4 life = SampleGrassLife(_GrassRead, parent, slot);
            float taps = (float)CountBits3(mask);
            demandW += SlotWaterDemand(life) / taps;
            demandN += SlotNutrientDemand(life) / taps;
            tapCount += 1.0;
        }
    }
}

float2 SlotReceipts(int2 cell, uint slot, float4 life, uint mask)
{
    float demandW = SlotWaterDemand(life);
    float demandN = SlotNutrientDemand(life);
    float taps = (float)CountBits3(mask);
    float gotW = 0.0;
    float gotN = 0.0;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
    {
        if ((mask & (1u << bit)) == 0u) continue;
        int2 target = GrassTapTarget(cell, bit, _GridSize);
        if (target.y < 0) continue;
        float4 flux = FluxOf(target);
        float takenW = flux.x;
        float takenN = flux.y;
        float totalW = flux.z;
        float totalN = flux.w;
        float shareW = totalW > 1e-8 ? (demandW / taps) / totalW * takenW : 0.0;
        float shareN = totalN > 1e-8 ? (demandN / taps) / totalN * takenN : 0.0;
        gotW += shareW;
        gotN += shareN;
    }
    return float2(gotW, gotN);
}

void SampleTappedMycology(int2 cell, uint mask, out uint combinedTraits, out uint dominantRare)
{
    uint traits[3] = { 0u, 0u, 0u };
    uint n = 0u;
    [unroll]
    for (uint bit = 0u; bit < 3u; bit++)
    {
        if ((mask & (1u << bit)) == 0u) continue;
        int2 target = GrassTapTarget(cell, bit, _GridSize);
        if (target.y < 0) continue;
        traits[n] = DecodeMycologyTraits(Eco(target).z);
        n++;
    }
    combinedTraits = SanitizeMycologyTraits(traits[0] | traits[1] | traits[2]);
    dominantRare = DominantRareMycology(traits[0], traits[1], traits[2]);
}

bool InGrowthBand(float temp, float moisture, uint4 genome)
{
    float expression = saturate(_GrassC.x);
    float tShift = GrassExpressShift(DecodeGene(genome, GRASS_GENE_TEMP_OPTIMUM), expression) * 12.0;
    float tTol = GrassExpressFactor(DecodeGene(genome, GRASS_GENE_TEMP_TOLERANCE), expression);
    float mShift = GrassExpressShift(DecodeGene(genome, GRASS_GENE_MOISTURE_OPTIMUM), expression) * 0.25;
    float mTol = GrassExpressFactor(DecodeGene(genome, GRASS_GENE_MOISTURE_TOLERANCE), expression);
    float tMin = _GrassC.y + tShift - (tTol - 1.0) * 8.0;
    float tMax = _GrassC.z + tShift + (tTol - 1.0) * 8.0;
    float mMin = max(0.0, _GrassC.w + mShift - (mTol - 1.0) * 0.15);
    float mMax = _GrassD.x + mShift + (mTol - 1.0) * 0.15;
    return temp >= tMin && temp <= tMax && moisture >= mMin && moisture <= mMax;
}

bool InSurvivalBand(float temp, float moisture, uint4 genome)
{
    float expression = saturate(_GrassC.x);
    float tShift = GrassExpressShift(DecodeGene(genome, GRASS_GENE_TEMP_OPTIMUM), expression) * 12.0;
    float tTol = GrassExpressFactor(DecodeGene(genome, GRASS_GENE_TEMP_TOLERANCE), expression);
    float mShift = GrassExpressShift(DecodeGene(genome, GRASS_GENE_MOISTURE_OPTIMUM), expression) * 0.25;
    float mTol = GrassExpressFactor(DecodeGene(genome, GRASS_GENE_MOISTURE_TOLERANCE), expression);
    float tMin = _GrassD.y + tShift - (tTol - 1.0) * 10.0;
    float tMax = _GrassD.z + tShift + (tTol - 1.0) * 10.0;
    float mMin = max(0.0, _GrassD.w + mShift - (mTol - 1.0) * 0.2);
    float mMax = _GrassE.x + mShift + (mTol - 1.0) * 0.2;
    return temp >= tMin && temp <= tMax && moisture >= mMin && moisture <= mMax;
}

int2 OutwardCarrier(int2 cell)
{
    int2 left = C(cell + int2(-1, 1));
    if (left.y < _GridSize.y && IsOpenCarrier(M(left))) return left;
    int2 right = C(cell + int2(1, 1));
    if (right.y < _GridSize.y && IsOpenCarrier(M(right))) return right;
    int2 up = cell + int2(0, 1);
    if (up.y < _GridSize.y && IsOpenCarrier(M(up))) return up;
    int2 sideL = C(cell + int2(-1, 0));
    if (IsOpenCarrier(M(sideL))) return sideL;
    int2 sideR = C(cell + int2(1, 0));
    if (IsOpenCarrier(M(sideR))) return sideR;
    return cell;
}

[numthreads(8, 8, 1)]
void RootDemand(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    float demandW, demandN, taps;
    GatherSlotDemand(cell, demandW, demandN, taps);
    _GrassRootFlux[cell] = float4(max(0.0, demandW), max(0.0, demandN), max(0.0, taps), 0.0);
}

[numthreads(8, 8, 1)]
void SoilDebit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    float4 state = S(cell);
    float4 aux = A(cell);
    float4 flux = _GrassRootFlux[cell];
    float demandW = max(0.0, flux.x);
    float demandN = max(0.0, flux.y);
    float availW = MoistureOf(state, aux);
    float availN = max(0.0, aux.z);
    float takenW = min(availW, demandW);
    float takenN = min(availN, demandN);

    float remainingW = takenW;
    float fromSurface = min(max(0.0, state.z), remainingW);
    state.z = max(0.0, state.z - fromSurface);
    remainingW -= fromSurface;
    aux.y = max(0.0, aux.y - remainingW);
    aux.z = max(0.0, aux.z - takenN);

    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _GrassRootFlux[cell] = float4(takenW, takenN, demandW, demandN);
}

[numthreads(8, 8, 1)]
void PhotosynthesisLifecycle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float4 aux = A(cell);
    float4 combustion = Comb(cell);
    float light = max(0.0, LightOf(cell));
    float moisture = MoistureOf(state, aux);
    float expression = saturate(_GrassC.x);
    bool anchored = IsExposedSoil(cell, material);
    bool burning = combustion.y > 0.05;

    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleMaternal(_PropaguleRead, cell);
    uint4 donorGenome = SamplePropaguleDonor(_PropaguleRead, cell);
    float pollenBest = load.y;
    float seedBest = load.x;

    float4 visitNectar = SampleGrassVisitNectar(_GrassVisit, cell);
    uint4 visitDonor = SampleGrassVisitDonor(_GrassVisit, cell);

    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 life = SampleGrassLife(_GrassRead, cell, slot);
        uint4 genome = SampleGrassGenome(_GrassRead, cell, slot);
        float4 timing = SampleGrassTiming(_GrassRead, cell, slot);
        uint4 donor = SampleGrassDonor(_GrassRead, cell, slot);
        uint stage = GrassStage(genome);

        if (!GrassIsLiving(stage) || !anchored || burning)
        {
            if (GrassIsLiving(stage))
                LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, GrassGeneration(genome), GrassLineage(genome),
                    burning ? ORGANISM_CAUSE_FIRE : ORGANISM_CAUSE_DESICCATION);
            ClearGrassSlot(_GrassWrite, cell, slot);
            continue;
        }

        uint mask = GrassRootMask(timing);
        if (mask == 0u)
        {
            mask = SelectGrassRootMask(genome, cell, slot);
            timing.w = (float)PackGrassTimingFlags(mask, GrassIsFlowering(timing), GrassIsPollinated(timing), GrassHasReleased(timing));
        }

        uint combinedTraits;
        uint dominantRare;
        SampleTappedMycology(cell, mask, combinedTraits, dominantRare);
        float2 receipts = SlotReceipts(cell, slot, life, mask);
        life.z = saturate(life.z + receipts.x * 4.0);
        life.y = saturate(life.y + receipts.y * 3.0);

        float traitEffect = saturate(_MycologyE.z);
        float droughtMul = 1.0;
        float heatMul = 1.0;
        if ((combinedTraits & MYCO_DROUGHT_RESISTANT) != 0u) droughtMul += 0.25 * traitEffect;
        if ((combinedTraits & MYCO_DROUGHT_PRONE) != 0u) droughtMul -= 0.2 * traitEffect;
        if ((combinedTraits & MYCO_HEAT_RESISTANT) != 0u) heatMul += 0.2 * traitEffect;
        if ((combinedTraits & MYCO_HEAT_PRONE) != 0u) heatMul -= 0.2 * traitEffect;
        if ((combinedTraits & MYCO_ELECTRIC_RESISTANT) != 0u) heatMul += 0.05 * traitEffect;
        if ((combinedTraits & MYCO_ELECTRIC_PRONE) != 0u && abs(state.w) > 0.4) droughtMul -= 0.1 * traitEffect;

        float lightAff = GrassExpressFactor(DecodeGene(genome, GRASS_GENE_LIGHT_AFFINITY), expression);
        bool growing = InGrowthBand(state.x, moisture, genome) && light >= max(0.0, _GrassE.y);
        bool surviving = InSurvivalBand(state.x, moisture, genome);
        float photo = max(0.0, _GrassA.z) * light * lightAff * saturate(life.z) * droughtMul * heatMul * _DeltaTime;
        if (growing)
        {
            life.y = saturate(life.y + photo);
            life.x = saturate(life.x + max(0.0, _GrassA.w) * saturate(life.y) * _DeltaTime);
        }
        else
        {
            life.y = max(0.0, life.y - max(0.0, _GrassB.x) * 0.35 * _DeltaTime);
        }

        float maint = max(0.0, _GrassB.y) * _DeltaTime;
        if (light < 0.02) maint += max(0.0, _GrassB.z) * _DeltaTime;
        life.y = max(0.0, life.y - maint);
        life.z = max(0.0, life.z - 0.15 * _DeltaTime);

        if (state.x > 80.0)
            genome = uint4(genome.x, genome.y, genome.z, PackGrassMeta(stage, GrassGeneration(genome), GrassLineage(genome),
                min(255u, GrassToxinDose(genome) + 2u)));

        timing.x += _DeltaTime * max(1.0, _TicksPerSecond);
        float ageDays = timing.x / TicksPerDay();

        if (stage == GRASS_STAGE_JUVENILE && life.x >= saturate(_GrassE.z))
        {
            stage = GRASS_STAGE_ADULT;
            genome.w = PackGrassMeta(stage, GrassGeneration(genome), GrassLineage(genome), GrassToxinDose(genome));
        }

        if (!surviving && life.x < 0.02)
        {
            LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, GrassGeneration(genome), GrassLineage(genome), ORGANISM_CAUSE_DESICCATION);
            ClearGrassSlot(_GrassWrite, cell, slot);
            continue;
        }

        bool flowering = GrassIsFlowering(timing);
        bool pollinated = GrassIsPollinated(timing);
        bool released = GrassHasReleased(timing);
        if (stage == GRASS_STAGE_ADULT && !flowering && !released && life.y >= saturate(_GrassB.w) && ageDays >= GrassFloweringDays(genome))
        {
            flowering = true;
            timing.y = 0.0;
            timing.z = GrassSeedReleaseDays(genome) * TicksPerDay();
            life.w = saturate(_GrassE.w);
        }

        if (flowering)
        {
            timing.y += _DeltaTime * max(1.0, _TicksPerSecond);
            life.w = max(life.w, saturate(_GrassE.w));
            float emit = max(0.0, _GrassF.x) * _DeltaTime;
            if (emit > 0.0)
            {
                load.y += emit;
                ConsiderGenomeContribution(pollenBest, donorGenome, emit, genome);
                donorGenome.w |= GRASS_DONOR_VALID;
            }

            uint4 incoming = SamplePropaguleDonor(_PropaguleRead, cell);
            if (GrassHasDonor(incoming) && GrassLineage(incoming) != GrassLineage(genome))
            {
                donor = incoming;
                donor.w |= GRASS_DONOR_VALID;
                pollinated = true;
            }
            int2 carrier = OutwardCarrier(cell);
            incoming = SamplePropaguleDonor(_PropaguleRead, carrier);
            if (GrassHasDonor(incoming) && GrassLineage(incoming) != GrassLineage(genome))
            {
                donor = incoming;
                donor.w |= GRASS_DONOR_VALID;
                pollinated = true;
            }

            // A wasp visited this cell since the last grass pass: it drank nectar and may
            // have left a sample from another lineage. Same rejection rule as wind pollen.
            float drawn = slot == 0u ? visitNectar.x : (slot == 1u ? visitNectar.y : visitNectar.z);
            if (drawn > 0.0)
                life.w = saturate(life.w - drawn);
            if ((uint)round(max(visitNectar.w, 0.0)) == slot + 1u
                && GrassHasDonor(visitDonor)
                && GrassLineage(visitDonor) != GrassLineage(genome))
            {
                donor = visitDonor;
                donor.w |= GRASS_DONOR_VALID;
                pollinated = true;
            }

            timing.z = max(0.0, timing.z - _DeltaTime * max(1.0, _TicksPerSecond));
            if (timing.z <= 0.0 && !released)
            {
                float salt = HashCell(cell, 17u + slot * 91u);
                uint clones = pollinated ? 2u : (1u + (uint)floor(salt * 3.0));
                uint mixed = pollinated ? (3u + (uint)floor(HashCell(cell, 91u + slot) * 4.0)) : 0u;
                float added = (float)(clones + mixed);
                load.x += added;
                ConsiderGenomeContribution(seedBest, maternal, added, genome);
                if (pollinated)
                {
                    ConsiderGenomeContribution(pollenBest, donorGenome, 1.0, donor);
                    donorGenome.w |= GRASS_DONOR_VALID;
                }
                released = true;
                flowering = false;
                life.w = 0.0;
                timing.x = 0.0;
                timing.y = 0.0;
                LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_REPRODUCE, GrassGeneration(genome), GrassLineage(genome), ORGANISM_CAUSE_NONE);
            }
        }

        if (released && timing.y > TicksPerDay() * 0.05)
            released = false;

        timing.w = (float)PackGrassTimingFlags(mask, flowering, pollinated, released);
        WriteGrassSlot(_GrassWrite, cell, slot, life, genome, timing, donor);
    }

    WritePropagule(_PropaguleWrite, cell, load, maternal, donorGenome);
}

[numthreads(8, 8, 1)]
void PollenTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float2 flow = F(cell);
    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleMaternal(_PropaguleRead, cell);
    uint4 donor = SamplePropaguleDonor(_PropaguleRead, cell);
    float pollen = load.y;
    float remaining = pollen;
    float incoming = 0.0;
    float bestMass = pollen;
    uint4 bestDonor = donor;

    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    float wind = max(0.0, _GrassG.x);
    float water = max(0.0, _GrassG.y);
    float settle = max(0.0, _GrassG.z);
    float transport = max(0.0, _GrassF.y);

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 neighbor = C(cell + offsets[i]);
        if (offsets[i].y != 0 && (cell.y + offsets[i].y < 0 || cell.y + offsets[i].y >= _GridSize.y)) continue;
        uint neighborMat = M(neighbor);
        float4 nLoad = SamplePropaguleLoad(_PropaguleRead, neighbor);
        uint4 nDonor = SamplePropaguleDonor(_PropaguleRead, neighbor);
        float2 nFlow = F(neighbor);
        float rate = transport;
        if (IsOpenCarrier(material) && IsOpenCarrier(neighborMat))
            rate *= wind * max(abs(flow.x), abs(nFlow.x));
        else if (material == 9u || neighborMat == 9u)
            rate *= water;
        else
            rate *= 0.15;
        if (offsets[i].y < 0)
            rate += settle;
        float leave = pollen * saturate(rate * _DeltaTime) * 0.25;
        remaining = max(0.0, remaining - leave);

        float nPollen = nLoad.y;
        float nRate = transport;
        if (IsOpenCarrier(material) && IsOpenCarrier(neighborMat))
            nRate *= wind * max(abs(flow.x), abs(nFlow.x));
        else if (material == 9u || neighborMat == 9u)
            nRate *= water;
        else
            nRate *= 0.15;
        if (offsets[i].y > 0)
            nRate += settle;
        float recv = nPollen * saturate(nRate * _DeltaTime) * 0.25;
        incoming += recv;
        ConsiderGenomeContribution(bestMass, bestDonor, recv, nDonor);
    }

    load.y = max(0.0, remaining + incoming);
    if (load.y > 1e-8)
        donor = bestDonor;
    else
        donor = 0;
    WritePropagule(_PropaguleWrite, cell, load, maternal, donor);
}

[numthreads(8, 8, 1)]
void SeedTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float2 flow = F(cell);
    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleMaternal(_PropaguleRead, cell);
    uint4 donor = SamplePropaguleDonor(_PropaguleRead, cell);
    float seeds = load.x;
    float remaining = seeds;
    float incoming = 0.0;
    float bestMass = seeds;
    uint4 bestMaternal = maternal;

    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    float wind = max(0.0, _GrassG.w);
    float water = max(0.0, _GrassH.x);
    float settle = max(0.0, _GrassH.y);
    float transport = max(0.0, _GrassF.z);

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 neighbor = C(cell + offsets[i]);
        if (offsets[i].y != 0 && (cell.y + offsets[i].y < 0 || cell.y + offsets[i].y >= _GridSize.y)) continue;
        uint neighborMat = M(neighbor);
        float4 nLoad = SamplePropaguleLoad(_PropaguleRead, neighbor);
        uint4 nMaternal = SamplePropaguleMaternal(_PropaguleRead, neighbor);
        float2 nFlow = F(neighbor);
        float rate = transport;
        if (IsOpenCarrier(material) && IsOpenCarrier(neighborMat))
            rate *= wind * max(abs(flow.x), abs(nFlow.x));
        else if (material == 9u || neighborMat == 9u)
            rate *= water;
        else
            rate *= 0.1;
        if (offsets[i].y < 0)
            rate += settle;

        float leaveFrac = saturate(rate * _DeltaTime) * 0.25;
        float leave = floor(seeds * leaveFrac + HashCell(cell, 40u + (uint)i) * 0.999);
        leave = min(leave, remaining);
        remaining -= leave;

        float nSeeds = nLoad.x;
        float nRate = transport;
        if (IsOpenCarrier(material) && IsOpenCarrier(neighborMat))
            nRate *= wind * max(abs(flow.x), abs(nFlow.x));
        else if (material == 9u || neighborMat == 9u)
            nRate *= water;
        else
            nRate *= 0.1;
        if (offsets[i].y > 0)
            nRate += settle;
        float recvFrac = saturate(nRate * _DeltaTime) * 0.25;
        float recv = floor(nSeeds * recvFrac + HashCell(neighbor, 70u + (uint)i) * 0.999);
        incoming += recv;
        ConsiderGenomeContribution(bestMass, bestMaternal, recv, nMaternal);
    }

    load.x = max(0.0, round(remaining + incoming));
    if (load.x > 0.5)
        maternal = bestMaternal;
    else
        maternal = 0;
    WritePropagule(_PropaguleWrite, cell, load, maternal, donor);
}

[numthreads(8, 8, 1)]
void Germination(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint copySlot = 0u; copySlot < 3u; copySlot++)
        CopyGrassSlot(_GrassRead, _GrassWrite, cell, copySlot);

    float4 load = SamplePropaguleLoad(_PropaguleRead, cell);
    uint4 maternal = SamplePropaguleMaternal(_PropaguleRead, cell);
    uint4 donor = SamplePropaguleDonor(_PropaguleRead, cell);
    if (!IsExposedSoil(cell, M(cell)) || load.x < 0.5)
    {
        WritePropagule(_PropaguleWrite, cell, load, maternal, donor);
        return;
    }

    uint start = (uint)floor(HashCell(cell, 11u) * 3.0);
    [unroll]
    for (uint i = 0u; i < 3u; i++)
    {
        if (load.x < 0.5) break;
        uint slot = (start + i) % 3u;
        uint4 existing = SampleGrassGenome(_GrassRead, cell, slot);
        if (GrassIsLiving(GrassStage(existing))) continue;

        bool mix = GrassHasDonor(donor) && GrassLineage(donor) != GrassLineage(maternal)
            && HashCell(cell, 200u + slot) < 0.7;
        uint4 child = InheritGrassGenome(maternal, donor, mix, _FloraC.w, _FloraD.x, (uint)cell.x * 17u + (uint)cell.y * 31u + slot * 91u + (uint)_Tick);
        float4 life = float4(saturate(_GrassH.z), saturate(_GrassH.w), 0.4, 0.0);
        uint mask = SelectGrassRootMask(child, cell, slot);
        float4 timing = float4(0.0, 0.0, 0.0, (float)PackGrassTimingFlags(mask, false, false, false));
        WriteGrassSlot(_GrassWrite, cell, slot, life, child, timing, uint4(0u, 0u, 0u, 0u));
        load.x = max(0.0, load.x - 1.0);
        LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_BIRTH, GrassGeneration(child), GrassLineage(child), ORGANISM_CAUSE_NONE);
    }

    if (load.x <= 0.5) maternal = 0;
    WritePropagule(_PropaguleWrite, cell, load, maternal, donor);
}

[numthreads(8, 8, 1)]
void ClearDropClaims(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    _GrassDropClaimsWrite[id.xy] = GRASS_CLAIM_EMPTY;
}

[numthreads(8, 8, 1)]
void ClaimFlowerDrop(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 timing = SampleGrassTiming(_GrassRead, cell, slot);
        if (!GrassHasReleased(timing) || !GrassIsLiving(GrassStage(SampleGrassGenome(_GrassRead, cell, slot))))
            continue;
        int2 dest = OutwardCarrier(cell);
        if (all(dest == cell) || !IsOpenCarrier(M(dest))) continue;
        uint packed = PackFaunaCell(cell, _GridSize);
        uint original;
        InterlockedMin(_GrassDropClaimsWrite[dest], packed, original);
    }
}

[numthreads(8, 8, 1)]
void ApplyFlowerDrop(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    [unroll]
    for (uint slot = 0u; slot < 3u; slot++)
    {
        float4 timing = SampleGrassTiming(_GrassRead, cell, slot);
        uint4 genome = SampleGrassGenome(_GrassRead, cell, slot);
        float4 life = SampleGrassLife(_GrassRead, cell, slot);
        uint4 donor = SampleGrassDonor(_GrassRead, cell, slot);
        if (GrassHasReleased(timing))
        {
            uint mask = GrassRootMask(timing);
            timing.w = (float)PackGrassTimingFlags(mask, false, false, false);
            timing.y = 0.0;
            timing.z = 0.0;
            donor = 0;
            life.w = 0.0;
        }
        WriteGrassSlot(_GrassWrite, cell, slot, life, genome, timing, donor);
    }
}

void PlantSlot(int2 cell, uint slot, uint stage)
{
    uint4 genome = RandomGrassGenome((uint2)cell, slot, _Seed, _Tick);
    genome.w = PackGrassMeta(stage, 0u, GrassLineage(genome), 0u);
    float4 life = float4(saturate(_GrassH.z), saturate(_GrassH.w), 0.5, 0.0);
    uint mask = SelectGrassRootMask(genome, cell, slot);
    float4 timing = float4(0.0, 0.0, 0.0, (float)PackGrassTimingFlags(mask, false, false, false));
    WriteGrassSlot(_GrassWrite, cell, slot, life, genome, timing, uint4(0u, 0u, 0u, 0u));
    LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_BIRTH, 0u, GrassLineage(genome), ORGANISM_CAUSE_PAINTED);
}

[numthreads(8, 8, 1)]
void SeedGrass(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint copySlot = 0u; copySlot < 3u; copySlot++)
        CopyGrassSlot(_GrassRead, _GrassWrite, cell, copySlot);
    if (_GrassI.x < 0.5) return;
    if (!IsExposedSoil(cell, M(cell))) return;
    if (HashCell(cell, 3u) > 0.12) return;
    uint plantSlot = (uint)floor(HashCell(cell, 9u) * 3.0);
    if (GrassIsLiving(GrassStage(SampleGrassGenome(_GrassRead, cell, plantSlot)))) return;
    PlantSlot(cell, plantSlot, GRASS_STAGE_ADULT);
}

[numthreads(8, 8, 1)]
void PaintGrass(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    [unroll]
    for (uint copySlot = 0u; copySlot < 3u; copySlot++)
        CopyGrassSlot(_GrassRead, _GrassWrite, cell, copySlot);
    int radius = max(0, (int)_GrassPaintCell.z);
    int2 center = int2((int)_GrassPaintCell.x, (int)_GrassPaintCell.y);
    int dx = abs(cell.x - center.x);
    dx = min(dx, _GridSize.x - dx);
    int dy = abs(cell.y - center.y);
    if (dx > radius || dy > radius) return;
    if (!IsGrassSoilAnchor(M(cell))) return;
    [unroll]
    for (uint plantSlot = 0u; plantSlot < 3u; plantSlot++)
    {
        if (GrassIsLiving(GrassStage(SampleGrassGenome(_GrassRead, cell, plantSlot)))) continue;
        PlantSlot(cell, plantSlot, GRASS_STAGE_ADULT);
        break;
    }
}

// Runs immediately after PhotosynthesisLifecycle consumes the records. Separate from that
// kernel so the visit texture is never bound as SRV and UAV in the same dispatch.
[numthreads(8, 8, 1)]
void ClearGrassVisit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    uint2 cell = id.xy;
    [unroll]
    for (uint slice = 0u; slice < (uint)GRASS_VISIT_SLICE_COUNT; slice++)
        _GrassVisitWrite[uint3(cell, slice)] = 0.0;
}
