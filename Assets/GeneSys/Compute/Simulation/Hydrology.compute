#pragma kernel Groundwater
#pragma kernel RunoffAndDeposition
#pragma kernel GeothermalDischarge
#pragma kernel ErosionAndCollapse
#pragma kernel AshFertilization

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherD;
float4 _WeatherE; // saturationCapacityScale, cloudPrecipitationThreshold, unused, unused
float4 _EruptionA;
float4 _EruptionB;
float4 _MoistureErosion; // dryMoistureThreshold, moistureCohesionStrength, capillaryEvaporationFraction, unused

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

bool IsAtmosphereCell(int2 cell, uint material)
{
    float category = D(material).metadata.x;
    if (category == 1.0 || material == 11u) return true;
    return material == 0u && Radius01(cell.y, _GridSize.y) >= _AtmosphereStartRadius;
}

bool IsExposedSurface(int2 cell, uint material)
{
    uint above = M(cell + int2(0, 1));
    return D(above).metadata.x <= 1.0 && material != 1u && material != 0u && material != 11u;
}

void Write(int2 cell, uint material, float4 state, float2 flow, float4 aux)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
}

[numthreads(8, 8, 1)]
void Groundwater(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    MaterialGpuData definition = D(material);
    float porosity = saturate(definition.biology.z);
    float absorbency = saturate(definition.transport.w);
    bool exposed = IsExposedSurface(cell, material);

    if (exposed && state.z > 0.01 && porosity > 0.05)
    {
        float infiltration = min(state.z, absorbency * porosity * _Hydrology.x * _DeltaTime);
        state.z -= infiltration;
        aux.y += infiltration;
    }

    float neighbors = A(cell + int2(-1, 0)).y + A(cell + int2(1, 0)).y
        + A(cell + int2(0, -1)).y + A(cell + int2(0, 1)).y;
    float groundwaterDelta = (neighbors * 0.25 - aux.y) * porosity * _Hydrology.y * _DeltaTime;
    aux.y = max(0.0, aux.y + clamp(groundwaterDelta, -0.05, 0.05));

    float springThreshold = _HydrologyB.x;
    float head = aux.y + state.y * 0.15 + aux.w * 0.25;
    if (exposed && head > springThreshold)
    {
        float discharge = min(aux.y, (head - springThreshold) * _HydrologyB.y * _DeltaTime);
        aux.y -= discharge;
        state.z += discharge;
        flow.y += discharge * 0.5;
    }

    float leftWater = S(cell + int2(-1, 0)).z;
    float rightWater = S(cell + int2(1, 0)).z;
    flow.x += (leftWater - rightWater) * 0.25 * _DeltaTime;
    if (material == 9u || state.z > 0.05)
        flow.y -= state.z * _Mechanics.x * 0.1 * _DeltaTime;

    Write(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void RunoffAndDeposition(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    MaterialGpuData definition = D(material);
    bool atmosphere = IsAtmosphereCell(cell, material);
    bool exposed = IsExposedSurface(cell, material);

    if (exposed && state.z > 0.02)
    {
        float downhill = S(cell + int2(0, -1)).z - state.z;
        float lateral = (S(cell + int2(-1, 0)).z - S(cell + int2(1, 0)).z) * 0.5;
        float transfer = max(0.0, downhill) * _HydrologyC.x * _DeltaTime;
        transfer += max(0.0, lateral) * _HydrologyC.x * 0.35 * _DeltaTime;
        transfer = min(transfer, state.z * 0.35);
        state.z -= transfer;
        flow.x += lateral * _HydrologyC.x * 0.2 * _DeltaTime;
        flow.y -= transfer * 2.0;
    }

    if ((material == 7u || material == 8u) && state.z > 0.05 && definition.biology.z > 0.2)
    {
        float pond = min(state.z, _HydrologyC.y * _DeltaTime * 0.25);
        state.z = max(state.z - pond * 0.15, pond);
    }

    if (material == 9u && cell.y > 0)
    {
        uint belowMat = M(cell + int2(0, -1));
        if (D(belowMat).metadata.x <= 1.0 && state.z > 0.2)
            flow.y -= state.z * _Mechanics.x * 0.35 * _DeltaTime;
    }

    Write(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void GeothermalDischarge(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    bool exposed = IsExposedSurface(cell, material);

    float hotBelow = S(cell + int2(0, -1)).x;
    uint belowMat = M(cell + int2(0, -1));
    if (belowMat == 6u || belowMat == 3u) hotBelow = max(hotBelow, 850.0);

    float cooldownTicks = max(5.0, _HydrologyC.w * 20.0);
    float phase = frac((float)_Tick / cooldownTicks + Hash01(cell.x * 19349669u + cell.y * 83492791u + (uint)_Tick));
    bool geyserReady = phase > 0.92;

    if (exposed && aux.y > _HydrologyB.x && hotBelow > _HydrologyB.z && aux.w > 0.35 && geyserReady)
    {
        float burst = min(aux.y, _HydrologyB.w * _DeltaTime * 3.0);
        aux.y -= burst;
        state.z += burst * 0.65;
        aux.x += burst * 0.35;
        state.x += burst * 40.0;
        state.y += burst * 0.4;
        flow.y += burst * 4.0;
    }

    if (material == 9u && (belowMat == 6u || belowMat == 5u) && hotBelow > 200.0 && aux.w > 0.25)
    {
        float vent = min(state.z, _GeologyB.x * _DeltaTime);
        state.x += vent * 35.0;
        aux.x += vent * 0.15;
        aux.z += vent * _GeologyB.y;
        flow.y += vent * 1.5;
        state.y += vent * 0.1;
    }

    Write(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void ErosionAndCollapse(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    MaterialGpuData definition = D(material);
    bool exposed = IsExposedSurface(cell, material);
    float flowEnergy = length(flow);
    float soilQuality = saturate(aux.z);
    float dryThreshold = max(0.01, _MoistureErosion.x);
    float localMoisture = max(0.0, state.z) + max(0.0, aux.y);
    float moistureProtection = saturate(localMoisture / dryThreshold);
    float cohesion = saturate(
        _Erosion.z
        + definition.physical.y
        + soilQuality * 0.35 * max(0.0, _EruptionB.w)
        + moistureProtection * max(0.0, _MoistureErosion.y));

    // Continuous linear recovery for sediment-source solids. Sustained loading must
    // exceed stressDecayRate (_Erosion.w) on average to accumulate toward conversion.
    if (material == 4u || material == 5u || material == 7u)
        aux.w = max(0.0, aux.w - max(0.0, _Erosion.w) * _DeltaTime);

    if ((material == 4u || material == 5u) && aux.y > 0.55 && definition.metadata.z > 0.5)
    {
        float carve = _Hydrology.z * aux.y * (1.0 - cohesion) * _DeltaTime;
        aux.w += carve;
        if (aux.w > 1.25)
        {
            material = 8u;
            aux.w = 0.0;
            state.z += aux.y * 0.2;
            aux.y *= 0.8;
        }
    }

    // Ordinary wind/runoff erosion: exposed soil only. Moisture raises cohesion and
    // suppresses stress gain; dryness alone never converts without sustained flow.
    if (material == 7u && exposed)
    {
        float erodibility = 1.0 - moistureProtection;
        if (flowEnergy > cohesion + 0.25 && erodibility > 0.05)
        {
            float erode = _Erosion.x * flowEnergy * erodibility * _DeltaTime;
            aux.w += erode;
            if (aux.w > 1.0)
            {
                material = 8u;
                aux.w = 0.0;
            }
        }
    }
    else if (material == 4u && flowEnergy > cohesion + 0.25)
    {
        float erode = _Erosion.x * flowEnergy * _DeltaTime;
        aux.w += erode;
        if (aux.w > 1.0)
        {
            material = 8u;
            aux.w = 0.0;
        }
    }

    uint below = M(cell + int2(0, -1));
    if ((material == 4u || material == 7u) && (below == 0u || below == 1u) && cohesion < _Hydrology.w)
        material = 8u;

    Write(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void AshFertilization(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float fertility = max(0.0, _EruptionB.w);

    if (material == 12u && cell.y > 0)
    {
        uint below = M(cell + int2(0, -1));
        if (below == 8u)
        {
            // Consume ash resting on sediment into fertile soil at this cell.
            material = 7u;
            aux.z = saturate(aux.z + 0.45 * fertility);
            state.x = min(state.x, 45.0);
            flow *= 0.5;
        }
        else if (below == 7u)
        {
            // Transfer nutrients into soil below by dissolving ash into air.
            material = 1u;
            state.x = min(state.x, 25.0);
            flow *= 0.25;
            aux.z = 0.0;
        }
    }
    else if (material == 8u)
    {
        uint above = M(cell + int2(0, 1));
        if (above == 12u)
        {
            material = 7u;
            aux.z = saturate(aux.z + 0.45 * fertility);
            flow *= 0.5;
        }
    }
    else if (material == 7u)
    {
        uint above = M(cell + int2(0, 1));
        if (above == 12u)
            aux.z = saturate(aux.z + 0.35 * fertility);
    }

    Write(cell, material, state, flow, aux);
}
