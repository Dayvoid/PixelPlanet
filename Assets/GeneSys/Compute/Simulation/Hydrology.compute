#pragma kernel Groundwater
#pragma kernel HydrothermalRelease
#pragma kernel ErosionAndCollapse
#pragma kernel AshFertilization
#pragma kernel DetritusExchange
#pragma kernel ApplyFlowerDrop
#pragma kernel ApplyHydrostaticColumns

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
Texture2DArray<float4> _GrassRead;
Texture2DArray<float4> _TreeRead;
Texture2D<uint> _GrassDropClaims;
StructuredBuffer<float4> _WaterColumns;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC; // runoffRate, pondingRate, fieldCapacityFraction, unused
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherD;
float4 _WeatherE; // vaporCapacityScale, cloudRetainMass, waterPressureResponse, latentHeatScale
float4 _EruptionA;
float4 _EruptionB;
float4 _MoistureErosion; // dryMoistureThreshold, moistureCohesionStrength, unused, unused
float4 _GrassI; // seedAtWorldgen, cohesionBonus, detritusNutrient, detritusMoisture
float4 _TreeH; // seedAtWorldgen, cohesionBonus, canopyOpacity, exposureDamage
float4 _DetritusA; // vaporAbsorb, evaporate, distribute, leach
float4 _DetritusB; // decomposition, unused
float4 _WeatherI;
float4 _PressureA;
float4 _Hydrothermal;

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 E(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

#define GENESYS_HYDROTHERMAL_DECLARED 1
#include "../../Shaders/Simulation/Common/SurfaceWater.hlsl"
#include "../../Shaders/Simulation/Common/Climate.hlsl"
#include "../../Shaders/Simulation/Common/Geodynamics.hlsl"

bool IsExposedSurface(int2 cell, uint material)
{
    if (cell.y >= _GridSize.y - 1) return false;
    uint above = M(cell + int2(0, 1));
    return D(above).metadata.x <= 1.0 && material != 1u && material != 0u;
}

bool IsRewritableCarrier(uint material)
{
    // Ice is never a hydrostatic rewrite target. PhaseChange owns freeze/thaw;
    // Margolus owns hail fall and landed snow repose.
    return material == 0u || material == 1u || material == 9u;
}

void Write(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, SampleLife(_LifeGenomeRead, cell), SampleGenome(_LifeGenomeRead, cell));
}

bool NeighborOpensVadose(int2 n)
{
    if (n.y < 0 || n.y >= _GridSize.y) return false;
    uint nm = M(n);
    if (nm == 1u || nm == 7u) return true;
    if (nm == 4u || nm == 5u)
        return A(n).y < GroundwaterCapacity(D(nm));
    return false;
}

[numthreads(8, 8, 1)]
void Groundwater(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    MaterialGpuData definition = D(material);
    float porosity = saturate(definition.biology.z);
    float absorbency = saturate(definition.transport.w);
    bool exposed = IsExposedSurface(cell, material);
    bool host = IsGroundwaterHost(material, definition);
    float capacity = GroundwaterCapacity(definition);
    float fieldCapacityFraction = saturate(_HydrologyC.z) * ClimateBucketScale(cell.x);
    float waterHeatCapacity = max(0.001, D(9u).transport.y);
    float infiltrationRate = _Hydrology.x;
    float groundwaterRate = _Hydrology.y;
    float hysteresis = max(0.001, _WeatherC.z);
    float liquidFrac = WaterLiquidFraction(state.x, hysteresis);

    // Every neighbor exchange below is evaluated from pre-tick fields that both cells can read,
    // so a donor's subtraction and a receiver's addition are always the same number.
    float groundwaterRead = max(0.0, aux.y);
    float groundwaterDelta = 0.0;

    if (host)
    {
        float remaining = max(0.0, capacity - groundwaterRead);
        float film = InfiltrationAmount(state.z * liquidFrac, remaining, absorbency, porosity, infiltrationRate, _DeltaTime);
        state.z -= film;
        groundwaterDelta += film;

        if (cell.y < _GridSize.y - 1)
        {
            int2 above = cell + int2(0, 1);
            uint aboveMaterial = M(above);
            bool pondRain = _HydrologyC.y > 1e-6 && IsPondableRainPixel(above, aboveMaterial);
            if (aboveMaterial == 9u && !IsHydrometeor(above, aboveMaterial) && !pondRain)
            {
                float4 aboveState = S(above);
                float soak = InfiltrationAmount(aboveState.z * WaterLiquidFraction(aboveState.x, hysteresis), remaining, absorbency, porosity, infiltrationRate, _DeltaTime);
                groundwaterDelta += soak;
                state.x = MixTemperature(state.x, definition.transport.y, aboveState.x, soak, waterHeatCapacity);
            }
        }
    }

    bool pondThis = _HydrologyC.y > 1e-6 && IsPondableRainPixel(cell, material);
    if (material == 9u && cell.y > 0 && !IsHydrometeor(cell, material) && !pondThis)
    {
        int2 below = cell + int2(0, -1);
        uint belowMaterial = M(below);
        MaterialGpuData belowDef = D(belowMaterial);
        if (IsGroundwaterHost(belowMaterial, belowDef))
        {
            float remaining = max(0.0, GroundwaterCapacity(belowDef) - A(below).y);
            float soak = InfiltrationAmount(state.z * WaterLiquidFraction(state.x, hysteresis), remaining, saturate(belowDef.transport.w),
                saturate(belowDef.biology.z), infiltrationRate, _DeltaTime);
            state.z -= soak;
            // Residue stays on this Water pixel. Hydrostatic collapses sub-cell standing
            // water to host film; Groundwater must not delete leftover mass or the ID.
        }
    }

    if (host)
    {
        if (cell.y < _GridSize.y - 1)
        {
            int2 above = cell + int2(0, 1);
            uint aboveMaterial = M(above);
            MaterialGpuData aboveDef = D(aboveMaterial);
            if (IsGroundwaterHost(aboveMaterial, aboveDef))
            {
                float percScale = (aboveMaterial == 15u || material == 15u) ? 0.08 : 1.0;
                float perc = PercolationAmount(A(above).y, GroundwaterCapacity(aboveDef), groundwaterRead, capacity,
                    saturate(aboveDef.biology.z), porosity, groundwaterRate * percScale, fieldCapacityFraction, _DeltaTime);
                groundwaterDelta += perc;
                state.x = MixTemperature(state.x, definition.transport.y, S(above).x, perc, waterHeatCapacity);
            }
        }
        if (cell.y > 0)
        {
            int2 below = cell + int2(0, -1);
            uint belowMaterial = M(below);
            MaterialGpuData belowDef = D(belowMaterial);
            if (IsGroundwaterHost(belowMaterial, belowDef))
            {
                float percScale = (belowMaterial == 15u || material == 15u) ? 0.08 : 1.0;
                float perc = PercolationAmount(groundwaterRead, capacity, A(below).y, GroundwaterCapacity(belowDef),
                    porosity, saturate(belowDef.biology.z), groundwaterRate * percScale, fieldCapacityFraction, _DeltaTime);
                groundwaterDelta -= perc;
            }
        }

        bool perchedOnClay = (cell.y > 0 && M(cell + int2(0, -1)) == 15u);
        float lateralRate = perchedOnClay ? (groundwaterRate * 0.7) : (groundwaterRate * 0.35);
        int2 left = cell + int2(-1, 0);
        int2 right = cell + int2(1, 0);
        uint leftMaterial = M(left);
        uint rightMaterial = M(right);
        MaterialGpuData leftDef = D(leftMaterial);
        MaterialGpuData rightDef = D(rightMaterial);
        if (IsGroundwaterHost(leftMaterial, leftDef))
        {
            float leftScale = ClimateBucketScaleFace(cell.x, left.x);
            groundwaterDelta += LateralGroundwaterReceive(groundwaterRead, A(left).y, capacity * leftScale, GroundwaterCapacity(leftDef) * leftScale,
                porosity, saturate(leftDef.biology.z), lateralRate, _DeltaTime);
        }
        if (IsGroundwaterHost(rightMaterial, rightDef))
        {
            float rightScale = ClimateBucketScaleFace(cell.x, right.x);
            groundwaterDelta += LateralGroundwaterReceive(groundwaterRead, A(right).y, capacity * rightScale, GroundwaterCapacity(rightDef) * rightScale,
                porosity, saturate(rightDef.biology.z), lateralRate, _DeltaTime);
        }
        aux.y = max(0.0, groundwaterRead + groundwaterDelta);
    }
    else if (material == 9u || material == 10u)
    {
        // A host that turned to liquid keeps its water as surface mass instead of dropping it.
        state.z += groundwaterRead;
        aux.y = 0.0;
    }
    else if (IsAtmosphereCell(cell, material))
    {
        aux.x += groundwaterRead;
        aux.y = 0.0;
    }

    if (host && exposed)
    {
        float hold = capacity * fieldCapacityFraction;
        float excess = max(0.0, aux.y - hold);
        float discharge = min(excess, excess * max(0.0, _HydrologyB.x) * _DeltaTime);
        aux.y -= discharge;
        state.z += discharge;
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void HydrothermalRelease(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    MaterialGpuData definition = D(material);
    if (!IsGroundwaterHost(material, definition) || aux.y <= 0.0 || _Mechanics.y <= 1e-8)
    {
        Write(cell, material, state, flow, aux, ecology, combustion);
        return;
    }

    float radius = Radius01(cell.y, _GridSize.y);
    float envelope = GeodynamicsHydrothermalEnvelope(cell.x, radius);
    float weakness = GeodynamicsFaultWeakness(cell.x, radius);
    float equilibrium = PressureEquilibriumAt(cell.y, _GridSize.y, _PressureA.y, _PressureA.z);
    float hysteresis = max(0.001, _WeatherC.z);
    float hostBoil = WaterBoilTemperature(EffectivePressure(state.y, aux.x, _WeatherC.x), equilibrium, _WeatherE.z);
    bool permeable = envelope > 0.08 || weakness > 0.2 || state.x > hostBoil + 80.0;
    if (!permeable)
    {
        Write(cell, material, state, flow, aux, ecology, combustion);
        return;
    }

    float boiled = GroundwaterBoilMass(aux.y, state.x, hostBoil + hysteresis, _DeltaTime);
    if (boiled > 1e-8)
    {
        aux.y -= boiled;
        aux.x += boiled;
        state.x -= WaterLatentHeatDelta(boiled, _WeatherE.w, 0.8);
        state.y += boiled * 0.5;
        float chemistry = max(envelope, max(weakness, step(hostBoil + 80.0, state.x)));
        aux.z += boiled * max(0.0, _Hydrothermal.x) * max(0.0, _Hydrothermal.y) * chemistry;
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

// Identity change only. Converts stressed / karst / unsupported crust to Sediment (8).
// Never relocates cells — Margolus owns gravity and repose settling of the resulting sediment.
[numthreads(8, 8, 1)]
void ErosionAndCollapse(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    MaterialGpuData definition = D(material);
    bool exposed = IsExposedSurface(cell, material);
    float flowEnergy = length(flow);
    float soilQuality = saturate(aux.z);
    float dryThreshold = max(0.01, _MoistureErosion.x);
    float localMoisture = max(0.0, state.z) + max(0.0, aux.y);
    float moistureProtection = saturate(localMoisture / dryThreshold);
    float cohesion = saturate(
        _Erosion.z
        + definition.physical.y
        + soilQuality * 0.35 * max(0.0, _EruptionB.w)
        + moistureProtection * max(0.0, _MoistureErosion.y)
        + (float)CountGrassRootTapsOnCell(_GrassRead, cell, _GridSize) * saturate(_GrassI.y) * _Erosion.z
        + (float)CountTreeRootsOnCell(_TreeRead, cell, _GridSize) * saturate(_TreeH.y) * _Erosion.z);

    // Continuous linear recovery for sediment-source solids. Sustained loading must
    // exceed surfaceStressRecoveryRate (_Erosion.w) on average to accumulate toward conversion.
    if (material != 14u || aux.y <= 0.01)
    {
        if (IsHardCrustMaterial(material) || material == 7u || material == 15u)
            aux.w = max(0.0, aux.w - max(0.0, _Erosion.w) * _DeltaTime);
    }

    // Epigenic Karst Dissolution for Limestone (14)
    if (material == 14u && aux.y > 0.01)
    {
        // Carbonic acidity enriched by soil organics, detritus, and roots
        float organicAcidity = 1.0 + 2.5 * saturate(aux.z);
        int2 aboveCell = cell + int2(0, 1);
        uint aboveMat = aboveCell.y < _GridSize.y ? M(aboveCell) : 0u;
        if (aboveMat == 7u || aboveMat == 131u)
            organicAcidity += 2.0;

        float karstRate = max(0.001, _Hydrology.z); // config.dissolutionRate
        float flowBoost = 1.0 + 1.5 * flowEnergy;
        float carve = karstRate * 7.5 * (aux.y + 0.02) * organicAcidity * flowBoost * (1.0 - cohesion * 0.5) * _DeltaTime;
        aux.w += carve;

        // Cumulative dissolution carves an underground cave cavity!
        if (aux.w >= 1.0)
        {
            int2 above = cell + int2(0, 1);
            int2 belowC = cell + int2(0, -1);
            int leftX = (cell.x - 1 + _GridSize.x) % _GridSize.x;
            int rightX = (cell.x + 1) % _GridSize.x;

            // Vadose (unsaturated cave air) vs Phreatic (flooded conduit)
            bool vadose = NeighborOpensVadose(above)
                       || NeighborOpensVadose(belowC)
                       || NeighborOpensVadose(int2(leftX, cell.y))
                       || NeighborOpensVadose(int2(rightX, cell.y))
                       || aux.y < definition.biology.z * 0.85;

            if (vadose)
            {
                material = 1u; // Air-filled cave chamber
                float releasedWater = aux.y;
                aux.y = 0.0;
                state.z += releasedWater * 0.7; // Dripping moisture film
                aux.x += releasedWater * 0.3;   // Cave air humidity
            }
            else
            {
                material = 9u; // Water-filled phreatic conduit
                state.z = max(1.0, aux.y);
                aux.y = 0.0;
            }
            aux.w = 0.0;
            aux.z = saturate(aux.z + 0.08); // Residual mineral fertility
            Write(cell, material, state, flow, aux, ecology, combustion);
            return;
        }
    }

    // Speleothem Dripstone Formation strictly restricted to enclosed subterranean cave chambers
    if (material == 1u && cell.y > 1 && cell.y < _GridSize.y - 3)
    {
        int2 above = cell + int2(0, 1);
        uint aboveMat = M(above);
        float4 aboveAux = A(above);
        float4 aboveState = S(above);

        // Stalactite: dripping saturated water from limestone ceiling precipitates calcite downward.
        // Requires solid overburden above the ceiling (not open sky) to ensure it is inside an underground cave.
        uint aboveOverburden = M(above + int2(0, 1));
        bool isEnclosedCeiling = aboveOverburden >= 2u && aboveOverburden != 9u && aboveOverburden != 10u;
        if (aboveMat == 14u && isEnclosedCeiling && (aboveAux.y > 0.08 || aboveState.z > 0.04))
        {
            aux.w += max(0.001, _Hydrology.z) * 0.015 * _DeltaTime;
            if (aux.w > 1.2)
            {
                material = 14u; // Stalactite grows downward
                aux.w = 0.0;
                aux.y = 0.05;
            }
        }

        // Stalagmite: floor beneath dripping cave air can only grow upward if there is an
        // active dripping limestone ceiling directly overhead within the cave chamber.
        int2 below = cell + int2(0, -1);
        uint belowMat = M(below);
        if (belowMat == 14u || belowMat == 4u || belowMat == 8u)
        {
            bool hasOverheadLimestoneDrip = false;
            [unroll]
            for (int dy = 1; dy <= 8; dy++)
            {
                int yProbe = cell.y + dy;
                if (yProbe >= _GridSize.y - 1) break;
                uint pMat = M(int2(cell.x, yProbe));
                if (pMat == 14u)
                {
                    float4 pAux = A(int2(cell.x, yProbe));
                    float4 pState = S(int2(cell.x, yProbe));
                    uint pOverburden = M(int2(cell.x, yProbe + 1));
                    if ((pAux.y > 0.02 || pState.z > 0.02) && pOverburden >= 2u && pOverburden != 9u && pOverburden != 10u)
                    {
                        hasOverheadLimestoneDrip = true;
                    }
                    break;
                }
                else if (pMat != 1u)
                {
                    // Non-air obstruction (e.g. granite, ice, water) - not an open cave drip path
                    break;
                }
            }

            if (hasOverheadLimestoneDrip && (state.z > 0.01 || aboveState.z > 0.02 || aboveAux.y > 0.04))
            {
                aux.w += max(0.001, _Hydrology.z) * 0.010 * _DeltaTime;
                if (aux.w > 1.4)
                {
                    material = 14u; // Stalagmite grows upward
                    aux.w = 0.0;
                    aux.y = 0.05;
                }
            }
        }
    }

    // Ordinary wind/runoff erosion: exposed soil/clay only. Moisture raises cohesion and
    // suppresses stress gain; dryness alone never converts without sustained flow.
    if ((material == 7u || material == 15u) && exposed)
    {
        float erodibility = 1.0 - moistureProtection;
        if (flowEnergy > cohesion + 0.25 && erodibility > 0.05)
        {
            float erode = _Erosion.x * flowEnergy * erodibility * _DeltaTime;
            aux.w += erode;
            if (aux.w > 1.0)
            {
                material = 8u;
                aux.w = 0.0;
            }
        }
    }
    else if ((material == 4u || material == 14u) && flowEnergy > cohesion + 0.25)
    {
        float erode = _Erosion.x * flowEnergy * _DeltaTime;
        aux.w += erode;
        if (aux.w > 1.0)
        {
            material = 8u;
            aux.w = 0.0;
        }
    }

    uint below = cell.y > 0 ? M(cell + int2(0, -1)) : 2u;
    float seismic = GeodynamicsSeismicEnvelope(cell.x, Radius01(cell.y, _GridSize.y));
    bool unsupported = below == 0u || below == 1u || below == 9u;

    if (seismic > 0.02 && (exposed || localMoisture > dryThreshold || unsupported || cohesion < 0.55))
        aux.w = saturate(aux.w + seismic * saturate(_Hydrothermal.w) * 0.35 * _DeltaTime);

    // Structural Roof Calving on unsupported rock ceilings/overhangs
    if ((material == 4u || material == 14u || material == 5u) && unsupported)
    {
        // Evaluate void span
        int leftX = (cell.x - 1 + _GridSize.x) % _GridSize.x;
        int rightX = (cell.x + 1) % _GridSize.x;
        uint belowLeft = cell.y > 0 ? M(int2(leftX, cell.y - 1)) : 2u;
        uint belowRight = cell.y > 0 ? M(int2(rightX, cell.y - 1)) : 2u;

        bool wideSpan = (belowLeft == 1u || belowLeft == 0u || belowLeft == 9u)
                     && (belowRight == 1u || belowRight == 0u || belowRight == 9u);

        float spanMultiplier = wideSpan ? 2.5 : 1.0;
        float gravityStress = _Mechanics.x * definition.physical.x * 0.15;
        float bendingStress = gravityStress * spanMultiplier * (1.0 - definition.physical.y * 0.7) * _DeltaTime;

        // Higher collapseRate accelerates structural roof failure
        aux.w += bendingStress * max(0.2, _Hydrology.w * 6.0);

        if (seismic > 0.02)
            aux.w += seismic * 0.5 * _DeltaTime;

        if (aux.w >= 1.0)
        {
            // Ceiling fractures / calvies: aux.w >= 1.0 unpins it in Margolus to drop under gravity
            aux.w = 1.0;
        }
    }
    else if ((material == 7u || material == 15u) && unsupported && cohesion < _Hydrology.w)
    {
        material = 8u; // Soft soils detach into sediment
        aux.w = 0.0;
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void AshFertilization(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    float fertility = max(0.0, _EruptionB.w);

    if (material == 12u && cell.y > 0)
    {
        uint below = M(cell + int2(0, -1));
        if (below == 8u)
        {
            // Consume ash resting on sediment into fertile soil at this cell.
            material = 7u;
            aux.z = saturate(aux.z + 0.45 * fertility);
            state.x = min(state.x, 45.0);
            flow *= 0.5;
        }
        else if (below == 7u)
        {
            // Transfer nutrients into soil below by dissolving ash into air.
            material = 1u;
            state.x = min(state.x, 25.0);
            flow *= 0.25;
            aux.z = 0.0;
        }
    }
    else if (material == 8u)
    {
        uint above = M(cell + int2(0, 1));
        if (above == 12u)
        {
            material = 7u;
            aux.z = saturate(aux.z + 0.45 * fertility);
            flow *= 0.5;
        }
    }
    else if (material == 7u)
    {
        uint above = M(cell + int2(0, 1));
        if (above == 12u)
            aux.z = saturate(aux.z + 0.35 * fertility);
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void DetritusExchange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    float absorbRate = max(0.0, _DetritusA.x);
    float evapRate = max(0.0, _DetritusA.y);
    float distRate = max(0.0, _DetritusA.z);
    float leachRate = max(0.0, _DetritusA.w);
    float decayRate = max(0.0, _DetritusB.x);
    float vaporRead = max(0.0, aux.x);
    float moistureRead = max(0.0, aux.y);
    float nutrientRead = max(0.0, aux.z);
    float vaporDelta = 0.0;
    float moistureDelta = 0.0;
    float nutrientDelta = 0.0;

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int ny = cell.y + offset.y;
            if (ny < 0 || ny >= _GridSize.y) continue;
        }
        int2 neighbor = C(cell + offset);
        uint nMat = M(neighbor);
        float4 nAux = A(neighbor);
        MaterialGpuData nDef = D(nMat);

        if (IsDetritusMaterial(material) && IsAtmosphereCell(neighbor, nMat))
        {
            float room = max(0.0, 1.0 - moistureRead);
            float absorb = min(min(max(0.0, nAux.x), room), absorbRate * max(0.0, nAux.x) * _DeltaTime * 0.25);
            moistureDelta += absorb;
            float evap = EvaporateToAir(state.x, nAux.x, moistureRead, evapRate * 0.25, _DeltaTime, _WeatherE.x);
            moistureDelta -= evap;
        }
        else if (IsAtmosphereCell(cell, material) && IsDetritusMaterial(nMat))
        {
            float room = max(0.0, 1.0 - nAux.y);
            float absorb = min(min(vaporRead, room), absorbRate * vaporRead * _DeltaTime * 0.25);
            vaporDelta -= absorb;
            float evap = EvaporateToAir(S(neighbor).x, vaporRead, nAux.y, evapRate * 0.25, _DeltaTime, _WeatherE.x);
            vaporDelta += evap;
        }

        if (IsDetritusMaterial(material) && IsGroundwaterHost(nMat, nDef))
        {
            float excess = max(0.0, moistureRead - 0.45);
            float nCap = max(0.0, GroundwaterCapacity(nDef) - nAux.y);
            float give = min(excess, min(nCap, distRate * excess * _DeltaTime * 0.25));
            moistureDelta -= give;
        }
        else if (IsGroundwaterHost(material, D(material)) && IsDetritusMaterial(nMat))
        {
            float excess = max(0.0, nAux.y - 0.45);
            float cap = max(0.0, GroundwaterCapacity(D(material)) - moistureRead);
            float recv = min(excess, min(cap, distRate * excess * _DeltaTime * 0.25));
            moistureDelta += recv;
        }

        if (IsDetritusMaterial(material) && nMat == 7u)
        {
            float leach = min(nutrientRead, leachRate * nutrientRead * _DeltaTime * 0.25);
            nutrientDelta -= leach;
        }
        else if (material == 7u && IsDetritusMaterial(nMat))
        {
            float leach = min(max(0.0, nAux.z), leachRate * max(0.0, nAux.z) * _DeltaTime * 0.25);
            nutrientDelta += leach;
        }
    }

    aux.x = max(0.0, vaporRead + vaporDelta);
    aux.y = max(0.0, moistureRead + moistureDelta);
    aux.z = max(0.0, nutrientRead + nutrientDelta);

    if (IsDetritusMaterial(material))
    {
        if (decayRate > 0.0)
            aux.z = max(0.0, aux.z - decayRate * _DeltaTime);
        if (decayRate > 0.0 && aux.z <= 1e-4)
        {
            bool exposed = IsExposedSurface(cell, material);
            material = exposed ? 1u : 7u;
            if (material == 1u)
            {
                aux.x += aux.y;
                aux.y = 0.0;
            }
        }
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void ApplyFlowerDrop(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    uint claim = _GrassDropClaims[cell];
    bool dropHere = claim != GRASS_CLAIM_EMPTY && IsOpenCarrier(material);
    if (dropHere)
    {
        int2 source = UnpackFaunaCell(claim, _GridSize);
        bool valid = false;
        [unroll]
        for (uint checkSlot = 0u; checkSlot < 3u; checkSlot++)
        {
            if (GrassHasReleased(SampleGrassTiming(_GrassRead, source, checkSlot)))
                valid = true;
        }
        if (valid)
        {
            material = MATERIAL_DETRITUS;
            aux.y = max(aux.y, saturate(_GrassI.w));
            aux.z = max(aux.z, saturate(_GrassI.z));
            combustion = SeedCombustion(material, D(material));
        }
    }
    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(64, 1, 1)]
void ApplyHydrostaticColumns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int x = (int)id.x;
    int bedY;
    float volume;
    float temperature;
    float head;
    int waterTop;
    bool hadPixels;
    ProfileSurfaceColumn(x, bedY, volume, temperature, head, waterTop, hadPixels);

    // BuildSurfaceWaterColumns profiled the same textures with the same code, so the solved
    // column started from this exact volume. The difference is everything the relaxation
    // iterations moved across this column's two faces.
    float4 solved = _WaterColumns[x];
    float newVolume = max(0.0, solved.y);
    float newTemp = newVolume > 1e-6 ? solved.z : temperature;
    float net = newVolume - volume;

    bool canFilm = false;
    uint bedMat = 0u;
    if (bedY >= 0)
    {
        bedMat = M(int2(x, bedY));
        canFilm = IsFilmSubstrate(int2(x, bedY), bedMat);
    }
    int expectedCells;
    float remainder;
    PartitionSurfaceVolume(newVolume, canFilm, expectedCells, remainder);
    int bedL = (int)round(_WaterColumns[WrapTheta(x - 1, _GridSize.x)].x);
    int bedR = (int)round(_WaterColumns[WrapTheta(x + 1, _GridSize.x)].x);
    float stepGrade = max((float)abs(bedY - bedL), (float)abs(bedY - bedR));
    float slopeFactor = 1.0 / sqrt(1.0 + stepGrade * stepGrade);
    KeepLandedRainPixel(hadPixels, newVolume, slopeFactor, _HydrologyC.y, expectedCells, remainder);
    int currentCells = hadPixels ? max(0, waterTop - bedY) : 0;
    // Flux can move many cells of volume in one tick. Spawning the whole stack at once
    // is the tower artifact; keep extra mass on film (or the top pixel) and grow by one.
    int maxNewCells = currentCells + 1;
    if (expectedCells > maxNewCells)
    {
        expectedCells = maxNewCells;
        remainder = max(0.0, newVolume - (float)expectedCells);
    }
    bool spawnPixels = expectedCells > 0 && bedY >= 0;
    float currentFilm = 0.0;
    if (bedY >= 0 && canFilm)
        currentFilm = max(0.0, S(int2(x, bedY)).z);
    float expectedFilm = spawnPixels ? remainder : (canFilm ? newVolume : 0.0);
    bool mismatch = expectedCells != currentCells || abs(currentFilm - expectedFilm) > 1e-5;

    int newCells = spawnPixels ? expectedCells : 0;
    int newTop = spawnPixels ? bedY + newCells : bedY;
    int oldTop = hadPixels ? waterTop : bedY;
    bool idle = abs(net) <= 1e-8 && !mismatch;

    // Evacuate any vapor or cloud from cells about to be inundated by rising water,
    // plus any vapor trapped inside submerged liquid cells, so it vents to the air
    // cell above newTop instead of being duplicated or trapped underwater.
    float displacedVapor = 0.0;
    float displacedCloud = 0.0;
    if (!idle && bedY >= 0)
    {
        if (newTop > oldTop)
        {
            [loop]
            for (int iy = max(bedY + 1, oldTop + 1); iy <= min(newTop, _GridSize.y - 1); iy++)
            {
                int2 icell = int2(x, iy);
                uint imat = M(icell);
                if (imat == 0u || imat == 1u)
                {
                    displacedVapor += max(0.0, A(icell).x);
                    displacedCloud += max(0.0, S(icell).z);
                }
                else if (IsAirborneLiquid(icell, imat))
                {
                    displacedCloud += max(0.0, S(icell).z);
                }
            }
        }
        [loop]
        for (int sy = bedY + 1; sy <= min(max(oldTop, newTop), _GridSize.y - 1); sy++)
        {
            int2 scell = int2(x, sy);
            uint smat = M(scell);
            if (smat == 9u || smat == 10u)
            {
                displacedVapor += max(0.0, A(scell).x);
            }
        }
    }

    int rewriteMax = min(_GridSize.y - 1, max(oldTop, newTop) + ((displacedVapor > 1e-8 || displacedCloud > 1e-8) ? 1 : 0));

    [loop]
    for (int y = 0; y < _GridSize.y; y++)
    {
        int2 cell = int2(x, y);
        uint material = M(cell);
        float4 state = S(cell);
        float2 flow = F(cell);
        float4 aux = A(cell);
        float4 ecology = E(cell);
        float4 combustion = Comb(cell);

        bool rewrite = !idle && bedY >= 0 && y >= bedY && y <= rewriteMax;
        if (rewrite && y == bedY)
        {
            if (canFilm)
                state.z = expectedFilm;
            flow.x += net * 2.0;
            if ((material == 7u || material == 8u || material == 15u) && state.z > 0.05 && D(material).biology.z > 0.2)
                flow *= saturate(1.0 - max(0.0, _HydrologyC.y) * 0.25 * _DeltaTime);
        }
        else if (rewrite && y > bedY && y <= max(oldTop, newTop) && IsRewritableCarrier(material) && !IsHydrometeor(cell, material))
        {
            int slot = y - (bedY + 1);
            float slotMass = 0.0;
            if (spawnPixels && slot >= 0 && slot < newCells)
            {
                if (canFilm && newCells == 1 && newVolume < 1.0 - 1e-6)
                    slotMass = newVolume;
                else if (canFilm)
                    slotMass = 1.0;
                else if (slot == newCells - 1)
                    slotMass = max(0.0, newVolume - (float)slot);
                else
                    slotMass = 1.0;
            }
            if (slotMass > 1e-6)
            {
                material = 9u;
                state.z = slotMass;
                state.x = newTemp;
                aux.x = (y == newTop && oldTop == newTop) ? max(0.0, aux.x) : 0.0;
                aux.y = 0.0;
                flow.x += net * 0.35;
            }
            else if (material == 9u && !IsAirborneLiquid(cell, material))
            {
                material = 1u;
                state.z = 0.0;
                aux.x = 0.0;
                aux.y = 0.0;
            }
        }
        else if (rewrite && y == newTop + 1 && (material == 0u || material == 1u))
        {
            aux.x += displacedVapor;
            state.z += displacedCloud;
        }

        Write(cell, material, state, flow, aux, ecology, combustion);
    }
}
