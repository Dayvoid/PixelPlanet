#pragma kernel Groundwater
#pragma kernel GeothermalDischarge
#pragma kernel ErosionAndCollapse
#pragma kernel AshFertilization
#pragma kernel WaterMaterialization
#pragma kernel DetritusExchange
#pragma kernel ApplyFlowerDrop
#pragma kernel ApplyHydrostaticColumns

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
Texture2DArray<float4> _GrassRead;
Texture2D<uint> _GrassDropClaims;
StructuredBuffer<float4> _WaterFaceFlux;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC; // runoffRate, pondingRate, fieldCapacityFraction, geyserCooldownSeconds
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherD;
float4 _WeatherE; // saturationCapacityScale, cloudPrecipitationThreshold, rainPixelFormationThreshold, surfaceWaterPixelThreshold
float4 _EruptionA;
float4 _EruptionB;
float4 _MoistureErosion; // dryMoistureThreshold, moistureCohesionStrength, capillaryEvaporationFraction, unused
float4 _GrassI; // seedAtWorldgen, cohesionBonus, detritusNutrient, detritusMoisture
float4 _DetritusA; // vaporAbsorb, evaporate, distribute, leach
float4 _DetritusB; // decomposition, unused

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 E(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

#include "../../Shaders/Simulation/Common/SurfaceWater.hlsl"

bool IsExposedSurface(int2 cell, uint material)
{
    uint above = M(cell + int2(0, 1));
    return D(above).metadata.x <= 1.0 && material != 1u && material != 0u && material != 11u;
}

uint LiquidPixelId(float temperature)
{
    return temperature < 0.0 ? 10u : 9u;
}

bool IsRewritableCarrier(uint material)
{
    return material == 0u || material == 1u || material == 9u || material == 10u || material == 11u;
}

void Write(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, SampleLife(_LifeGenomeRead, cell), SampleGenome(_LifeGenomeRead, cell));
}

[numthreads(8, 8, 1)]
void Groundwater(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    MaterialGpuData definition = D(material);
    float porosity = saturate(definition.biology.z);
    float absorbency = saturate(definition.transport.w);
    bool exposed = IsExposedSurface(cell, material);
    bool host = IsGroundwaterHost(material, definition);
    float capacity = GroundwaterCapacity(definition);
    float fieldCapacityFraction = saturate(_HydrologyC.z);
    float waterHeatCapacity = max(0.001, D(9u).transport.y);
    float infiltrationRate = _Hydrology.x;
    float groundwaterRate = _Hydrology.y;

    // Every neighbor exchange below is evaluated from pre-tick fields that both cells can read,
    // so a donor's subtraction and a receiver's addition are always the same number.
    float groundwaterRead = max(0.0, aux.y);
    float groundwaterDelta = 0.0;

    if (host)
    {
        float remaining = max(0.0, capacity - groundwaterRead);
        float film = InfiltrationAmount(state.z, remaining, absorbency, porosity, infiltrationRate, _DeltaTime);
        state.z -= film;
        groundwaterDelta += film;

        if (cell.y < _GridSize.y - 1)
        {
            int2 above = cell + int2(0, 1);
            uint aboveMaterial = M(above);
            if (aboveMaterial == 9u)
            {
                float4 aboveState = S(above);
                float soak = InfiltrationAmount(aboveState.z, remaining, absorbency, porosity, infiltrationRate, _DeltaTime);
                groundwaterDelta += soak;
                state.x = MixTemperature(state.x, definition.transport.y, aboveState.x, soak, waterHeatCapacity);
            }
        }
    }

    if (material == 9u && cell.y > 0)
    {
        int2 below = cell + int2(0, -1);
        uint belowMaterial = M(below);
        MaterialGpuData belowDef = D(belowMaterial);
        if (IsGroundwaterHost(belowMaterial, belowDef))
        {
            float remaining = max(0.0, GroundwaterCapacity(belowDef) - A(below).y);
            float soak = InfiltrationAmount(state.z, remaining, saturate(belowDef.transport.w),
                saturate(belowDef.biology.z), infiltrationRate, _DeltaTime);
            state.z -= soak;
            // Only a pixel that actually drained may give up its residue; otherwise a pixel
            // resting on soil with infiltration disabled would still evaporate itself away.
            if (soak > 0.0 && state.z < 0.05)
            {
                aux.x += state.z;
                state.z = 0.0;
                material = 1u;
            }
        }
    }

    if (host)
    {
        if (cell.y < _GridSize.y - 1)
        {
            int2 above = cell + int2(0, 1);
            uint aboveMaterial = M(above);
            MaterialGpuData aboveDef = D(aboveMaterial);
            if (IsGroundwaterHost(aboveMaterial, aboveDef))
            {
                float perc = PercolationAmount(A(above).y, GroundwaterCapacity(aboveDef), groundwaterRead, capacity,
                    saturate(aboveDef.biology.z), porosity, groundwaterRate, fieldCapacityFraction, _DeltaTime);
                groundwaterDelta += perc;
                state.x = MixTemperature(state.x, definition.transport.y, S(above).x, perc, waterHeatCapacity);
            }
        }
        if (cell.y > 0)
        {
            int2 below = cell + int2(0, -1);
            uint belowMaterial = M(below);
            MaterialGpuData belowDef = D(belowMaterial);
            if (IsGroundwaterHost(belowMaterial, belowDef))
            {
                float perc = PercolationAmount(groundwaterRead, capacity, A(below).y, GroundwaterCapacity(belowDef),
                    porosity, saturate(belowDef.biology.z), groundwaterRate, fieldCapacityFraction, _DeltaTime);
                groundwaterDelta -= perc;
            }
        }

        float lateralRate = groundwaterRate * 0.35;
        int2 left = cell + int2(-1, 0);
        int2 right = cell + int2(1, 0);
        uint leftMaterial = M(left);
        uint rightMaterial = M(right);
        MaterialGpuData leftDef = D(leftMaterial);
        MaterialGpuData rightDef = D(rightMaterial);
        if (IsGroundwaterHost(leftMaterial, leftDef))
        {
            groundwaterDelta += LateralGroundwaterReceive(groundwaterRead, A(left).y, capacity, GroundwaterCapacity(leftDef),
                porosity, saturate(leftDef.biology.z), lateralRate, _DeltaTime);
        }
        if (IsGroundwaterHost(rightMaterial, rightDef))
        {
            groundwaterDelta += LateralGroundwaterReceive(groundwaterRead, A(right).y, capacity, GroundwaterCapacity(rightDef),
                porosity, saturate(rightDef.biology.z), lateralRate, _DeltaTime);
        }
        aux.y = max(0.0, groundwaterRead + groundwaterDelta);
    }
    else if (material == 9u || material == 10u)
    {
        // A host that turned to liquid keeps its water as surface mass instead of dropping it.
        state.z += groundwaterRead;
        aux.y = 0.0;
    }
    else if (IsAtmosphereCell(cell, material))
    {
        aux.x += groundwaterRead;
        aux.y = 0.0;
    }

    float springThreshold = _HydrologyB.x;
    float head = aux.y + state.y * 0.15 + aux.w * 0.25;
    if (host && exposed && head > springThreshold)
    {
        float discharge = min(aux.y, (head - springThreshold) * _HydrologyB.y * _DeltaTime);
        aux.y -= discharge;
        state.z += discharge;
        flow.y += discharge * 0.5;
    }

    float leftWater = S(cell + int2(-1, 0)).z;
    float rightWater = S(cell + int2(1, 0)).z;
    flow.x += (leftWater - rightWater) * 0.25 * _DeltaTime;
    if (material == 9u || state.z > 0.05)
        flow.y -= state.z * _Mechanics.x * 0.1 * _DeltaTime;

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void GeothermalDischarge(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    bool exposed = IsExposedSurface(cell, material);

    float hotBelow = S(cell + int2(0, -1)).x;
    uint belowMat = M(cell + int2(0, -1));
    if (belowMat == 6u || belowMat == 3u) hotBelow = max(hotBelow, 850.0);

    float cooldownTicks = max(5.0, _HydrologyC.w * 20.0);
    float phase = frac((float)_Tick / cooldownTicks + Hash01(cell.x * 19349669u + cell.y * 83492791u + (uint)_Tick));
    bool geyserReady = phase > 0.92;

    if (exposed && aux.y > _HydrologyB.x && hotBelow > _HydrologyB.z && aux.w > 0.35 && geyserReady)
    {
        float burst = min(aux.y, _HydrologyB.w * _DeltaTime * 3.0);
        aux.y -= burst;
        state.z += burst * 0.65;
        aux.x += burst * 0.35;
        state.x += burst * 40.0;
        state.y += burst * 0.4;
        flow.y += burst * 4.0;
    }

    if (material == 9u && (belowMat == 6u || belowMat == 5u) && hotBelow > 200.0 && aux.w > 0.25)
    {
        float vent = min(state.z, _GeologyB.x * _DeltaTime);
        // The steam that leaves comes out of this cell's liquid rather than out of nowhere.
        float steam = vent * 0.15;
        state.z -= steam;
        aux.x += steam;
        state.x += vent * 35.0;
        aux.z += vent * _GeologyB.y;
        flow.y += vent * 1.5;
        state.y += vent * 0.1;
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void ErosionAndCollapse(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    MaterialGpuData definition = D(material);
    bool exposed = IsExposedSurface(cell, material);
    float flowEnergy = length(flow);
    float soilQuality = saturate(aux.z);
    float dryThreshold = max(0.01, _MoistureErosion.x);
    float localMoisture = max(0.0, state.z) + max(0.0, aux.y);
    float moistureProtection = saturate(localMoisture / dryThreshold);
    float cohesion = saturate(
        _Erosion.z
        + definition.physical.y
        + soilQuality * 0.35 * max(0.0, _EruptionB.w)
        + moistureProtection * max(0.0, _MoistureErosion.y)
        + (float)CountGrassRootTapsOnCell(_GrassRead, cell, _GridSize) * saturate(_GrassI.y) * _Erosion.z);

    // Continuous linear recovery for sediment-source solids. Sustained loading must
    // exceed stressDecayRate (_Erosion.w) on average to accumulate toward conversion.
    if (material == 4u || material == 5u || material == 7u)
        aux.w = max(0.0, aux.w - max(0.0, _Erosion.w) * _DeltaTime);

    if ((material == 4u || material == 5u) && aux.y > 0.55 && definition.metadata.z > 0.5)
    {
        float carve = _Hydrology.z * aux.y * (1.0 - cohesion) * _DeltaTime;
        aux.w += carve;
        if (aux.w > 1.25)
        {
            material = 8u;
            aux.w = 0.0;
            state.z += aux.y * 0.2;
            aux.y *= 0.8;
        }
    }

    // Ordinary wind/runoff erosion: exposed soil only. Moisture raises cohesion and
    // suppresses stress gain; dryness alone never converts without sustained flow.
    if (material == 7u && exposed)
    {
        float erodibility = 1.0 - moistureProtection;
        if (flowEnergy > cohesion + 0.25 && erodibility > 0.05)
        {
            float erode = _Erosion.x * flowEnergy * erodibility * _DeltaTime;
            aux.w += erode;
            if (aux.w > 1.0)
            {
                material = 8u;
                aux.w = 0.0;
            }
        }
    }
    else if (material == 4u && flowEnergy > cohesion + 0.25)
    {
        float erode = _Erosion.x * flowEnergy * _DeltaTime;
        aux.w += erode;
        if (aux.w > 1.0)
        {
            material = 8u;
            aux.w = 0.0;
        }
    }

    uint below = M(cell + int2(0, -1));
    if ((material == 4u || material == 7u) && (below == 0u || below == 1u) && cohesion < _Hydrology.w)
        material = 8u;

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void AshFertilization(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    float fertility = max(0.0, _EruptionB.w);

    if (material == 12u && cell.y > 0)
    {
        uint below = M(cell + int2(0, -1));
        if (below == 8u)
        {
            // Consume ash resting on sediment into fertile soil at this cell.
            material = 7u;
            aux.z = saturate(aux.z + 0.45 * fertility);
            state.x = min(state.x, 45.0);
            flow *= 0.5;
        }
        else if (below == 7u)
        {
            // Transfer nutrients into soil below by dissolving ash into air.
            material = 1u;
            state.x = min(state.x, 25.0);
            flow *= 0.25;
            aux.z = 0.0;
        }
    }
    else if (material == 8u)
    {
        uint above = M(cell + int2(0, 1));
        if (above == 12u)
        {
            material = 7u;
            aux.z = saturate(aux.z + 0.45 * fertility);
            flow *= 0.5;
        }
    }
    else if (material == 7u)
    {
        uint above = M(cell + int2(0, 1));
        if (above == 12u)
            aux.z = saturate(aux.z + 0.35 * fertility);
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void WaterMaterialization(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    float rainThreshold = _WeatherE.z;
    float surfaceThreshold = _WeatherE.w;
    bool precipitationEnabled = _WeatherB.w > 1e-6;
    bool open = IsOpenCarrier(material);

    bool surfaceSpawn = false;
    float transfer = 0.0;
    if (open && cell.y > 0 && surfaceThreshold > 1e-6)
    {
        int2 below = cell + int2(0, -1);
        uint belowMat = M(below);
        bool belowSubstrate = IsFilmSubstrate(below, belowMat);
        float belowWater = S(below).z;
        if (belowSubstrate && belowWater >= surfaceThreshold)
        {
            transfer = min(belowWater, 1.0);
            surfaceSpawn = transfer >= surfaceThreshold;
        }
    }

    // A saturated cloud stack must not rain out in one dispatch. Only the lowest cell
    // with clear air beneath it sheds a drop, so rain arrives as separated pixels that
    // the surface solver can level between arrivals instead of a one-wide tower.
    bool clearBelow = false;
    if (cell.y > 0)
    {
        int2 below = cell + int2(0, -1);
        uint belowMaterial = M(below);
        clearBelow = IsAtmosphereCell(below, belowMaterial) && S(below).z < rainThreshold;
    }

    if (surfaceSpawn)
    {
        float vapor = max(0.0, aux.x);
        aux.x = 0.0;
        state.z += transfer + vapor;
        state.y = max(0.0, state.y - vapor * _WeatherC.x);
        float4 belowState = S(cell + int2(0, -1));
        MaterialGpuData selfDef = D(material);
        state.x = MixTemperature(state.x, max(0.001, selfDef.transport.y), belowState.x, transfer, max(0.001, D(9u).transport.y));
        material = LiquidPixelId(state.x);
    }
    else if (IsAtmosphereCell(cell, material) && precipitationEnabled && rainThreshold > 1e-6
        && state.z >= rainThreshold && clearBelow)
    {
        float vapor = max(0.0, aux.x);
        aux.x = 0.0;
        state.z += vapor;
        state.y = max(0.0, state.y - vapor * _WeatherC.x);
        material = LiquidPixelId(state.x);
    }

    if (IsFilmSubstrate(cell, material)
        && surfaceThreshold > 1e-6 && state.z >= surfaceThreshold && cell.y < _GridSize.y - 1)
    {
        uint aboveMat = M(cell + int2(0, 1));
        if (IsOpenCarrier(aboveMat))
        {
            float moved = min(state.z, 1.0);
            if (moved >= surfaceThreshold)
                state.z -= moved;
        }
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void DetritusExchange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    float absorbRate = max(0.0, _DetritusA.x);
    float evapRate = max(0.0, _DetritusA.y);
    float distRate = max(0.0, _DetritusA.z);
    float leachRate = max(0.0, _DetritusA.w);
    float decayRate = max(0.0, _DetritusB.x);

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int ny = cell.y + offset.y;
            if (ny < 0 || ny >= _GridSize.y) continue;
        }
        int2 neighbor = C(cell + offset);
        uint nMat = M(neighbor);
        float4 nAux = A(neighbor);
        MaterialGpuData nDef = D(nMat);

        if (IsDetritusMaterial(material) && IsAtmosphereCell(neighbor, nMat))
        {
            float room = max(0.0, 1.0 - aux.y);
            float absorb = min(min(max(0.0, nAux.x), room), absorbRate * max(0.0, nAux.x) * _DeltaTime * 0.25);
            aux.y += absorb;
            float evap = min(max(0.0, aux.y), evapRate * max(0.0, aux.y) * _DeltaTime * 0.25);
            aux.y -= evap;
        }
        else if (IsAtmosphereCell(cell, material) && IsDetritusMaterial(nMat))
        {
            float room = max(0.0, 1.0 - nAux.y);
            float absorb = min(min(max(0.0, aux.x), room), absorbRate * max(0.0, aux.x) * _DeltaTime * 0.25);
            aux.x = max(0.0, aux.x - absorb);
            float evap = min(max(0.0, nAux.y), evapRate * max(0.0, nAux.y) * _DeltaTime * 0.25);
            aux.x += evap;
        }

        if (IsDetritusMaterial(material) && IsGroundwaterHost(nMat, nDef))
        {
            float excess = max(0.0, aux.y - 0.45);
            float nCap = max(0.0, GroundwaterCapacity(nDef) - nAux.y);
            float give = min(excess, min(nCap, distRate * excess * _DeltaTime * 0.25));
            aux.y -= give;
        }
        else if (IsGroundwaterHost(material, D(material)) && IsDetritusMaterial(nMat))
        {
            float excess = max(0.0, nAux.y - 0.45);
            float cap = max(0.0, GroundwaterCapacity(D(material)) - aux.y);
            float recv = min(excess, min(cap, distRate * excess * _DeltaTime * 0.25));
            aux.y += recv;
        }

        if (IsDetritusMaterial(material) && nMat == 7u)
        {
            float leach = min(max(0.0, aux.z), leachRate * max(0.0, aux.z) * _DeltaTime * 0.25);
            aux.z -= leach;
        }
        else if (material == 7u && IsDetritusMaterial(nMat))
        {
            float leach = min(max(0.0, nAux.z), leachRate * max(0.0, nAux.z) * _DeltaTime * 0.25);
            aux.z += leach;
        }
    }

    if (IsDetritusMaterial(material))
    {
        aux.z = max(0.0, aux.z - decayRate * _DeltaTime);
        if (aux.z <= 1e-4)
        {
            bool exposed = IsExposedSurface(cell, material);
            material = exposed ? 1u : 7u;
            if (material == 1u)
            {
                aux.x += aux.y;
                aux.y = 0.0;
            }
        }
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void ApplyFlowerDrop(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    uint claim = _GrassDropClaims[cell];
    bool dropHere = claim != GRASS_CLAIM_EMPTY && IsOpenCarrier(material);
    if (dropHere)
    {
        int2 source = UnpackFaunaCell(claim, _GridSize);
        bool valid = false;
        [unroll]
        for (uint checkSlot = 0u; checkSlot < 3u; checkSlot++)
        {
            if (GrassHasReleased(SampleGrassTiming(_GrassRead, source, checkSlot)))
                valid = true;
        }
        if (valid)
        {
            material = MATERIAL_DETRITUS;
            aux.y = max(aux.y, saturate(_GrassI.w));
            aux.z = max(aux.z, saturate(_GrassI.z));
            combustion = SeedCombustion(material, D(material));
        }
    }
    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(64, 1, 1)]
void ApplyHydrostaticColumns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int x = (int)id.x;
    int bedY;
    float volume;
    float temperature;
    float head;
    int waterTop;
    bool hadPixels;
    ProfileSurfaceColumn(x, bedY, volume, temperature, head, waterTop, hadPixels);

    float4 leftFlux = _WaterFaceFlux[WrapTheta(x - 1, _GridSize.x)];
    float4 rightFlux = _WaterFaceFlux[x];
    float incomingHeat = max(0.0, leftFlux.y) + max(0.0, -rightFlux.y);
    float outgoing = max(0.0, rightFlux.x) + max(0.0, -leftFlux.x);
    float stay = max(0.0, volume - outgoing);
    float newVolume = max(0.0, volume + leftFlux.x - rightFlux.x);
    float newTemp = newVolume > 1e-6 ? (stay * temperature + incomingHeat) / newVolume : temperature;
    float net = leftFlux.x - rightFlux.x;

    float threshold = _WeatherE.w;
    bool canFilm = false;
    uint bedMat = 0u;
    if (bedY >= 0)
    {
        bedMat = M(int2(x, bedY));
        canFilm = IsFilmSubstrate(int2(x, bedY), bedMat);
    }
    bool spawnPixels = false;
    if (newVolume > 1e-6 && bedY >= 0)
    {
        if (!canFilm) spawnPixels = true;
        else if (threshold < 1e-6) spawnPixels = hadPixels;
        else spawnPixels = newVolume >= threshold || (hadPixels && newVolume >= 0.05);
    }

    int newCells = spawnPixels ? (int)ceil(newVolume - 1e-6) : 0;
    int newTop = spawnPixels ? bedY + newCells : bedY;
    int oldTop = hadPixels ? waterTop : bedY;
    int rewriteMax = max(oldTop, newTop);
    bool idle = _HydrologyC.x <= 1e-8 || (abs(net) <= 1e-8 && outgoing <= 1e-8 && incomingHeat <= 1e-8);

    [loop]
    for (int y = 0; y < _GridSize.y; y++)
    {
        int2 cell = int2(x, y);
        uint material = M(cell);
        float4 state = S(cell);
        float2 flow = F(cell);
        float4 aux = A(cell);
        float4 ecology = E(cell);
        float4 combustion = Comb(cell);

        bool rewrite = !idle && bedY >= 0 && y >= bedY && y <= rewriteMax;
        if (rewrite && y == bedY)
        {
            if (canFilm)
                state.z = spawnPixels ? 0.0 : newVolume;
            flow.x += net * 2.0;
            if ((material == 7u || material == 8u) && state.z > 0.05 && D(material).biology.z > 0.2)
                flow *= saturate(1.0 - max(0.0, _HydrologyC.y) * 0.25 * _DeltaTime);
        }
        else if (rewrite && y > bedY && IsRewritableCarrier(material))
        {
            int slot = y - (bedY + 1);
            float slotMass = 0.0;
            if (spawnPixels && slot >= 0)
                slotMass = min(1.0, max(0.0, newVolume - (float)slot));
            if (slotMass > 1e-6)
            {
                float rescued = max(0.0, aux.x);
                if (material == 0u || material == 1u || material == 11u)
                    rescued += max(0.0, state.z);
                else if (IsAirborneLiquid(cell, material))
                    rescued += max(0.0, state.z); // The profile skipped this drop, so its mass is not in newVolume.
                material = LiquidPixelId(newTemp);
                state.z = slotMass;
                state.x = newTemp;
                aux.x = rescued;
                aux.y = 0.0;
                flow.x += net * 0.35;
            }
            else if ((material == 9u || material == 10u) && !IsAirborneLiquid(cell, material))
            {
                material = 1u;
                state.z = 0.0;
                aux.y = 0.0;
            }
        }

        Write(cell, material, state, flow, aux, ecology, combustion);
    }
}
