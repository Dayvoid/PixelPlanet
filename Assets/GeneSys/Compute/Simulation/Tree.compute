#pragma kernel Physiology
#pragma kernel ClearGrowthClaims
#pragma kernel ClaimGrowth
#pragma kernel ApplyWorld
#pragma kernel ApplyState
#pragma kernel SeedTree
#pragma kernel PaintTree
#pragma target 5.1

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"
#include "../../Shaders/Simulation/Common/OrganismHistory.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
Texture2D<float> _LightRead;
Texture2D<float4> _GrassRootFlux;
Texture2DArray<float4> _TreeRead;
RWTexture2DArray<float4> _TreeWrite;
Texture2D<uint> _TreeGrowthClaims;
RWTexture2D<uint> _TreeGrowthClaimsWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _TicksPerSecond;
float4 _FloraC;
float4 _FloraD;
float4 _MycologyE;
float4 _TreeA; // waterUptake, nutrientUptake, photosynthesis, growth
float4 _TreeB; // decay, maintenance, nightDrain, vascularRate
float4 _TreeC; // expression, growthTempMin, growthTempMax, growthMoistureMin
float4 _TreeD; // growthMoistureMax, survivalTempMin, survivalTempMax, survivalMoistureMin
float4 _TreeE; // survivalMoistureMax, minLight, growthCost, windBias
float4 _TreeF; // sproutHeight, saplingHeight, maxHeight, maxTrunkWidth
float4 _TreeG; // initialEnergy, initialHydration, initialNutrient, initialHealth
float4 _TreeH; // seedAtWorldgen, cohesionBonus, canopyOpacity, exposureDamage
float4 _TreeI; // leafLifeTicks, rotTicks, disconnectTicks, saplingBranchMin
float4 _TreeJ; // saplingBranchMax, unused
float4 _TreePaintCell;
float4 _GrassI; // unused, unused, detritusNutrient, detritusMoisture

int2 C(int2 value) { return ClampCell(value, _GridSize); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
float4 Eco(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
float LightOf(int2 value) { return _LightRead.Load(int3(C(value), 0)); }
float4 FluxOf(int2 value) { return _GrassRootFlux[C(value)]; }
float4 PhysOf(int2 value) { return SampleTreePhysiology(_TreeRead, C(value)); }
uint4 TopoOf(int2 value) { return SampleTreeTopology(_TreeRead, C(value)); }
uint4 GenomeOf(int2 value) { return SampleTreeGenome(_TreeRead, C(value)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

float MoistureOf(float4 state, float4 aux)
{
    return max(0.0, state.z) + max(0.0, aux.y);
}

float HashCell(int2 cell, uint salt)
{
    return Hash01((uint)cell.x * 73856093u + (uint)cell.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 31337u + salt);
}

int2 OwnerCell(uint4 topology)
{
    if (topology.x == 0u) return int2(-1, -1);
    return UnpackFaunaCell(topology.x, _GridSize);
}

int2 ParentCell(uint4 topology)
{
    if (topology.y == 0u) return int2(-1, -1);
    return UnpackFaunaCell(topology.y, _GridSize);
}

bool SameOwner(uint4 a, uint4 b)
{
    return a.x != 0u && a.x == b.x;
}

bool InGrowthBand(float temp, float moisture, uint4 genome)
{
    float expression = saturate(_TreeC.x);
    float tShift = TreeExpressShift(DecodeGene(genome, TREE_GENE_TEMP_OPTIMUM), expression) * 12.0;
    float tTol = TreeExpressFactor(DecodeGene(genome, TREE_GENE_TEMP_TOLERANCE), expression);
    float mShift = TreeExpressShift(DecodeGene(genome, TREE_GENE_MOISTURE_OPTIMUM), expression) * 0.25;
    float mTol = TreeExpressFactor(DecodeGene(genome, TREE_GENE_MOISTURE_TOLERANCE), expression);
    float tMin = _TreeC.y + tShift - (tTol - 1.0) * 8.0;
    float tMax = _TreeC.z + tShift + (tTol - 1.0) * 8.0;
    float mMin = max(0.0, _TreeC.w + mShift - (mTol - 1.0) * 0.15);
    float mMax = _TreeD.x + mShift + (mTol - 1.0) * 0.15;
    return temp >= tMin && temp <= tMax && moisture >= mMin && moisture <= mMax;
}

bool InSurvivalBand(float temp, float moisture, uint4 genome)
{
    float expression = saturate(_TreeC.x);
    float tShift = TreeExpressShift(DecodeGene(genome, TREE_GENE_TEMP_OPTIMUM), expression) * 12.0;
    float tTol = TreeExpressFactor(DecodeGene(genome, TREE_GENE_TEMP_TOLERANCE), expression);
    float mShift = TreeExpressShift(DecodeGene(genome, TREE_GENE_MOISTURE_OPTIMUM), expression) * 0.25;
    float mTol = TreeExpressFactor(DecodeGene(genome, TREE_GENE_MOISTURE_TOLERANCE), expression);
    float tMin = _TreeD.y + tShift - (tTol - 1.0) * 10.0;
    float tMax = _TreeD.z + tShift + (tTol - 1.0) * 10.0;
    float mMin = max(0.0, _TreeD.w + mShift - (mTol - 1.0) * 0.2);
    float mMax = _TreeE.x + mShift + (mTol - 1.0) * 0.2;
    return temp >= tMin && temp <= tMax && moisture >= mMin && moisture <= mMax;
}

int LocalHeight(int2 cell, uint4 topology)
{
    int2 owner = OwnerCell(topology);
    if (owner.y < 0) return 0;
    return max(0, cell.y - owner.y);
}

int CountOwnedRoleNeighbors(int2 cell, uint ownerPacked, uint role)
{
    int count = 0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        uint4 topo = TopoOf(n);
        if (topo.x == ownerPacked && TreeRole(topo) == role && TreeIsLiving(TreeStage(GenomeOf(n))))
            count++;
    }
    return count;
}

int CountChildren(int2 cell)
{
    uint packed = PackFaunaCell(cell, _GridSize);
    int count = 0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        if (TopoOf(n).y == packed) count++;
    }
    return count;
}

int CountTrunkRun(int2 cell, uint ownerPacked)
{
    int count = 1;
    [unroll]
    for (int dir = -1; dir <= 1; dir += 2)
    {
        [loop]
        for (int step = 1; step <= 8; step++)
        {
            int2 n = C(cell + int2(dir * step, 0));
            uint4 topo = TopoOf(n);
            if (topo.x != ownerPacked) break;
            uint role = TreeRole(topo);
            if (role != TREE_ROLE_TRUNK && role != TREE_ROLE_JUVENILE) break;
            count++;
        }
    }
    return count;
}

bool ParentMissing(int2 cell, uint4 topology)
{
    if ((TreeFlags(topology) & TREE_FLAG_ANCHOR) != 0u) return false;
    int2 parent = ParentCell(topology);
    if (parent.y < 0) return true;
    uint4 pTopo = TopoOf(parent);
    return pTopo.x != topology.x || !TreeIsOccupied(pTopo);
}

float2 RootReceipts(int2 cell, float4 phys)
{
    float demandW = max(0.0, 1.0 - saturate(phys.y)) * max(0.0, _TreeA.x) * _DeltaTime;
    float demandN = max(0.0, 1.0 - saturate(phys.z)) * max(0.0, _TreeA.y) * _DeltaTime;
    int hosts = 0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        if (IsTreeHabitat(M(C(n)))) hosts++;
    }
    float share = 1.0 / (float)max(1, hosts);
    float gotW = 0.0;
    float gotN = 0.0;
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        int2 host = C(n);
        if (!IsTreeHabitat(M(host))) continue;
        float4 flux = FluxOf(host);
        float takenW = flux.x;
        float takenN = flux.y;
        float totalW = flux.z;
        float totalN = flux.w;
        gotW += totalW > 1e-8 ? (demandW * share) / totalW * takenW : 0.0;
        gotN += totalN > 1e-8 ? (demandN * share) / totalN * takenN : 0.0;
    }
    return float2(gotW, gotN);
}

void SampleRootMycology(int2 cell, out uint combinedTraits)
{
    combinedTraits = 0u;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        int2 host = C(n);
        if (!IsTreeHabitat(M(host))) continue;
        combinedTraits |= DecodeMycologyTraits(Eco(host).z);
    }
    combinedTraits = SanitizeMycologyTraits(combinedTraits);
}

bool RootExposedToAir(int2 cell)
{
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        uint mat = M(C(n));
        if (IsTreeOpen(mat)) return true;
    }
    return false;
}

void WriteWorld(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion, float4 life, uint4 genome)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, life, genome, SampleMobile(_LifeGenomeRead, cell));
}

float4 SeedDetritusAux(float4 aux)
{
    aux.y = max(aux.y, max(0.2, saturate(_GrassI.w)));
    aux.z = max(aux.z, max(0.45, saturate(_GrassI.z)));
    return aux;
}

[numthreads(8, 8, 1)]
void Physiology(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    uint4 topology = TopoOf(cell);
    uint4 genome = GenomeOf(cell);
    float4 phys = PhysOf(cell);

    float4 auxPassthrough = A(cell);
    _AuxWrite[cell] = SafeFinite4(max(auxPassthrough, 0.0), 0.0);

    if (!TreeIsOccupied(topology))
    {
        ClearTreeState(_TreeWrite, cell);
        return;
    }

    if (!IsTreeMaterial(material))
    {
        if (TreeRole(topology) == TREE_ROLE_ROOT && IsTreeHabitat(material) && TreeIsLiving(TreeStage(genome)))
        {
            WriteTreeState(_TreeWrite, cell, phys, topology, genome);
            return;
        }
        LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, TreeGeneration(genome), TreeLineage(genome), ORGANISM_CAUSE_CONSUMED);
        ClearTreeState(_TreeWrite, cell);
        return;
    }

    uint stage = TreeStage(genome);
    uint role = TreeRole(topology);
    uint flags = TreeFlags(topology);
    uint cause = TreeCause(topology);
    float timer = asfloat(topology.w);
    float expression = saturate(_TreeC.x);
    float4 state = S(cell);
    float4 aux = A(cell);
    float moisture = MoistureOf(state, aux);
    float light = max(0.0, LightOf(cell));
    float4 combustion = Comb(cell);

    if (stage == TREE_STAGE_DEAD)
    {
        timer = max(0.0, timer - _DeltaTime * max(1.0, _TicksPerSecond));
        if (timer <= 0.0)
            flags |= TREE_FLAG_CONVERT_DETRITUS;
        topology.z = PackTreeTopologyMeta(stage, role, flags, cause);
        topology.w = asuint(timer);
        WriteTreeState(_TreeWrite, cell, phys, topology, genome);
        return;
    }

    if (!TreeIsLiving(stage))
    {
        ClearTreeState(_TreeWrite, cell);
        return;
    }

    if (ParentMissing(cell, topology))
    {
        timer = max(0.0, timer) + _DeltaTime * max(1.0, _TicksPerSecond);
        if (timer >= max(1.0, _TreeI.z))
        {
            stage = TREE_STAGE_DEAD;
            cause = ORGANISM_CAUSE_DESICCATION;
            genome.w = PackTreeMeta(stage, TreeGeneration(genome), TreeLineage(genome), TreeToxinDose(genome));
            topology.z = PackTreeTopologyMeta(stage, role, flags, cause);
            topology.w = asuint(max(1.0, _TreeI.y));
            LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, TreeGeneration(genome), TreeLineage(genome), cause);
            WriteTreeState(_TreeWrite, cell, phys, topology, genome);
            return;
        }
    }
    else if (role != TREE_ROLE_LEAF)
        timer = max(0.0, timer);

    float4 exchanged = phys;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    uint packedSelf = PackFaunaCell(cell, _GridSize);
    float vascular = saturate(max(0.0, _TreeB.w) * _DeltaTime) * 0.25;
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        int2 neighbor = C(n);
        uint4 nTopo = TopoOf(neighbor);
        if (!SameOwner(topology, nTopo)) continue;
        if (nTopo.y != packedSelf && topology.y != PackFaunaCell(neighbor, _GridSize) && nTopo.x != packedSelf)
            continue;
        float4 nPhys = PhysOf(neighbor);
        exchanged.xyz += (nPhys.xyz - phys.xyz) * vascular;
    }
    phys.xyz = saturate(exchanged.xyz);

    uint traits = 0u;
    if (role == TREE_ROLE_ROOT)
    {
        float2 receipts = RootReceipts(cell, phys);
        phys.y = saturate(phys.y + receipts.x);
        phys.z = saturate(phys.z + receipts.y * 3.0);
        SampleRootMycology(cell, traits);
        if (RootExposedToAir(cell))
        {
            flags |= TREE_FLAG_EXPOSED;
            phys.w = saturate(phys.w - max(0.0, _TreeH.w) * _DeltaTime);
        }
        else
            flags &= ~TREE_FLAG_EXPOSED;
    }

    float traitEffect = saturate(_MycologyE.z);
    float droughtMul = 1.0;
    float heatMul = 1.0;
    if ((traits & MYCO_DROUGHT_RESISTANT) != 0u) droughtMul += 0.25 * traitEffect;
    if ((traits & MYCO_DROUGHT_PRONE) != 0u) droughtMul -= 0.2 * traitEffect;
    if ((traits & MYCO_HEAT_RESISTANT) != 0u) heatMul += 0.2 * traitEffect;
    if ((traits & MYCO_HEAT_PRONE) != 0u) heatMul -= 0.2 * traitEffect;

    float lightAff = TreeExpressFactor(DecodeGene(genome, TREE_GENE_LIGHT_AFFINITY), expression);
    float metabolic = TreeExpressFactor(DecodeGene(genome, TREE_GENE_METABOLIC), expression);
    bool photosynthesizing = role == TREE_ROLE_LEAF || role == TREE_ROLE_JUVENILE;
    bool growing = InGrowthBand(state.x, moisture, genome) && light >= max(0.0, _TreeE.y);
    bool surviving = InSurvivalBand(state.x, moisture, genome);
    if (photosynthesizing)
    {
        float photo = max(0.0, _TreeA.z) * light * lightAff * saturate(phys.y) * droughtMul * heatMul * _DeltaTime;
        if (growing)
            phys.x = saturate(phys.x + photo);
    }

    float maint = max(0.0, _TreeB.y) * metabolic * _DeltaTime;
    if (light < 0.02) maint += max(0.0, _TreeB.z) * metabolic * _DeltaTime;
    phys.x = max(0.0, phys.x - maint);
    float transpiration = min(phys.y, 0.12 * _DeltaTime);
    phys.y = max(0.0, phys.y - transpiration);
    aux.x += transpiration;
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);

    if (combustion.y > 0.05)
        phys.w = saturate(phys.w - combustion.y * 1.6 * _DeltaTime);

    if (!surviving)
        phys.w = saturate(phys.w - max(0.0, _TreeB.x) * _DeltaTime);

    int height = LocalHeight(cell, topology);
    int sproutH = max(1, (int)_TreeF.x);
    int saplingH = max(sproutH + 1, (int)_TreeF.y);
    if (stage == TREE_STAGE_SPROUT && (role == TREE_ROLE_LEAF || height >= sproutH))
        stage = TREE_STAGE_SAPLING;
    if (height >= saplingH)
        stage = TREE_STAGE_TREE;
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        uint4 nTopo = TopoOf(n);
        if (!SameOwner(topology, nTopo)) continue;
        stage = max(stage, TreeStage(GenomeOf(n)));
        if (stage == TREE_STAGE_DEAD) stage = TreeStage(genome);
        stage = max(stage, TreeTopoStage(nTopo) == TREE_STAGE_DEAD ? TreeStage(genome) : TreeTopoStage(nTopo));
        if (!TreeIsLiving(TreeTopoStage(nTopo)) && TreeTopoStage(nTopo) != TREE_STAGE_EMPTY)
            continue;
        uint nStage = TreeStage(GenomeOf(n));
        if (TreeIsLiving(nStage))
            stage = max(stage, nStage);
    }

    if (stage >= TREE_STAGE_SAPLING && role == TREE_ROLE_JUVENILE)
    {
        role = TREE_ROLE_TRUNK;
        flags |= TREE_FLAG_CONVERT_WOOD;
    }

    if (role == TREE_ROLE_BRANCH && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_STEM) == 0
        && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_LEAF) == 0 && stage >= TREE_STAGE_SAPLING)
        role = TREE_ROLE_STEM;

    if (role == TREE_ROLE_STEM && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_LEAF) == 0
        && (flags & TREE_FLAG_SHED) != 0u)
    {
        role = TREE_ROLE_BRANCH;
        flags &= ~TREE_FLAG_SHED;
    }

    if (role == TREE_ROLE_LEAF)
    {
        float lifeTicks = max(1.0, _TreeI.x) * TreeLeafLifeScale(genome);
        if (timer <= 1e-4 && (flags & (TREE_FLAG_SHED | TREE_FLAG_CONVERT_DETRITUS)) == 0u)
            timer = lifeTicks;
        timer = max(0.0, timer - _DeltaTime * max(1.0, _TicksPerSecond));
        if (timer <= 0.0)
            flags |= TREE_FLAG_SHED | TREE_FLAG_CONVERT_DETRITUS;
    }

    if (phys.w <= 0.02 || phys.x <= 0.0 && !surviving)
    {
        stage = TREE_STAGE_DEAD;
        cause = combustion.y > 0.05 ? ORGANISM_CAUSE_FIRE : ORGANISM_CAUSE_DESICCATION;
        if (role == TREE_ROLE_LEAF || role == TREE_ROLE_JUVENILE)
            flags |= TREE_FLAG_CONVERT_DETRITUS;
        if (combustion.y > 0.2 && role != TREE_ROLE_ROOT)
            flags |= TREE_FLAG_CONVERT_ASH;
        genome.w = PackTreeMeta(stage, TreeGeneration(genome), TreeLineage(genome), TreeToxinDose(genome));
        topology.z = PackTreeTopologyMeta(stage, role, flags, cause);
        topology.w = asuint(max(1.0, _TreeI.y));
        LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_DEATH, TreeGeneration(genome), TreeLineage(genome), cause);
        WriteTreeState(_TreeWrite, cell, phys, topology, genome);
        return;
    }

    genome.w = PackTreeMeta(stage, TreeGeneration(genome), TreeLineage(genome), TreeToxinDose(genome));
    topology.z = PackTreeTopologyMeta(stage, role, flags, cause);
    topology.w = asuint(timer);
    WriteTreeState(_TreeWrite, cell, SanitizeTreePhysiology(phys), topology, genome);
}

[numthreads(8, 8, 1)]
void ClearGrowthClaims(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    _TreeGrowthClaimsWrite[id.xy] = TREE_CLAIM_EMPTY;
}

bool CanGrowInto(uint material, uint desiredRole)
{
    if (desiredRole == TREE_ROLE_ROOT)
        return IsTreeHabitat(material);
    return IsTreeOpen(material);
}

int2 BestRootDest(int2 cell, uint4 genome)
{
    int2 best = cell;
    float bestScore = -1.0;
    int2 candidates[5] = { int2(0, -1), int2(-1, -1), int2(1, -1), int2(-1, 0), int2(1, 0) };
    int fork = TreeRootForkBudget(genome);
    [unroll]
    for (int i = 0; i < 5; i++)
    {
        if (i >= 3 && fork <= 1) continue;
        int2 dest = cell + candidates[i];
        if (dest.y < 0 || dest.y >= _GridSize.y) continue;
        dest = C(dest);
        if (!IsTreeHabitat(M(dest))) continue;
        if (TreeIsOccupied(TopoOf(dest))) continue;
        float4 st = S(dest);
        float4 ax = A(dest);
        float score = MoistureOf(st, ax) * 1.4 + max(0.0, ax.z) * 1.2 - (float)candidates[i].y * 0.8;
        score += HashCell(dest, 19u) * 0.05;
        if (score > bestScore)
        {
            bestScore = score;
            best = dest;
        }
    }
    return best;
}

int2 WindBiasedUp(int2 cell, uint4 genome)
{
    int2 up = cell + int2(0, 1);
    if (up.y >= _GridSize.y) return cell;
    float wind = 0.0;
    int2 air = cell + int2(0, 1);
    if (air.y < _GridSize.y && IsTreeOpen(M(air)))
        wind = F(C(air)).x;
    else
        wind = F(cell).x;
    float response = TreeWindResponse(genome) * saturate(_TreeE.w);
    int lean = 0;
    if (abs(wind) * response > 0.35)
        lean = wind > 0.0 ? 1 : -1;
    int2 dest = C(cell + int2(lean, 1));
    if (dest.y >= _GridSize.y) dest = C(cell + int2(0, 1));
    return dest;
}

int2 BestLateral(int2 cell, uint4 genome, uint salt)
{
    int side = HashCell(cell, salt) < 0.5 ? -1 : 1;
    float wind = F(cell).x;
    if (abs(wind) * TreeWindResponse(genome) > 0.2)
        side = wind > 0.0 ? 1 : -1;
    int2 dest = C(cell + int2(side, 0));
    if (IsTreeOpen(M(dest)) && !TreeIsOccupied(TopoOf(dest))) return dest;
    dest = C(cell + int2(-side, 0));
    return dest;
}

int2 BestBranchDest(int2 cell, uint4 genome)
{
    int2 best = cell;
    float bestScore = -1.0;
    int2 candidates[5] = { int2(0, 1), int2(-1, 1), int2(1, 1), int2(-1, 0), int2(1, 0) };
    [unroll]
    for (int i = 0; i < 5; i++)
    {
        int2 dest = cell + candidates[i];
        if (dest.y < 0 || dest.y >= _GridSize.y) continue;
        dest = C(dest);
        if (!IsTreeOpen(M(dest)) || TreeIsOccupied(TopoOf(dest))) continue;
        float score = (float)candidates[i].y * 1.1 + abs(candidates[i].x) * 0.6 + HashCell(dest, 41u) * 0.08;
        float wind = F(dest).x;
        score += wind * (float)candidates[i].x * TreeWindResponse(genome) * 0.3;
        if (score > bestScore)
        {
            bestScore = score;
            best = dest;
        }
    }
    return best;
}

bool IsBranchSite(int2 cell, uint4 genome, uint4 topology, int height)
{
    int sproutH = max(1, (int)_TreeF.x);
    int saplingH = max(sproutH + 1, (int)_TreeF.y);
    if (height <= sproutH + 1 || height >= saplingH) return false;
    int branches = TreeSaplingBranchCount(genome, (int)_TreeI.w, (int)_TreeJ.x);
    uint salt = topology.x * 17u + (uint)height * 13u;
    float unit = Hash01(salt + (uint)_Seed * 7919u);
    int slot = (int)floor(unit * (float)max(1, saplingH - sproutH - 2));
    int site = sproutH + 2 + slot % max(1, saplingH - sproutH - 3);
    int spacing = max(2, (saplingH - sproutH) / max(1, branches));
    return ((height - sproutH - 2) % spacing) == 0 || height == site;
}

[numthreads(8, 8, 1)]
void ClaimGrowth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint4 topology = TopoOf(cell);
    if (!TreeIsOccupied(topology)) return;
    uint4 genome = GenomeOf(cell);
    uint stage = TreeStage(genome);
    if (!TreeIsLiving(stage)) return;
    uint flags = TreeFlags(topology);
    if ((flags & (TREE_FLAG_CONVERT_DETRITUS | TREE_FLAG_CONVERT_ASH | TREE_FLAG_SHED)) != 0u) return;
    float4 phys = PhysOf(cell);
    float cost = saturate(_TreeE.z);
    if (_TreeA.w <= 1e-8) return;
    if (phys.x < cost || phys.y < cost * 0.35 || phys.z < cost * 0.2) return;
    if (phys.w < 0.2) return;

    uint role = TreeRole(topology);
    int height = LocalHeight(cell, topology);
    int sproutH = max(1, (int)_TreeF.x);
    int saplingH = max(sproutH + 1, (int)_TreeF.y);
    int maxH = max(saplingH + 1, (int)_TreeF.z);
    maxH = (int)round((float)maxH * TreeMatureHeightScale(genome));
    int2 dest = cell;
    uint packedSelf = PackFaunaCell(cell, _GridSize);

    if (role == TREE_ROLE_ROOT)
    {
        int2 above = C(cell + int2(0, 1));
        uint4 aboveTopo = TopoOf(above);
        bool hasShoot = SameOwner(topology, aboveTopo)
            && (TreeRole(aboveTopo) == TREE_ROLE_JUVENILE || TreeRole(aboveTopo) == TREE_ROLE_TRUNK
                || TreeRole(aboveTopo) == TREE_ROLE_LEAF || TreeRole(aboveTopo) == TREE_ROLE_STEM);
        int2 up = WindBiasedUp(cell, genome);
        if (!hasShoot && IsTreeOpen(M(up)) && !TreeIsOccupied(TopoOf(up)))
            dest = up;
        else
            dest = BestRootDest(cell, genome);
    }
    else if (role == TREE_ROLE_JUVENILE || role == TREE_ROLE_TRUNK)
    {
        bool terminal = CountChildren(cell) == 0;
        int growCap = stage >= TREE_STAGE_TREE ? maxH : saplingH;
        if (stage == TREE_STAGE_SPROUT && height < sproutH && terminal)
            dest = WindBiasedUp(cell, genome);
        else if (height >= sproutH && terminal
            && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_LEAF) == 0
            && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_STEM) == 0)
            dest = BestLateral(cell, genome, 7u);
        else if (height < growCap && terminal)
            dest = WindBiasedUp(cell, genome);
        else if (stage >= TREE_STAGE_SAPLING && role == TREE_ROLE_TRUNK && IsBranchSite(cell, genome, topology, height)
            && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_BRANCH) + CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_STEM) < 1)
            dest = BestLateral(cell, genome, 91u);
        else if (stage == TREE_STAGE_TREE && role == TREE_ROLE_TRUNK && CountTrunkRun(cell, topology.x) < max(1, (int)_TreeF.w))
            dest = BestLateral(cell, genome, 13u);
    }
    else if (role == TREE_ROLE_BRANCH)
    {
        dest = BestBranchDest(cell, genome);
    }
    else if (role == TREE_ROLE_STEM && CountOwnedRoleNeighbors(cell, topology.x, TREE_ROLE_LEAF) == 0)
    {
        dest = BestLateral(cell, genome, 29u);
        if (!IsTreeOpen(M(dest)))
            dest = WindBiasedUp(cell, genome);
        int2 otherStem = C(dest + int2(dest.x == cell.x ? 1 : 0, 0));
        if (CountOwnedRoleNeighbors(dest, topology.x, TREE_ROLE_STEM) > 0)
            dest = cell;
    }

    if (all(dest == cell)) return;
    uint desired = TREE_ROLE_NONE;
    if (role == TREE_ROLE_ROOT) desired = dest.y > cell.y ? TREE_ROLE_JUVENILE : TREE_ROLE_ROOT;
    else if (role == TREE_ROLE_STEM) desired = TREE_ROLE_LEAF;
    else if (role == TREE_ROLE_BRANCH) desired = TREE_ROLE_BRANCH;
    else if (height >= sproutH && dest.y == cell.y) desired = TREE_ROLE_LEAF;
    else if (role == TREE_ROLE_JUVENILE) desired = TREE_ROLE_JUVENILE;
    else desired = TREE_ROLE_TRUNK;
    if (!CanGrowInto(M(dest), desired)) return;
    if (TreeIsOccupied(TopoOf(dest))) return;
    uint original;
    InterlockedMin(_TreeGrowthClaimsWrite[dest], packedSelf, original);
}

uint DesiredRoleForClaim(int2 source, int2 dest, uint4 srcTopo, uint4 srcGenome)
{
    uint role = TreeRole(srcTopo);
    uint stage = TreeStage(srcGenome);
    int height = LocalHeight(source, srcTopo);
    int sproutH = max(1, (int)_TreeF.x);
    if (role == TREE_ROLE_ROOT) return dest.y > source.y ? TREE_ROLE_JUVENILE : TREE_ROLE_ROOT;
    if (role == TREE_ROLE_STEM) return TREE_ROLE_LEAF;
    if (role == TREE_ROLE_BRANCH) return TREE_ROLE_BRANCH;
    if (height >= sproutH && dest.y == source.y) return TREE_ROLE_LEAF;
    if (role == TREE_ROLE_JUVENILE) return TREE_ROLE_JUVENILE;
    if (dest.y == source.y) return TREE_ROLE_TRUNK;
    return TREE_ROLE_TRUNK;
}

[numthreads(8, 8, 1)]
void ApplyWorld(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = Eco(cell);
    float4 combustion = Comb(cell);
    float4 life = SampleLife(_LifeGenomeRead, cell);
    uint4 genome = SampleGenome(_LifeGenomeRead, cell);
    uint4 topology = TopoOf(cell);
    uint claim = _TreeGrowthClaims[cell];

    if (claim != TREE_CLAIM_EMPTY)
    {
        int2 source = UnpackFaunaCell(claim, _GridSize);
        uint4 srcTopo = TopoOf(source);
        uint4 srcGenome = GenomeOf(source);
        if (TreeIsOccupied(srcTopo) && TreeIsLiving(TreeStage(srcGenome)))
        {
            uint desired = DesiredRoleForClaim(source, cell, srcTopo, srcGenome);
            if (CanGrowInto(M(cell), desired))
            {
                if (desired == TREE_ROLE_LEAF || desired == TREE_ROLE_JUVENILE)
                    material = TREE_LEAF_ID;
                else
                    material = TREE_WOOD_ID;
            }
        }
    }
    else if (TreeIsOccupied(topology))
    {
        uint flags = TreeFlags(topology);
        uint role = TreeRole(topology);
        uint stage = TreeStage(GenomeOf(cell));
        float leafTimer = asfloat(topology.w);
        bool expiredLeaf = role == TREE_ROLE_LEAF && leafTimer <= 0.0;
        if ((flags & TREE_FLAG_CONVERT_ASH) != 0u)
        {
            material = 12u;
            aux.z += 0.06;
        }
        else if ((flags & TREE_FLAG_CONVERT_DETRITUS) != 0u || (flags & TREE_FLAG_SHED) != 0u || expiredLeaf)
        {
            material = MATERIAL_DETRITUS;
            aux = SeedDetritusAux(aux);
        }
        else if (TreeIsLiving(stage))
        {
            if (role == TREE_ROLE_LEAF || role == TREE_ROLE_JUVENILE)
                material = TREE_LEAF_ID;
            else
                material = TREE_WOOD_ID;
        }
        else if (stage == TREE_STAGE_DEAD)
            material = TREE_WOOD_ID;
    }
    else if (IsTreeMaterial(material))
    {
        material = MATERIAL_DETRITUS;
        aux = SeedDetritusAux(aux);
    }

    WriteWorld(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void ApplyState(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    uint4 topology = TopoOf(cell);
    uint4 genome = GenomeOf(cell);
    float4 phys = PhysOf(cell);
    uint claim = _TreeGrowthClaims[cell];

    if (claim != TREE_CLAIM_EMPTY)
    {
        int2 source = UnpackFaunaCell(claim, _GridSize);
        uint4 srcTopo = TopoOf(source);
        uint4 srcGenome = GenomeOf(source);
        float4 srcPhys = PhysOf(source);
        if (TreeIsOccupied(srcTopo) && TreeIsLiving(TreeStage(srcGenome)) && IsTreeMaterial(material))
        {
            uint desired = DesiredRoleForClaim(source, cell, srcTopo, srcGenome);
            uint flags = desired == TREE_ROLE_ROOT ? TREE_FLAG_ANCHOR : 0u;
            if (desired != TREE_ROLE_ROOT) flags = 0u;
            uint stage = max(TreeStage(srcGenome), desired == TREE_ROLE_LEAF && TreeStage(srcGenome) == TREE_STAGE_SPROUT ? TREE_STAGE_SAPLING : TreeStage(srcGenome));
            uint packedOwner = srcTopo.x;
            uint packedParent = PackFaunaCell(source, _GridSize);
            uint4 childTopo = uint4(packedOwner, packedParent, PackTreeTopologyMeta(stage, desired, flags, 0u), asuint(desired == TREE_ROLE_LEAF ? max(1.0, _TreeI.x) * TreeLeafLifeScale(srcGenome) : 0.0));
            uint4 childGenome = srcGenome;
            childGenome.w = PackTreeMeta(stage, TreeGeneration(srcGenome), TreeLineage(srcGenome), TreeToxinDose(srcGenome));
            float cost = saturate(_TreeE.z);
            float4 childPhys = float4(saturate(srcPhys.x * 0.35 + 0.15), saturate(srcPhys.y * 0.5 + 0.2), saturate(srcPhys.z * 0.5 + 0.15), saturate(_TreeG.w));
            if ((TreeFlags(srcTopo) & TREE_FLAG_ANCHOR) != 0u && desired == TREE_ROLE_ROOT)
                childTopo.z = PackTreeTopologyMeta(stage, TREE_ROLE_ROOT, 0u, 0u);
            WriteTreeState(_TreeWrite, cell, childPhys, childTopo, childGenome);
            return;
        }
    }

    if (!IsTreeMaterial(material) || !TreeIsOccupied(topology))
    {
        ClearTreeState(_TreeWrite, cell);
        return;
    }

    uint flags = TreeFlags(topology) & ~(TREE_FLAG_CONVERT_WOOD | TREE_FLAG_CONVERT_DETRITUS | TREE_FLAG_CONVERT_ASH | TREE_FLAG_SHED);
    topology.z = PackTreeTopologyMeta(TreeStage(genome), TreeRole(topology), flags, TreeCause(topology));
    {
        float cost = saturate(_TreeE.z);
        bool grew = false;
        int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
        uint packedSelf = PackFaunaCell(cell, _GridSize);
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 n = cell + offsets[i];
            if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
            if (_TreeGrowthClaims[C(n)] == packedSelf)
                grew = true;
        }
        if (grew)
        {
            phys.x = max(0.0, phys.x - cost);
            phys.y = max(0.0, phys.y - cost * 0.25);
            phys.z = max(0.0, phys.z - cost * 0.15);
        }
    }
    WriteTreeState(_TreeWrite, cell, phys, topology, genome);
}

void PlantAnchor(int2 cell)
{
    uint packed = PackFaunaCell(cell, _GridSize);
    uint4 genome = RandomTreeGenome((uint2)cell, _Seed, _Tick);
    uint4 topology = uint4(packed, 0u, PackTreeTopologyMeta(TREE_STAGE_SPROUT, TREE_ROLE_ROOT, TREE_FLAG_ANCHOR, 0u), asuint(0.0));
    float4 phys = float4(saturate(_TreeG.x), saturate(_TreeG.y), saturate(_TreeG.z), saturate(_TreeG.w));
    WriteTreeState(_TreeWrite, cell, phys, topology, genome);
    LogOrganismEvent((uint)(_Tick + 1), ORGANISM_KIND_BIRTH, 0u, TreeLineage(genome), ORGANISM_CAUSE_PAINTED);
}

bool IsExposedHabitat(int2 cell, uint material)
{
    if (!IsTreeHabitat(material)) return false;
    int2 offsets[4] = { int2(0, 1), int2(-1, 0), int2(1, 0), int2(0, -1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (offsets[i].y != 0 && (n.y < 0 || n.y >= _GridSize.y)) continue;
        if (IsTreeOpen(M(C(n)))) return true;
    }
    return false;
}

[numthreads(8, 8, 1)]
void SeedTree(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    CopyTreeState(_TreeRead, _TreeWrite, cell);
    if (_TreeH.x < 0.5) return;
    if (!IsExposedHabitat(cell, M(cell))) return;
    if (TreeIsOccupied(TopoOf(cell))) return;
    if (HashCell(cell, 5u) > 0.04) return;
    PlantAnchor(cell);
}

[numthreads(8, 8, 1)]
void PaintTree(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    CopyTreeState(_TreeRead, _TreeWrite, cell);
    int radius = max(0, (int)_TreePaintCell.z);
    int2 center = int2((int)_TreePaintCell.x, (int)_TreePaintCell.y);
    int dx = abs(cell.x - center.x);
    dx = min(dx, _GridSize.x - dx);
    int dy = abs(cell.y - center.y);
    if (dx > radius || dy > radius) return;
    if (!IsTreeHabitat(M(cell))) return;
    if (TreeIsOccupied(TopoOf(cell))) return;
    PlantAnchor(cell);
}
