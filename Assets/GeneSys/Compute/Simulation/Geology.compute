#pragma kernel Volcanism
#pragma kernel EruptionMotion
#pragma kernel AshTransport
#pragma kernel CoreReaction

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherE; // vaporCapacityScale, cloudRetainMass, waterPressureResponse, latentHeatScale
float4 _ThermalA; // moistureBoost, pressureEffect, coreTemperature, coreHeatRate
float4 _EruptionA;
float4 _EruptionB;

int2 Cell(int2 value) { return ClampCell(value, _GridSize); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }
uint ReadMaterial(int2 cell) { return _MaterialRead.Load(int3(Cell(cell), 0)); }
float4 ReadState(int2 cell) { return _StateRead.Load(int3(Cell(cell), 0)); }
float2 ReadFlow(int2 cell) { return _FlowRead.Load(int3(Cell(cell), 0)); }
float4 ReadAux(int2 cell) { return _AuxRead.Load(int3(Cell(cell), 0)); }
float4 ReadEcology(int2 cell) { return _EcologyRead.Load(int3(Cell(cell), 0)); }
float4 ReadCombustion(int2 cell) { return _CombustionRead.Load(int3(Cell(cell), 0)); }
float4 ReadLife(int2 cell) { return SampleLife(_LifeGenomeRead, Cell(cell)); }
uint4 ReadGenome(int2 cell) { return SampleGenome(_LifeGenomeRead, Cell(cell)); }

bool IsGranularBurden(uint material)
{
    return IsSoftCrustMaterial(material);
}

bool IsOpenCell(uint material)
{
    float category = D(material).metadata.x;
    return material == 0u || category == 1.0;
}

float CellBurden(uint material)
{
    MaterialGpuData definition = D(material);
    return max(0.05, definition.physical.x) + definition.physical.y * 0.75 + _Erosion.z * 0.15;
}

float ColumnBurden(int2 magmaCell)
{
    float burden = 0.0;
    int depth = max(1, (int)round(_EruptionA.w));
    for (int i = 1; i <= depth; i++)
    {
        int2 probe = magmaCell + int2(0, i);
        if (probe.y >= _GridSize.y) break;
        uint above = ReadMaterial(probe);
        if (!IsGranularBurden(above)) break;
        burden += CellBurden(above);
    }
    return burden;
}

void WriteCell(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion, float4 life, uint4 genome)
{
    uint oldMaterial = ReadMaterial(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, life, genome);
}

[numthreads(8, 8, 1)]
void Volcanism(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = ReadMaterial(cell);
    float4 state = ReadState(cell);
    float2 flow = ReadFlow(cell);
    float4 aux = ReadAux(cell);
    float4 ecology = ReadEcology(cell);
    float4 combustion = ReadCombustion(cell);
    float4 life = ReadLife(cell);
    uint4 genome = ReadGenome(cell);
    float radius = Radius01(cell.y, _GridSize.y);

    bool mantle = material == 3u;
    bool magma = material == 6u;
    bool hardCrust = IsHardCrustMaterial(material);
    bool softCrust = IsSoftCrustMaterial(material);
    bool crust = hardCrust || softCrust;
    float fault = saturate(aux.w);
    float eruption = saturate(_EruptionA.x);

    if (mantle || magma)
        state.y += _Geology.x * (1.0 - radius) * _DeltaTime;

    float pressureAbove = ReadState(cell + int2(0, 1)).y;
    float pressureGradient = max(0.0, state.y - pressureAbove);
    aux.w = saturate(fault + pressureGradient * _Geology.y * _DeltaTime);

    if (mantle && fault > 0.45 && state.y > 0.35)
    {
        material = 6u;
        state.x = max(state.x, 950.0);
        state.y = max(0.0, state.y - _Geology.z * _DeltaTime);
        flow.y += _Geology.z * (1.0 - _WeatherC.w * 0.35) * _DeltaTime;
    }
    else if (crust && fault > 0.65 && pressureGradient > 0.25)
    {
        uint below = ReadMaterial(cell + int2(0, -1));
        // Soft soil/sediment use EruptionMotion when magmaEruption > 0.
        bool allowSoftIntrusion = softCrust && eruption <= 0.0001;
        if ((below == 6u || below == 3u) && (hardCrust || allowSoftIntrusion))
        {
            material = 6u;
            state.x = max(state.x, 900.0);
            state.y += _Geology.z * 0.25;
        }
    }

    if (magma)
    {
        state.x -= _Geology.w * _DeltaTime * (radius > _AtmosphereStartRadius ? 3.0 : 1.0);
        if (state.x < 780.0)
        {
            float freezeCp = EffectiveCellHeatCapacity(D(material), state, aux, D(9u).transport.y, false);
            state.x = min(780.0, state.x + MaterialPhaseLatentDelta(D(material).motion.y, _WeatherE.w, freezeCp));
            material = 5u;
            state.y *= 0.5;
            flow *= 0.25;
        }
    }

    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void EruptionMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = ReadMaterial(cell);
    float4 state = ReadState(cell);
    float2 flow = ReadFlow(cell);
    float4 aux = ReadAux(cell);
    float4 ecology = ReadEcology(cell);
    float4 combustion = ReadCombustion(cell);
    float4 life = ReadLife(cell);
    uint4 genome = ReadGenome(cell);

    float eruption = saturate(_EruptionA.x);
    if (eruption <= 0.0001)
    {
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    // Destination side: granular cell claiming magma from below.
    if (IsGranularBurden(material) && cell.y > 0)
    {
        int2 below = cell + int2(0, -1);
        uint belowMat = ReadMaterial(below);
        if (belowMat == 6u)
        {
            float4 belowState = ReadState(below);
            float2 belowFlow = ReadFlow(below);
            float pressureGradient = max(0.0, belowState.y - state.y);
            float viscosityFactor = max(0.15, 1.0 - _WeatherC.w * 0.35);
            float drive = (pressureGradient * _EruptionA.y + max(0.0, belowFlow.y) * _EruptionA.z + _Geology.z * 0.35)
                * viscosityFactor * eruption;

            float burden = ColumnBurden(below);
            float resistance = max(0.02, burden * lerp(1.0, 0.02, eruption));
            float overdrive = drive / max(0.02, resistance);

            if (overdrive > 1.0)
            {
                float4 belowAux = ReadAux(below);
                float4 belowEcology = ReadEcology(below);
                float4 belowCombustion = ReadCombustion(below);
                float4 belowLife = ReadLife(below);
                uint4 belowGenome = ReadGenome(below);
                bool blast = overdrive >= max(0.05, _EruptionB.x);
                material = 6u;
                state = belowState;
                flow = belowFlow;
                aux = belowAux;
                ecology = belowEcology;
                combustion = belowCombustion;
                life = belowLife;
                genome = belowGenome;
                state.y = max(0.0, state.y - resistance * 0.35);
                if (blast)
                    flow.y += overdrive * 0.5 * _DeltaTime;
                WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
                return;
            }
        }
    }

    // Source side: magma being displaced upward into soft overburden.
    if (material == 6u && cell.y < _GridSize.y - 1)
    {
        int2 above = cell + int2(0, 1);
        uint aboveMat = ReadMaterial(above);
        if (IsGranularBurden(aboveMat))
        {
            float4 aboveState = ReadState(above);
            float2 aboveFlow = ReadFlow(above);
            float4 aboveAux = ReadAux(above);
            float4 aboveEcology = ReadEcology(above);
            float4 aboveCombustion = ReadCombustion(above);
            float4 aboveLife = ReadLife(above);
            uint4 aboveGenome = ReadGenome(above);
            float pressureGradient = max(0.0, state.y - aboveState.y);
            float viscosityFactor = max(0.15, 1.0 - _WeatherC.w * 0.35);
            float drive = (pressureGradient * _EruptionA.y + max(0.0, flow.y) * _EruptionA.z + _Geology.z * 0.35)
                * viscosityFactor * eruption;
            float burden = ColumnBurden(cell);
            float resistance = max(0.02, burden * lerp(1.0, 0.02, eruption));
            float overdrive = drive / max(0.02, resistance);

            if (overdrive > 1.0)
            {
                bool blast = overdrive >= max(0.05, _EruptionB.x);
                if (blast)
                {
                    material = 12u;
                    state.x = max(state.x, aboveState.x * 0.35 + 250.0);
                    state.y = aboveState.y * 0.35;
                    state.z = aboveState.z;
                    state.w = aboveState.w;
                    flow = aboveFlow;
                    flow.y += overdrive * 1.25;
                    aux = aboveAux;
                    aux.z = max(aux.z, 0.15 * _EruptionB.w);
                    ecology = aboveEcology;
                    combustion = aboveCombustion;
                    life = aboveLife;
                    genome = aboveGenome;
                }
                else
                {
                    material = aboveMat;
                    state = aboveState;
                    flow = aboveFlow;
                    aux = aboveAux;
                    ecology = aboveEcology;
                    combustion = aboveCombustion;
                    life = aboveLife;
                    genome = aboveGenome;
                }
                WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
                return;
            }
        }
    }

    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

int2 AshDestination(int2 source)
{
    uint sourceMaterial = ReadMaterial(source);
    if (sourceMaterial != 12u) return source;

    float4 state = ReadState(source);
    float2 flow = ReadFlow(source);
    MaterialGpuData definition = D(sourceMaterial);
    float buoyancy = saturate(definition.biology.w);
    float density = max(0.05, definition.physical.x);
    float lift = max(0.0, flow.y) * _EruptionB.y + max(0.0, state.x - 80.0) * 0.004 * buoyancy;
    float settle = _EruptionB.z * density * (1.0 - buoyancy * 0.65);
    float net = lift - settle;

    int direction = ((source.x + _Tick) & 1) == 0 ? -1 : 1;
    if (abs(flow.x) > 0.15)
        direction = flow.x > 0.0 ? 1 : -1;

    if (net > 0.08)
    {
        int2 up = ClampCell(source + int2(0, 1), _GridSize);
        if (IsOpenCell(ReadMaterial(up))) return up;
        int2 diagonalUp = ClampCell(source + int2(direction, 1), _GridSize);
        if (IsOpenCell(ReadMaterial(diagonalUp))) return diagonalUp;
        int2 side = ClampCell(source + int2(direction, 0), _GridSize);
        if (IsOpenCell(ReadMaterial(side))) return side;
        return source;
    }

    if (net < -0.02 || settle > lift + 0.001)
    {
        int2 below = ClampCell(source + int2(0, -1), _GridSize);
        if (IsOpenCell(ReadMaterial(below))) return below;
        int2 diagonal = ClampCell(source + int2(direction, -1), _GridSize);
        if (IsOpenCell(ReadMaterial(diagonal))) return diagonal;
        return source;
    }

    // Near equilibrium: only drift when wind is meaningful.
    if (abs(flow.x) > 0.25)
    {
        int2 drift = ClampCell(source + int2(direction, 0), _GridSize);
        if (IsOpenCell(ReadMaterial(drift))) return drift;
    }
    return source;
}

int2 AshMovementWinner(int2 target)
{
    int2 candidates[8] = {
        ClampCell(target + int2(0, -1), _GridSize),
        ClampCell(target + int2(-1, -1), _GridSize),
        ClampCell(target + int2(1, -1), _GridSize),
        ClampCell(target + int2(-1, 0), _GridSize),
        ClampCell(target + int2(1, 0), _GridSize),
        ClampCell(target + int2(0, 1), _GridSize),
        ClampCell(target + int2(-1, 1), _GridSize),
        ClampCell(target + int2(1, 1), _GridSize)
    };
    [unroll]
    for (int i = 0; i < 8; i++)
    {
        int2 candidate = candidates[i];
        if (ReadMaterial(candidate) == 12u && all(AshDestination(candidate) == target))
            return candidate;
    }
    return target;
}

bool AshMoveWins(int2 source, int2 target)
{
    return all(AshMovementWinner(target) == source);
}

[numthreads(8, 8, 1)]
void AshTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = ReadMaterial(cell);
    float4 state = ReadState(cell);
    float2 flow = ReadFlow(cell);
    float4 aux = ReadAux(cell);
    float4 ecology = ReadEcology(cell);
    float4 combustion = ReadCombustion(cell);
    float4 life = ReadLife(cell);
    uint4 genome = ReadGenome(cell);

    int2 destination = AshDestination(cell);
    if (material == 12u && !all(destination == cell) && AshMoveWins(cell, destination))
    {
        material = ReadMaterial(destination);
        state = ReadState(destination);
        flow = ReadFlow(destination);
        aux = ReadAux(destination);
        ecology = ReadEcology(destination);
        combustion = ReadCombustion(destination);
        life = ReadLife(destination);
        genome = ReadGenome(destination);
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    if (IsOpenCell(material))
    {
        int2 source = AshMovementWinner(cell);
        if (!all(source == cell))
        {
            material = ReadMaterial(source);
            state = ReadState(source);
            flow = ReadFlow(source);
            aux = ReadAux(source);
            ecology = ReadEcology(source);
            combustion = ReadCombustion(source);
            life = ReadLife(source);
            genome = ReadGenome(source);
            WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
            return;
        }
    }

    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void CoreReaction(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = ReadMaterial(cell);
    float4 state = ReadState(cell);
    float2 flow = ReadFlow(cell);
    float4 aux = ReadAux(cell);
    float4 ecology = ReadEcology(cell);
    float4 combustion = ReadCombustion(cell);
    float4 life = ReadLife(cell);
    uint4 genome = ReadGenome(cell);

    if (material == 2u)
    {
        float target = _ThermalA.z > 0.0 ? _ThermalA.z : 1500.0;
        float rate = max(0.0, _ThermalA.w);
        if (rate > 0.0)
            state.x += (target - state.x) * saturate(rate * _DeltaTime);

        int freq = max(0, (int)_GeologyB.z);
        float magnitude = max(0.0, _GeologyB.w);
        if (freq > 0 && magnitude > 0.0 && (_Tick % freq) == 0)
            state.x += magnitude;
    }

    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}
