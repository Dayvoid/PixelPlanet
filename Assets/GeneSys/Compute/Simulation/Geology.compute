#pragma kernel Volcanism

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<float4> _WaterRead;
RWTexture2D<float4> _WaterWrite;
RWTexture2D<float4> _Hydrostatic;
RWTexture2D<int> _MotionIntent;
RWTexture2D<float4> _WaterFlux;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _Phase;
float4 _Pressure;

int2 Cell(int2 value) { return ClampCell(value, _GridSize); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

void WriteCell(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 water)
{
    state.z = 0.0;
    aux.x = 0.0;
    aux.y = 0.0;
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _WaterWrite[cell] = SafeFinite4(max(water, 0.0), 0.0);
}

[numthreads(8, 8, 1)]
void Volcanism(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = _MaterialRead.Load(int3(cell, 0));
    float4 state = _StateRead.Load(int3(cell, 0));
    float2 flow = _FlowRead.Load(int3(cell, 0));
    float4 aux = _AuxRead.Load(int3(cell, 0));
    float4 water = _WaterRead.Load(int3(cell, 0));
    float radius = Radius01(cell.y, _GridSize.y);
    bool mantle = material == 3u;
    bool magma = material == 6u;
    float fault = saturate(aux.w);
    float hydro = _Hydrostatic[Cell(cell)].x;

    if (mantle || magma)
        state.y = min(_Pressure.w, state.y + _Geology.x * (1.0 - radius) * _DeltaTime * 0.35);

    float pressureAbove = 0.0;
    int2 above = NeighborCell(cell, int2(0, 1), _GridSize);
    if (InRadialBounds(above.y, _GridSize.y))
    {
        float4 aboveState = _StateRead.Load(int3(above, 0));
        pressureAbove = _Hydrostatic[above].x + max(0.0, aboveState.y);
    }
    float totalP = hydro + max(0.0, state.y);
    float pressureGradient = max(0.0, totalP - pressureAbove);
    aux.w = saturate(fault + pressureGradient * _Geology.y * _DeltaTime - _GeologyB.z * _DeltaTime);

    if (magma)
    {
        float cooling = _Geology.w * _DeltaTime * (radius > _AtmosphereStartRadius ? 3.0 : 1.0);
        if (InRadialBounds(above.y, _GridSize.y))
        {
            float4 aboveWater = _WaterRead.Load(int3(above, 0));
            cooling += min(WaterTotal(aboveWater), _GeologyB.x * _DeltaTime) * 12.0;
        }
        state.x = max(200.0, state.x - cooling);
        flow.y += _Geology.z * max(0.0, state.y) * (1.0 - _WeatherC.w * 0.35) * _DeltaTime;
    }

    WriteCell(cell, material, state, flow, aux, water);
}
