#pragma kernel LightAttenuation
#pragma kernel SporeTransport
#pragma kernel Photosynthesis
#pragma kernel FloraLifecycle
#pragma kernel SeedFlora
#pragma kernel FloraMigration
#pragma target 5.1

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
Texture2D<float> _LightRead;
RWTexture2D<float> _LightWrite;
Texture2DArray<float4> _GrassRead;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _WeatherA; // solarIntensity, ...
float4 _WeatherC; // vaporPressureScale, solarAngle01, ...
float4 _WeatherE; // saturationCapacityScale, cloudPrecipitationThreshold, rainPixelFormationThreshold, surfaceWaterPixelThreshold
float4 _WeatherF; // ..., atmosphericCflLimit
float4 _FloraA; // airTransport, waterTransport, diffusion, settling
float4 _FloraB; // sporulation, growth, decay, photosynthesis
float4 _FloraC; // oxygenYield, exudation, reproductionThreshold, baseMutationRate
float4 _FloraD; // toxinMutationScale, geneExpressionRange, growthTempMin, growthTempMax
float4 _FloraE; // growthMoistureMin, growthMoistureMax, survivalTempMin, survivalTempMax
float4 _FloraF; // survivalMoistureMin, survivalMoistureMax, minLight, germinationSporeThreshold
float4 _FloraG; // maintenanceRate, nightDrain, dormancyMetabolicScale, initialSporeLoad
float4 _FloraH; // seedAtWorldgen, anchorGrip, unused, unused
float4 _GrassH; // nectarRate, seedAtWorldgen, geneExpressionRange, canopyOpacity
float4 _FloraI; // poleDriftRate, windShearRate, rainShearRate, fragmentYield

int2 C(int2 value) { return ClampCell(value, _GridSize); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
float4 Eco(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
float4 L(int2 value) { return SampleLife(_LifeGenomeRead, C(value)); }
uint4 G(int2 value) { return SampleGenome(_LifeGenomeRead, C(value)); }
float LightOf(int2 value) { return _LightRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

void Write(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion, float4 life, uint4 genome)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, life, genome);
}

void CopyCell(int2 cell, out uint material, out float4 state, out float2 flow, out float4 aux, out float4 ecology, out float4 combustion, out float4 life, out uint4 genome)
{
    material = M(cell);
    state = S(cell);
    flow = F(cell);
    aux = A(cell);
    ecology = Eco(cell);
    combustion = Comb(cell);
    life = L(cell);
    genome = G(cell);
}

float MoistureOf(float4 state, float4 aux)
{
    return max(0.0, state.z) + max(0.0, aux.y);
}

bool SameCarrierClass(uint a, uint b)
{
    return (IsSporeAirCarrier(a) && IsSporeAirCarrier(b)) || (IsSporeWaterCarrier(a) && IsSporeWaterCarrier(b));
}

bool IsDepositTargetFor(uint carrier, uint target)
{
    if (IsSporeAirCarrier(carrier))
        return IsFloraSporeDepositTarget(target) || IsSporeWaterCarrier(target);
    if (IsSporeWaterCarrier(carrier))
        return IsFloraSporeDepositTarget(target);
    return false;
}

int CountDepositTargets(int2 cell, uint material)
{
    int count = 0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }
        if (IsDepositTargetFor(material, M(cell + offset))) count++;
    }
    return count;
}

int CountCarrierNeighbors(int2 cell)
{
    int count = 0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }
        if (IsSporeCarrier(M(cell + offset))) count++;
    }
    return count;
}

float4 CarrierFaceMask(int2 cell, uint material)
{
    int2 leftCell = C(cell + int2(-1, 0));
    int2 rightCell = C(cell + int2(1, 0));
    int2 downCell = C(cell + int2(0, -1));
    int2 upCell = C(cell + int2(0, 1));
    return float4(
        SameCarrierClass(material, M(leftCell)) ? 1.0 : 0.0,
        SameCarrierClass(material, M(rightCell)) ? 1.0 : 0.0,
        (cell.y > 0 && SameCarrierClass(material, M(downCell))) ? 1.0 : 0.0,
        (cell.y < _GridSize.y - 1 && SameCarrierClass(material, M(upCell))) ? 1.0 : 0.0);
}

float4 SporeFaceFlux(float2 flow, float mass, float advectionRate, float4 validFaces, float tangentialWeight)
{
    if (mass <= 1e-8 || advectionRate <= 1e-8)
        return 0.0;
    float left = max(0.0, -flow.x) * validFaces.x * tangentialWeight;
    float right = max(0.0, flow.x) * validFaces.y * tangentialWeight;
    float down = max(0.0, -flow.y) * validFaces.z;
    float up = max(0.0, flow.y) * validFaces.w;
    float weightSum = left + right + down + up;
    if (weightSum <= 1e-8)
        return 0.0;
    float cfl = saturate(_WeatherF.w);
    if (cfl <= 1e-8) cfl = 0.4;
    float moveFraction = min(cfl, weightSum * advectionRate * _DeltaTime);
    float movable = mass * moveFraction;
    float inv = 1.0 / weightSum;
    return float4(movable * left * inv, movable * right * inv, movable * down * inv, movable * up * inv);
}

float DiffusiveExchange(float selfMass, float neighborMass, float diffusionRate)
{
    return (neighborMass - selfMass) * saturate(diffusionRate * _DeltaTime) * 0.25;
}

bool HasAnchorNeighbor(int2 cell)
{
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }
        if (IsFloraAnchor(M(cell + offset))) return true;
    }
    return false;
}

void FloraRanges(uint4 genome,
    inout float growTMin, inout float growTMax, inout float growMMin, inout float growMMax,
    inout float survTMin, inout float survTMax, inout float survMMin, inout float survMMax)
{
    float expression = saturate(_FloraD.y);
    float tShift = FloraExpressShift(DecodeGene(genome, FLORA_GENE_TEMP_OPTIMUM), 18.0 * expression);
    float tWidth = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_TEMP_TOLERANCE), expression);
    float mShift = FloraExpressShift(DecodeGene(genome, FLORA_GENE_MOISTURE_OPTIMUM), 0.25 * expression);
    float mWidth = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_MOISTURE_TOLERANCE), expression);

    float tMid = 0.5 * (growTMin + growTMax) + tShift;
    float tHalf = max(1.0, 0.5 * (growTMax - growTMin) * tWidth);
    growTMin = tMid - tHalf;
    growTMax = tMid + tHalf;

    float sMid = 0.5 * (survTMin + survTMax) + tShift;
    float sHalf = max(2.0, 0.5 * (survTMax - survTMin) * tWidth);
    survTMin = sMid - sHalf;
    survTMax = sMid + sHalf;

    float mMid = 0.5 * (growMMin + growMMax) + mShift;
    float mHalf = max(0.02, 0.5 * (growMMax - growMMin) * mWidth);
    growMMin = max(0.0, mMid - mHalf);
    growMMax = mMid + mHalf;

    float smMid = 0.5 * (survMMin + survMMax) + mShift;
    float smHalf = max(0.02, 0.5 * (survMMax - survMMin) * mWidth);
    survMMin = max(0.0, smMid - smHalf);
    survMMax = smMid + smHalf;
}

uint4 MutateFloraGenome(uint4 genome, uint2 cell)
{
    float toxin = FloraToxinDose(genome) / 255.0;
    float mutGene = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_MUTATION), 1.0);
    float rate = max(0.0, _FloraC.w) * (1.0 + toxin * max(0.0, _FloraD.x)) * mutGene;
    [unroll]
    for (uint i = 0u; i < 12u; i++)
    {
        uint gene = DecodeGene(genome, i);
        float h = Hash01(cell.x * 73856093u + cell.y * 19349663u + i * 83492791u + (uint)_Seed * 31337u + (uint)_Tick * 6151u);
        int step = (int)round((h * 2.0 - 1.0) * rate * 255.0);
        EncodeGene(genome, i, (uint)clamp((int)gene + step, 0, 255));
    }
    return genome;
}

void SampleShear(int2 cell, out float wind, out float rain, out int windDir)
{
    wind = F(cell).x;
    rain = 0.0;
    windDir = 0;
    float bestAbs = abs(wind);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }
        int2 neighbor = C(cell + offset);
        if (!IsSporeCarrier(M(neighbor))) continue;
        float wx = F(neighbor).x;
        float mag = abs(wx);
        if (mag > bestAbs)
        {
            bestAbs = mag;
            wind = wx;
        }
    }
    windDir = wind > 1e-6 ? 1 : (wind < -1e-6 ? -1 : 0);

    if (cell.y < _GridSize.y - 1)
    {
        int2 above = cell + int2(0, 1);
        uint aboveMat = M(above);
        if (IsSporeAirCarrier(aboveMat))
            rain = max(0.0, S(above).z - max(0.01, _WeatherE.y));
        else if (aboveMat == 9u || aboveMat == 10u)
            rain = 0.5;
    }
}

float FloraShearUrge(int2 cell)
{
    float wind;
    float rain;
    int windDir;
    SampleShear(cell, wind, rain, windDir);
    float shear = abs(wind) * max(0.0, _FloraI.y) + rain * max(0.0, _FloraI.z);
    float grip = saturate(L(cell).y) * max(0.0, _FloraH.y);
    return max(0.0, shear - grip);
}

float FloraFragmentAmount(int2 cell)
{
    if (!IsFloraMaterial(M(cell))) return 0.0;
    float yield = max(0.0, _FloraI.w);
    if (yield <= 1e-8) return 0.0;
    return min(saturate(L(cell).y), FloraShearUrge(cell) * yield * _DeltaTime);
}

int2 FloraDriftDestination(int2 cell)
{
    if (!IsFloraMaterial(M(cell))) return cell;

    float poleUrge = 0.0;
    int poleStep = 0;
    bool stacked = cell.y > 0 && IsFloraMaterial(M(cell + int2(0, -1)));
    if (stacked)
    {
        poleUrge = FloraPoleDrift(G(cell)) * max(0.0, _FloraI.x);
        poleStep = NearestPoleStep(cell.x, _GridSize.x, _Seed);
        if (poleStep == 0 && poleUrge > 1e-8)
            poleStep = ((cell.x + _Tick) & 1) == 0 ? -1 : 1;
    }

    float shearUrge = 0.0;
    int shearStep = 0;
    bool isCrest = cell.y >= _GridSize.y - 1 || !IsFloraMaterial(M(cell + int2(0, 1)));
    if (isCrest)
    {
        float wind;
        float rain;
        int windDir;
        SampleShear(cell, wind, rain, windDir);
        shearUrge = FloraShearUrge(cell);
        shearStep = windDir;
        if (shearStep == 0 && shearUrge > 1e-8)
            shearStep = poleStep != 0 ? poleStep : (((cell.x + _Tick) & 1) == 0 ? -1 : 1);
    }

    float signedUrge = (float)poleStep * poleUrge + (float)shearStep * shearUrge;
    int step = signedUrge > 0.0 ? 1 : (signedUrge < 0.0 ? -1 : 0);
    float urge = abs(signedUrge);
    if (step == 0 || urge <= 1e-8) return cell;

    float h = Hash01(cell.x * 73856093u + cell.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 31337u);
    if (h >= saturate(urge * _DeltaTime)) return cell;

    int2 dest = C(cell + int2(step, 0));
    if (IsFloraMaterial(M(dest))) return cell;
    if (!IsFloraGerminationTarget(M(dest))) return cell;
    return dest;
}

bool FloraDriftWins(int2 source, int2 target)
{
    int2 left = C(target + int2(-1, 0));
    int2 right = C(target + int2(1, 0));
    if (all(FloraDriftDestination(left) == target)) return all(source == left);
    if (all(FloraDriftDestination(right) == target)) return all(source == right);
    return false;
}

int2 DivisionOffset()
{
    uint h = Hash((uint)_Tick * 747796405u + 2891336453u);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    return offsets[h & 3u];
}

bool WillDivideInto(int2 parentCell, int2 childCell)
{
    if (childCell.y < 0 || childCell.y >= _GridSize.y) return false;
    parentCell = C(parentCell);
    childCell = C(childCell);
    uint parentMat = M(parentCell);
    uint childMat = M(childCell);
    if (!IsFloraMaterial(parentMat) || IsFloraMaterial(childMat)) return false;
    if (!IsFloraGerminationTarget(childMat)) return false;
    if (IsFloraOpenHabitat(childMat) && !HasAnchorNeighbor(childCell) && !IsFloraMaterial(parentMat))
        return false;
    uint4 parentGenome = G(parentCell);
    if (FloraStage(parentGenome) != FLORA_STAGE_ACTIVE) return false;
    float4 parentLife = L(parentCell);
    float expression = saturate(_FloraD.y);
    float threshold = max(0.15, saturate(_FloraC.z) * FloraExpressFactor(DecodeGene(parentGenome, FLORA_GENE_REPRODUCTION), expression));
    return parentLife.z >= threshold && parentLife.y >= 0.12;
}

[numthreads(64, 1, 1)]
void LightAttenuation(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int theta = (int)id.x;
    float theta01 = (theta + 0.5) / _GridSize.x;
    float angle = (theta01 - _WeatherC.y) * 6.28318530718;
    float light = max(0.0, cos(angle)) * max(0.0, _WeatherA.x);

    for (int r = _GridSize.y - 1; r >= 0; r--)
    {
        int2 cell = int2(theta, r);
        _LightWrite[cell] = light;

        uint material = M(cell);
        float4 state = S(cell);
        float4 combustion = Comb(cell);
        MaterialGpuData definition = D(material);
        float category = definition.metadata.x;
        float opacity = 0.0;
        bool atmosphere = category == 1.0 || material == 1u || material == 11u
            || (material == 0u && Radius01(r, _GridSize.y) >= _AtmosphereStartRadius);
        if (atmosphere)
        {
            opacity += saturate(state.z) * 0.35;
            opacity += saturate(combustion.z) * 0.4;
        }
        else if (material == 9u || material == 10u)
        {
            opacity += 0.18 + saturate(state.z) * 0.12;
        }
        else if (IsFloraMaterial(material))
        {
            opacity += 0.08 + saturate(L(cell).y) * 0.12;
        }
        else if (category >= 3.0)
        {
            opacity += lerp(0.55, 0.95, 1.0 - saturate(definition.biology.z));
            if (IsGrassAnchor(material))
                opacity += saturate(GrassTotalBiomass(_GrassRead, cell) * saturate(_GrassH.w));
        }
        else if (category == 2.0)
        {
            opacity += 0.18;
        }
        light *= saturate(1.0 - opacity);
    }
}

[numthreads(8, 8, 1)]
void SporeTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = Eco(cell);
    float4 combustion = Comb(cell);
    float4 life = L(cell);
    uint4 genome = G(cell);
    float spores = max(0.0, life.x);
    float airRate = max(0.0, _FloraA.x);
    float waterRate = max(0.0, _FloraA.y);
    float diffusionRate = max(0.0, _FloraA.z);
    float settlingRate = max(0.0, _FloraA.w);
    float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);

    float remaining = spores;
    float incoming = 0.0;
    float bestMass = 0.0;
    uint4 bestGenome = genome;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

    if (IsSporeCarrier(material))
    {
        float advectionRate = IsSporeWaterCarrier(material) ? waterRate : airRate;
        float4 validFaces = CarrierFaceMask(cell, material);
        float4 outFlux = SporeFaceFlux(flow, spores, advectionRate, validFaces, tanW);
        float sporeOut = outFlux.x + outFlux.y + outFlux.z + outFlux.w;
        remaining = max(0.0, spores - sporeOut);
        ConsiderGenomeContribution(bestMass, bestGenome, remaining, genome);

        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 offset = offsets[i];
            if (offset.y != 0)
            {
                int neighborY = cell.y + offset.y;
                if (neighborY < 0 || neighborY >= _GridSize.y) continue;
            }
            int2 neighbor = C(cell + offset);
            uint neighborMaterial = M(neighbor);
            float4 neighborLife = L(neighbor);
            uint4 neighborGenome = G(neighbor);
            if (SameCarrierClass(material, neighborMaterial))
            {
                float neighborTan = TangentialEdgeWeight(neighbor.y, _GridSize.y);
                float4 neighborValid = CarrierFaceMask(neighbor, neighborMaterial);
                float4 neighborOut = SporeFaceFlux(F(neighbor), max(0.0, neighborLife.x), advectionRate, neighborValid, neighborTan);
                float face = 0.0;
                if (offset.x == 1) face = neighborOut.x;
                else if (offset.x == -1) face = neighborOut.y;
                else if (offset.y == 1) face = neighborOut.z;
                else if (offset.y == -1) face = neighborOut.w;
                incoming += face;
                ConsiderGenomeContribution(bestMass, bestGenome, face, neighborGenome);
                float exchange = DiffusiveExchange(spores, max(0.0, neighborLife.x), diffusionRate);
                incoming += exchange;
                if (exchange > 0.0)
                    ConsiderGenomeContribution(bestMass, bestGenome, exchange, neighborGenome);
            }
        }

        int depositTargets = CountDepositTargets(cell, material);
        if (depositTargets > 0 && settlingRate > 0.0)
            remaining = max(0.0, remaining - remaining * saturate(settlingRate * _DeltaTime));

        if (IsSporeWaterCarrier(material))
        {
            [unroll]
            for (int i = 0; i < 4; i++)
            {
                int2 offset = offsets[i];
                if (offset.y != 0)
                {
                    int neighborY = cell.y + offset.y;
                    if (neighborY < 0 || neighborY >= _GridSize.y) continue;
                }
                int2 neighbor = C(cell + offset);
                uint neighborMaterial = M(neighbor);
                if (!IsSporeAirCarrier(neighborMaterial)) continue;
                int neighborTargets = CountDepositTargets(neighbor, neighborMaterial);
                if (neighborTargets <= 0) continue;
                float deposit = max(0.0, L(neighbor).x) * saturate(settlingRate * _DeltaTime) / (float)neighborTargets;
                incoming += deposit;
                ConsiderGenomeContribution(bestMass, bestGenome, deposit, G(neighbor));
            }
        }
    }
    else if (IsFloraSporeDepositTarget(material))
    {
        ConsiderGenomeContribution(bestMass, bestGenome, spores, genome);
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 offset = offsets[i];
            if (offset.y != 0)
            {
                int neighborY = cell.y + offset.y;
                if (neighborY < 0 || neighborY >= _GridSize.y) continue;
            }
            int2 neighbor = C(cell + offset);
            uint neighborMaterial = M(neighbor);
            if (!IsDepositTargetFor(neighborMaterial, material)) continue;
            int neighborTargets = CountDepositTargets(neighbor, neighborMaterial);
            if (neighborTargets <= 0) continue;
            float deposit = max(0.0, L(neighbor).x) * saturate(settlingRate * _DeltaTime) / (float)neighborTargets;
            incoming += deposit;
            ConsiderGenomeContribution(bestMass, bestGenome, deposit, G(neighbor));
        }
    }
    else
    {
        ConsiderGenomeContribution(bestMass, bestGenome, spores, genome);
    }

    life.x = max(0.0, remaining + incoming);
    if (life.x > 1e-6 && !IsFloraMaterial(material))
        genome = bestGenome;
    else if (life.x <= 1e-6 && !IsFloraMaterial(material) && life.y <= 1e-6)
        genome = 0;

    Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void Photosynthesis(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = Eco(cell);
    float4 combustion = Comb(cell);
    float4 life = L(cell);
    uint4 genome = G(cell);
    float light = max(0.0, LightOf(cell));
    float expression = saturate(_FloraD.y);

    if (IsFloraMaterial(material) && FloraStage(genome) == FLORA_STAGE_ACTIVE)
    {
        float growTMin = _FloraD.z;
        float growTMax = _FloraD.w;
        float growMMin = _FloraE.x;
        float growMMax = _FloraE.y;
        float survTMin = _FloraE.z;
        float survTMax = _FloraE.w;
        float survMMin = _FloraF.x;
        float survMMax = _FloraF.y;
        FloraRanges(genome, growTMin, growTMax, growMMin, growMMax, survTMin, survTMax, survMMin, survMMax);
        float temperature = state.x;
        float moisture = MoistureOf(state, aux);
        bool inGrowth = temperature >= growTMin && temperature <= growTMax && moisture >= growMMin && moisture <= growMMax;
        float lightAffinity = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_LIGHT_AFFINITY), expression);
        float metabolic = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_METABOLIC), expression);
        float photo = max(0.0, _FloraB.w) * light * lightAffinity;
        float maintain = max(0.0, _FloraG.x) * metabolic;
        float dark = light < max(0.001, _FloraF.z) ? max(0.0, _FloraG.y) * metabolic : 0.0;
        if (inGrowth)
            life.z = saturate(life.z + (photo - maintain) * _DeltaTime);
        else
            life.z = saturate(life.z - (maintain * 0.35 + dark) * _DeltaTime);
        life.z = saturate(life.z - dark * _DeltaTime);

        float exudation = max(0.0, _FloraC.y) * FloraExpressFactor(DecodeGene(genome, FLORA_GENE_EXUDATION), expression);
        float emit = exudation * saturate(life.y) * max(light, 0.05) * _DeltaTime;
        life.w = max(0.0, life.w + emit);
        aux.z = max(0.0, aux.z + emit * 0.15);

        float oxygen = max(0.0, _FloraC.x) * saturate(life.y) * light * lightAffinity * _DeltaTime;
        float capacity = OxygenCapacity(material, D(material));
        combustion.x = min(capacity, combustion.x + oxygen);
    }
    else if (IsFloraMaterial(material) && FloraStage(genome) == FLORA_STAGE_DORMANT)
    {
        float metabolic = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_METABOLIC), expression);
        life.z = saturate(life.z - max(0.0, _FloraG.x) * max(0.0, _FloraG.z) * metabolic * _DeltaTime);
    }

    Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void FloraLifecycle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = Eco(cell);
    float4 combustion = Comb(cell);
    float4 life = L(cell);
    uint4 genome = G(cell);
    float light = max(0.0, LightOf(cell));
    float expression = saturate(_FloraD.y);
    float growthRate = max(0.0, _FloraB.y);
    float decayRate = max(0.0, _FloraB.z);
    float sporulationRate = max(0.0, _FloraB.x);
    float germThreshold = max(0.01, _FloraF.w);
    float minLight = max(0.0, _FloraF.z);

    float growTMin = _FloraD.z;
    float growTMax = _FloraD.w;
    float growMMin = _FloraE.x;
    float growMMax = _FloraE.y;
    float survTMin = _FloraE.z;
    float survTMax = _FloraE.w;
    float survMMin = _FloraF.x;
    float survMMax = _FloraF.y;
    FloraRanges(genome, growTMin, growTMax, growMMin, growMMax, survTMin, survTMax, survMMin, survMMax);

    float temperature = state.x;
    float moisture = MoistureOf(state, aux);
    bool inGrowth = temperature >= growTMin && temperature <= growTMax && moisture >= growMMin && moisture <= growMMax;
    bool inSurvival = temperature >= survTMin && temperature <= survTMax && moisture >= survMMin && moisture <= survMMax;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

    float exudateIn = 0.0;
    [unroll]
    for (int e = 0; e < 4; e++)
    {
        int2 offset = offsets[e];
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }
        exudateIn += (L(cell + offset).w - life.w) * 0.15 * saturate(0.4 * _DeltaTime);
    }
    life.w = max(0.0, life.w + exudateIn);
    aux.z = max(0.0, aux.z + max(0.0, life.w) * 0.02 * _DeltaTime);
    life.w = max(0.0, life.w - life.w * 0.08 * _DeltaTime);

    if (IsSporeCarrier(material) && !IsFloraMaterial(material))
    {
        float incoming = 0.0;
        float bestMass = life.x;
        uint4 bestGenome = genome;
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 offset = offsets[i];
            if (offset.y != 0)
            {
                int neighborY = cell.y + offset.y;
                if (neighborY < 0 || neighborY >= _GridSize.y) continue;
            }
            int2 neighbor = C(cell + offset);
            if (!IsFloraMaterial(M(neighbor))) continue;
            float4 neighborLife = L(neighbor);
            if (neighborLife.y <= 0.05) continue;
            int carriers = max(1, CountCarrierNeighbors(neighbor));
            float emit = neighborLife.y * sporulationRate * _DeltaTime / (float)carriers;
            incoming += emit;
            ConsiderGenomeContribution(bestMass, bestGenome, emit, G(neighbor));
        }
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 offset = offsets[i];
            if (offset.y != 0)
            {
                int neighborY = cell.y + offset.y;
                if (neighborY < 0 || neighborY >= _GridSize.y) continue;
            }
            int2 neighbor = C(cell + offset);
            float frag = FloraFragmentAmount(neighbor);
            if (frag <= 1e-8) continue;
            int carriers = max(1, CountCarrierNeighbors(neighbor));
            incoming += frag / (float)carriers;
            ConsiderGenomeContribution(bestMass, bestGenome, frag, G(neighbor));
        }
        life.x = max(0.0, life.x + incoming);
        if (incoming > life.x - incoming)
            genome = bestGenome;
    }

    float toxinAdd = (D(material).biology.x * 8.0 + saturate(combustion.z) * 12.0 + abs(state.w) * 4.0) * _DeltaTime;
    uint dose = min(255u, FloraToxinDose(genome) + (uint)round(max(0.0, toxinAdd)));
    float toxinTol = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_TOXIN_TOLERANCE), expression);
    if (dose / 255.0 > toxinTol)
        life.y = max(0.0, life.y - decayRate * 0.35 * _DeltaTime);

    int2 d = DivisionOffset();
    int2 childCell = C(cell + d);
    int2 parentCell = C(cell - d);
    bool isParent = WillDivideInto(cell, childCell);
    bool isChild = WillDivideInto(parentCell, cell);

    if (isChild)
    {
        float4 parentLife = L(parentCell);
        uint4 parentGenome = G(parentCell);
        uint generation = min(255u, FloraGeneration(parentGenome) + 1u);
        genome = MutateFloraGenome(parentGenome, (uint2)cell);
        genome.w = PackFloraMeta(FLORA_STAGE_ACTIVE, generation, FloraLineage(parentGenome), FloraToxinDose(parentGenome) / 2u);
        material = FLORA_ALGAE_ID;
        life.y = saturate(parentLife.y * 0.5);
        life.z = saturate(parentLife.z * 0.5);
        life.x = max(life.x, 0.02);
        life.w = parentLife.w * 0.5;
        Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    if (isParent)
    {
        life.y = saturate(life.y * 0.5);
        life.z = saturate(life.z * 0.5);
        life.w *= 0.5;
    }

    if (!IsFloraMaterial(material))
    {
        bool canGerminate = IsFloraGerminationTarget(material) && life.x >= germThreshold && inGrowth && light >= minLight;
        if (IsFloraOpenHabitat(material))
            canGerminate = canGerminate && HasAnchorNeighbor(cell);
        if (canGerminate)
        {
            material = FLORA_ALGAE_ID;
            if (FloraStage(genome) == FLORA_STAGE_SPORE && genome.x == 0u && genome.y == 0u && genome.z == 0u)
                genome = RandomFloraGenome((uint2)cell, _Seed, _Tick);
            genome.w = PackFloraMeta(FLORA_STAGE_ACTIVE, 0u, FloraLineage(genome), FloraToxinDose(genome));
            life.y = saturate(max(life.y, 0.12 + saturate(life.x) * 0.25));
            life.z = saturate(max(life.z, 0.05));
            life.x = max(0.0, life.x * 0.35);
        }
        Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    uint stage = FloraStage(genome);
    if (inGrowth && light >= minLight * 0.25)
    {
        stage = FLORA_STAGE_ACTIVE;
        float inoculum = saturate(life.y) + saturate(life.x) * 0.2;
        life.y = saturate(life.y + growthRate * inoculum * _DeltaTime);
    }
    else if (inSurvival)
    {
        stage = FLORA_STAGE_DORMANT;
        float resilience = FloraExpressFactor(DecodeGene(genome, FLORA_GENE_DORMANCY), expression);
        life.y = max(life.y, 0.05 * resilience);
    }
    else
    {
        stage = FLORA_STAGE_DESICCATED;
        life.y = max(0.0, life.y - decayRate * 0.15 * _DeltaTime);
        if (life.y <= 1e-4)
        {
            aux.z += 0.08;
            material = 12u;
            stage = FLORA_STAGE_DEAD;
            life = float4(max(0.0, life.x * 0.1), 0.0, 0.0, life.w * 0.2);
            genome = uint4(0u, 0u, 0u, PackFloraMeta(FLORA_STAGE_DEAD, 0u, 0u, 0u));
            Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
            return;
        }
    }

    genome.w = PackFloraMeta(stage, FloraGeneration(genome), FloraLineage(genome), dose);
    life.y = max(0.0, life.y - FloraFragmentAmount(cell));
    Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void SeedFlora(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    uint material = M(id.xy);
    float floraSpores = 0.0;
    if (_FloraH.x > 0.5 && IsSporeCarrier(material))
        floraSpores = max(0.0, _FloraG.w) * lerp(0.35, 1.0, Hash01(id.x * 6151u + id.y * 2707u + (uint)_Seed));
    WriteLifeGenome(_LifeGenomeWrite, id.xy, float4(floraSpores, 0.0, 0.0, 0.0), uint4(0u, 0u, 0u, 0u));
}

[numthreads(8, 8, 1)]
void FloraMigration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material;
    float4 state;
    float2 flow;
    float4 aux;
    float4 ecology;
    float4 combustion;
    float4 life;
    uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);

    if (IsFloraMaterial(material))
    {
        int2 dest = FloraDriftDestination(cell);
        if (!all(dest == cell) && FloraDriftWins(cell, dest))
            CopyCell(dest, material, state, flow, aux, ecology, combustion, life, genome);
    }
    else
    {
        int2 left = C(cell + int2(-1, 0));
        int2 right = C(cell + int2(1, 0));
        int2 source = cell;
        if (FloraDriftWins(left, cell)) source = left;
        else if (FloraDriftWins(right, cell)) source = right;
        if (!all(source == cell))
            CopyCell(source, material, state, flow, aux, ecology, combustion, life, genome);
    }

    Write(cell, material, state, flow, aux, ecology, combustion, life, genome);
}
