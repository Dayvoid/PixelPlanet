#include "../../Shaders/Simulation/Common/OrganismHistory.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;

Texture2DArray<float4> _FloraRead;
RWTexture2DArray<float4> _FloraWrite;
Texture2DArray<float4> _PropaguleRead;
RWTexture2DArray<float4> _PropaguleWrite;
Texture2D<uint> _FloraClaims;
RWTexture2D<uint> _FloraClaimsWrite;

Texture2D<float> _LightRead;
RWTexture2D<float> _LightWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float _TicksPerSecond;
#ifndef GENESYS_TICKS_PER_DAY_DECLARED
#define GENESYS_TICKS_PER_DAY_DECLARED
float _TicksPerDay;
#endif

float4 _WeatherA; // solarIntensity, ...
float4 _WeatherC; // vaporPressureScale, solarAngle01, ...
float4 _WeatherE; // vaporCapacityScale, cloudRetainMass, waterPressureResponse, latentHeatScale
float4 _WeatherF; // ..., atmosphericCflLimit
float4 _WeatherH; // atmosphereAbsorption, ...
float4 _WeatherI; // coriolisStrength, velocityAdvectionRate, prevailingWind, unused

float4 _FloraA; // airTransport, waterTransport, diffusion, settling
float4 _FloraB; // sporulation, growth, decay, photosynthesis
float4 _FloraC; // oxygenYield, exudation, reproductionThreshold, baseMutationRate
float4 _FloraD; // toxinMutationScale, geneExpressionRange, growthTempMin, growthTempMax
float4 _FloraE; // growthMoistureMin, growthMoistureMax, survivalTempMin, survivalTempMax
float4 _FloraF; // survivalMoistureMin, survivalMoistureMax, minLight, germinationSporeThreshold
float4 _FloraG; // maintenanceRate, nightDrain, dormancyMetabolicScale, initialSporeLoad
float4 _FloraH; // seedAtWorldgen, anchorGrip, unused, unused
float4 _FloraI; // poleDriftRate, windShearRate, rainShearRate, fragmentYield

float4 _GrassA; // waterUptake, nutrientUptake, photosynthesis, growth
float4 _GrassB; // decay, maintenance, nightDrain, flowerEnergy
float4 _GrassC; // expression, growthTempMin, growthTempMax, growthMoistureMin
float4 _GrassD; // growthMoistureMax, survivalTempMin, survivalTempMax, survivalMoistureMin
float4 _GrassE; // survivalMoistureMax, minLight, adultBiomass, nectar
float4 _GrassF; // pollenEmit, pollenTransport, seedTransport, canopyOpacity
float4 _GrassG; // pollenWind, pollenWater, pollenSettle, seedWind
float4 _GrassH; // seedWater, seedSettle, initialBiomass, initialEnergy
float4 _GrassI; // seedAtWorldgen, cohesionBonus, detritusNutrient, detritusMoisture

float4 _TreeA; // waterUptake, nutrientUptake, photosynthesis, growth
float4 _TreeB; // decay, maintenance, nightDrain, vascularRate
float4 _TreeC; // expression, growthTempMin, growthTempMax, growthMoistureMin
float4 _TreeD; // growthMoistureMax, survivalTempMin, survivalTempMax, survivalMoistureMin
float4 _TreeE; // survivalMoistureMax, minLight, growthCost, windBias
float4 _TreeF; // sproutHeight, saplingHeight, maxHeight, maxTrunkWidth
float4 _TreeG; // initialEnergy, initialHydration, initialNutrient, initialHealth
float4 _TreeH; // seedAtWorldgen, cohesionBonus, canopyOpacity, exposureDamage
float4 _TreeI; // leafLifeTicks, rotTicks, disconnectTicks, saplingBranchMin
float4 _TreeJ; // saplingBranchMax, unused

float4 _FloraPaintCell; // x, y, radius, archetype
float4 _MycologyE;      // survivalMoistureMax, electricalTolerance, traitEffectStrength, unused

#include "../../Shaders/Simulation/Common/Climate.hlsl"

int2 C(int2 value) { return ClampCell(value, _GridSize); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
float4 Eco(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
float LightOf(int2 value) { return _LightRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

float MoistureOf(float4 state, float4 aux)
{
    return max(0.0, state.z) + max(0.0, aux.y);
}

float HashCell(int2 cell, uint salt)
{
    return Hash01((uint)cell.x * 73856093u + (uint)cell.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 31337u + salt);
}

bool IsOpenHabitat(uint material)
{
    float category = D(material).metadata.x;
    return material == 0u || material == 1u || material == 11u || category == 1.0;
}

int2 OwnerCell(uint4 topology)
{
    if (topology.y == 0u) return int2(-1, -1);
    return UnpackFaunaCell(topology.y, _GridSize);
}

int2 ParentCell(uint4 topology)
{
    if (topology.x == 0u) return int2(-1, -1);
    return UnpackFaunaCell(topology.x, _GridSize);
}

void WriteWorld(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion, float4 life, uint4 genome)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, life, genome);
}

void CopyWorld(int2 cell, out uint material, out float4 state, out float2 flow, out float4 aux, out float4 ecology, out float4 combustion, out float4 life, out uint4 genome)
{
    cell = C(cell);
    material = M(cell);
    state = S(cell);
    flow = F(cell);
    aux = A(cell);
    ecology = Eco(cell);
    combustion = Comb(cell);
    life = SampleLife(_LifeGenomeRead, cell);
    genome = SampleGenome(_LifeGenomeRead, cell);
}

bool IsFloraCarrier(uint material)
{
    return material == 0u || IsSporeCarrier(material);
}

int CountCarrierNeighbors(int2 cell)
{
    int count = 0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 neighbor = cell + offsets[i];
        if (neighbor.y < 0 || neighbor.y >= _GridSize.y) continue;
        if (IsFloraCarrier(M(neighbor))) count++;
    }
    return count;
}

uint4 DriftGenome(int2 cell)
{
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    if (identity.x == FLORA_ARCHETYPE_ALGAE)
        return SampleFloraGenome(_FloraRead, cell);
    return SampleGenome(_LifeGenomeRead, cell);
}

float AlgaeBiomass(int2 cell)
{
    float4 life = SampleLife(_LifeGenomeRead, cell);
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    if (identity.x == FLORA_ARCHETYPE_ALGAE)
        return saturate(max(life.y, SampleFloraPhysiology(_FloraRead, cell).x));
    return saturate(life.y);
}

float FloraRainImpact(int2 cell)
{
    int2 up = cell + int2(0, 1);
    if (up.y >= _GridSize.y) return 0.0;
    uint upMat = M(up);
    if (upMat == 9u || upMat == 10u) return 1.0;
    if (IsFloraCarrier(upMat))
        return max(0.0, S(up).z - _WeatherE.y);
    return 0.0;
}

void SampleShear(int2 cell, out float wind, out float rain)
{
    wind = 0.0;
    rain = FloraRainImpact(cell);
    float best = 0.0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 neighbor = cell + offsets[i];
        if (neighbor.y < 0 || neighbor.y >= _GridSize.y) continue;
        neighbor = C(neighbor);
        if (!IsFloraCarrier(M(neighbor))) continue;
        float fx = F(neighbor).x;
        if (abs(fx) > best)
        {
            best = abs(fx);
            wind = fx;
        }
    }
}

bool IsAlgaeCrest(int2 cell)
{
    return cell.y >= _GridSize.y - 1 || M(cell + int2(0, 1)) != FLORA_ALGAE_ID;
}

float FloraShearUrge(int2 cell)
{
    if (!IsFloraMaterial(M(cell)) || !IsAlgaeCrest(cell))
        return 0.0;
    float wind;
    float rain;
    SampleShear(cell, wind, rain);
    float raw = abs(wind) * max(0.0, _FloraI.y) + rain * max(0.0, _FloraI.z);
    return max(0.0, raw - saturate(AlgaeBiomass(cell)) * max(0.0, _FloraH.y));
}

float FloraFragmentAmount(int2 cell)
{
    return FloraShearUrge(cell) * saturate(_FloraI.w) * _DeltaTime;
}

void HydrateAlgae(int2 cell, inout float4 phys, inout uint4 identity, inout uint4 genome)
{
    if (identity.x != FLORA_ARCHETYPE_NONE || M(cell) != FLORA_ALGAE_ID)
        return;
    float4 life = SampleLife(_LifeGenomeRead, cell);
    if (life.y <= 1e-6)
        return;
    identity = uint4(FLORA_ARCHETYPE_ALGAE, FLORA_STAGE_ACTIVE, FLORA_ROLE_ALGAE_FILM, 0u);
    genome = SampleGenome(_LifeGenomeRead, cell);
    genome.w = PackFloraMeta(FLORA_STAGE_ACTIVE, FloraGeneration(genome), FloraLineage(genome), FloraToxinDose(genome));
    phys = float4(saturate(max(life.y, 0.35)), saturate(max(life.z, life.y)), saturate(max(life.z, 0.1)), saturate(life.w));
}

int2 FloraDriftDestination(int2 cell)
{
    if (!IsFloraMaterial(M(cell)))
        return cell;

    int step = 0;
    bool stacked = cell.y > 0 && M(cell + int2(0, -1)) == FLORA_ALGAE_ID;
    if (stacked)
    {
        float urge = FloraPoleDrift(DriftGenome(cell)) * max(0.0, _FloraI.x);
        step = NearestPoleStep(cell.x, _GridSize.x, _Seed);
        if (step == 0 || HashCell(cell, 71u) >= saturate(urge * _DeltaTime))
            step = 0;
    }

    if (step == 0)
    {
        float shear = FloraShearUrge(cell);
        if (shear > 1e-8 && HashCell(cell, 83u) < saturate(shear * _DeltaTime))
        {
            float wind;
            float rain;
            SampleShear(cell, wind, rain);
            if (abs(wind) < 1e-5)
                step = HashCell(cell, 97u) < 0.5 ? -1 : 1;
            else
                step = wind > 0.0 ? 1 : -1;
        }
    }

    if (step == 0)
        return cell;
    int2 dest = C(cell + int2(step, 0));
    if (IsFloraMaterial(M(dest)) || !IsFloraGerminationTarget(M(dest)))
        return cell;
    return dest;
}

bool FloraDriftWins(int2 source, int2 target)
{
    int2 left = C(target + int2(-1, 0));
    int2 right = C(target + int2(1, 0));
    if (all(FloraDriftDestination(left) == target)) return all(source == left);
    if (all(FloraDriftDestination(right) == target)) return all(source == right);
    return false;
}

int2 FloraMigrationSource(int2 cell)
{
    if (IsFloraMaterial(M(cell)))
    {
        int2 dest = FloraDriftDestination(cell);
        if (!all(dest == cell) && FloraDriftWins(cell, dest))
            return dest;
        return cell;
    }

    int2 left = C(cell + int2(-1, 0));
    int2 right = C(cell + int2(1, 0));
    if (FloraDriftWins(left, cell)) return left;
    if (FloraDriftWins(right, cell)) return right;
    return cell;
}

float4 SeedDetritusAux(float4 aux)
{
    aux.y = max(aux.y, max(0.2, saturate(_GrassI.w)));
    aux.z = max(aux.z, max(0.45, saturate(_GrassI.z)));
    return aux;
}

bool TreeLiving(uint4 identity)
{
    return identity.x == FLORA_ARCHETYPE_TREE
        && identity.y != FLORA_STAGE_EMPTY
        && identity.y != FLORA_STAGE_DEAD;
}

uint TreeAnchorPack(int2 cell, uint4 identity, uint4 topo)
{
    if ((identity.w & FLORA_FLAG_ANCHOR) != 0u)
        return PackFaunaCell(cell, _GridSize);
    return topo.y;
}

bool SameTree(int2 a, int2 b)
{
    uint4 idA = SampleFloraIdentity(_FloraRead, a);
    uint4 idB = SampleFloraIdentity(_FloraRead, b);
    if (!TreeLiving(idA) || !TreeLiving(idB)) return false;
    uint anchorA = TreeAnchorPack(a, idA, SampleFloraTopology(_FloraRead, a));
    uint anchorB = TreeAnchorPack(b, idB, SampleFloraTopology(_FloraRead, b));
    return anchorA != 0u && anchorA == anchorB;
}

int2 TreeAnchorCell(int2 cell, uint4 identity, uint4 topo)
{
    if ((identity.w & FLORA_FLAG_ANCHOR) != 0u) return cell;
    int2 owner = OwnerCell(topo);
    return owner.y >= 0 ? owner : cell;
}

int TreeColumnHeight(int2 anchor)
{
    int limit = clamp((int)round(_TreeF.z), 1, 48);
    int height = 0;
    for (int dy = 1; dy <= limit; dy++)
    {
        int y = anchor.y + dy;
        if (y >= _GridSize.y) break;
        int2 p = int2(anchor.x, y);
        if (!SameTree(anchor, p)) break;
        uint role = SampleFloraIdentity(_FloraRead, p).z;
        if (role != FLORA_ROLE_TREE_STEM && role != FLORA_ROLE_TREE_TRUNK) break;
        height = dy;
    }
    return height;
}

int TreeCrownCap(uint4 genome)
{
    float scale = lerp(1.0, TreeMatureHeightScale(genome), saturate(_TreeC.x));
    int cap = (int)floor(max(1.0, _TreeF.z) * scale + 1e-4);
    int sapling = clamp((int)round(_TreeF.y), 1, 48);
    return clamp(max(cap, sapling), 1, 48);
}

int TreeRootDepth(int2 anchor)
{
    int depth = 0;
    for (int dy = 1; dy <= 8; dy++)
    {
        int y = anchor.y - dy;
        if (y < 0) break;
        int2 p = int2(anchor.x, y);
        if (!SameTree(anchor, p)) break;
        if (SampleFloraIdentity(_FloraRead, p).z != FLORA_ROLE_TREE_ROOT) break;
        depth = dy;
    }
    return depth;
}

int TreeBranchCount(int2 anchor, int height)
{
    int count = 0;
    int span = max(height, 1);
    for (int dy = 1; dy <= span; dy++)
    {
        int y = anchor.y + dy;
        if (y >= _GridSize.y) break;
        int2 trunk = int2(anchor.x, y);
        uint self = PackFaunaCell(trunk, _GridSize);
        [unroll]
        for (int dir = -1; dir <= 1; dir += 2)
        {
            int2 side = C(trunk + int2(dir, 0));
            if (!SameTree(anchor, side)) continue;
            uint4 id = SampleFloraIdentity(_FloraRead, side);
            uint4 topo = SampleFloraTopology(_FloraRead, side);
            if (id.z == FLORA_ROLE_TREE_BRANCH && topo.x == self) count++;
        }
    }
    return count;
}

bool TreeSideIsLeaf(int2 shoot, int dir, int2 anchor)
{
    int2 side = C(shoot + int2(dir, 0));
    uint4 id = SampleFloraIdentity(_FloraRead, side);
    if (!TreeLiving(id) || id.z != FLORA_ROLE_TREE_LEAF) return false;
    uint4 topo = SampleFloraTopology(_FloraRead, side);
    if (topo.x == PackFaunaCell(shoot, _GridSize)) return true;
    return TreeAnchorPack(side, id, topo) == PackFaunaCell(anchor, _GridSize);
}

bool TreeHasLateralLeaf(int2 anchor, int height)
{
    int span = max(height, 1);
    for (int dy = 1; dy <= span; dy++)
    {
        int y = anchor.y + dy;
        if (y >= _GridSize.y) break;
        int2 shoot = int2(anchor.x, y);
        if (TreeSideIsLeaf(shoot, -1, anchor) || TreeSideIsLeaf(shoot, 1, anchor)) return true;
    }
    return false;
}

bool TreeHasLeafChild(int2 cell)
{
    uint self = PackFaunaCell(cell, _GridSize);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (n.y < 0 || n.y >= _GridSize.y) continue;
        n = C(n);
        uint4 id = SampleFloraIdentity(_FloraRead, n);
        if (!TreeLiving(id) || id.z != FLORA_ROLE_TREE_LEAF) continue;
        if (SampleFloraTopology(_FloraRead, n).x == self) return true;
    }
    return false;
}

int TreeChildCount(int2 cell)
{
    int count = 0;
    uint self = PackFaunaCell(cell, _GridSize);
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (n.y < 0 || n.y >= _GridSize.y) continue;
        n = C(n);
        if (!TreeLiving(SampleFloraIdentity(_FloraRead, n))) continue;
        if (SampleFloraTopology(_FloraRead, n).x == self) count++;
    }
    return count;
}

int TreeWrappedDx(int2 from, int2 to)
{
    int dx = to.x - from.x;
    if (dx > _GridSize.x / 2) dx -= _GridSize.x;
    if (dx < -_GridSize.x / 2) dx += _GridSize.x;
    return dx;
}

int TreeWindDir(int2 cell, uint4 genome)
{
    float lean = F(cell).x * max(0.0, _TreeE.w) * TreeWindResponse(genome);
    if (abs(lean) > 0.02) return lean > 0.0 ? 1 : -1;
    return HashCell(cell, 29u) < 0.5 ? -1 : 1;
}

bool TreeTouchesAir(int2 cell)
{
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 n = cell + offsets[i];
        if (n.y < 0 || n.y >= _GridSize.y) continue;
        if (IsOpenHabitat(M(C(n)))) return true;
    }
    return false;
}

bool TreeGrowthNiche(int2 tip, int2 anchor, bool needsLight)
{
    float temp = S(tip).x;
    if (temp < _TreeC.y || temp > _TreeC.z) return false;
    float moist = MoistureOf(S(anchor), A(anchor));
    if (moist < _TreeC.w || moist > _TreeD.x) return false;
    if (needsLight && LightOf(tip) < _TreeE.y) return false;
    return true;
}

bool TreeCanAfford(float4 phys, float nutrient)
{
    float cost = max(0.0, _TreeE.z);
    return phys.y >= cost && phys.z >= cost * 0.5 && nutrient >= cost * 0.5;
}

bool TreeGrowthRoll(int2 cell, uint4 genome)
{
    float metabolic = TreeExpressFactor(DecodeGene(genome, TREE_GENE_METABOLIC), saturate(_TreeC.x));
    float chance = saturate(max(0.0, _TreeA.w) * metabolic);
    if (chance <= 0.0) return false;
    return HashCell(cell, 17u) < chance;
}

bool TreeTargetFree(int2 target)
{
    if (target.y < 0 || target.y >= _GridSize.y) return false;
    return SampleFloraIdentity(_FloraRead, target).x == FLORA_ARCHETYPE_NONE;
}

bool TreeEmit(int2 target, int2 source)
{
    if (!TreeTargetFree(target) || all(target == source)) return false;
    uint packed = PackFaunaCell(source, _GridSize);
    uint original;
    InterlockedMin(_FloraClaimsWrite[target], packed, original);
    return original == FLORA_CLAIM_EMPTY || packed <= original;
}

bool TreeEmitOpen(int2 target, int2 source)
{
    if (target.y < 0 || target.y >= _GridSize.y) return false;
    if (!IsOpenHabitat(M(target))) return false;
    return TreeEmit(target, source);
}

int TreeTrunkWidth(int2 anchor)
{
    int width = 1;
    [unroll]
    for (int dir = -1; dir <= 1; dir += 2)
    {
        for (int step = 1; step <= 8; step++)
        {
            int2 p = C(anchor + int2(dir * step, 0));
            if (p.y != anchor.y) break;
            if (!SameTree(anchor, p)) break;
            if (SampleFloraIdentity(_FloraRead, p).z != FLORA_ROLE_TREE_TRUNK) break;
            width++;
        }
    }
    return width;
}

void TreeVascularPair(int2 donorParent, int2 child, out float waterFlux, out float nutrientFlux, out float energyFlux)
{
    float4 parentPhys = SampleFloraPhysiology(_FloraRead, donorParent);
    float4 childPhys = SampleFloraPhysiology(_FloraRead, child);
    float parentNutrient = SampleFloraPropagule(_FloraRead, donorParent).y;
    float childNutrient = SampleFloraPropagule(_FloraRead, child).y;
    int kids = max(1, TreeChildCount(donorParent));
    float rate = max(0.0, _TreeB.w) * _DeltaTime;
    waterFlux = min(max(0.0, parentPhys.z - childPhys.z) * rate, max(0.0, parentPhys.z) / (float)kids);
    nutrientFlux = min(max(0.0, parentNutrient - childNutrient) * rate, max(0.0, parentNutrient) / (float)kids);
    energyFlux = min(max(0.0, childPhys.y - parentPhys.y) * rate, max(0.0, childPhys.y));
}

uint TreeGrowthRole(int2 cell, int2 parent, uint4 parentIdentity, uint4 parentTopo)
{
    int sapling = clamp((int)round(_TreeF.y), 1, 48);
    int2 anchor = TreeAnchorCell(parent, parentIdentity, parentTopo);
    int height = TreeColumnHeight(anchor);
    if (IsTreeHabitat(M(cell)) && cell.y < parent.y)
        return FLORA_ROLE_TREE_ROOT;
    if (cell.y > parent.y)
        return height >= sapling ? FLORA_ROLE_TREE_TRUNK : FLORA_ROLE_TREE_STEM;
    if (parentIdentity.z == FLORA_ROLE_TREE_BRANCH
        || parentIdentity.z == FLORA_ROLE_TREE_STEM
        || parentIdentity.z == FLORA_ROLE_TREE_LEAF)
        return FLORA_ROLE_TREE_LEAF;
    if (parentIdentity.z == FLORA_ROLE_TREE_ROOT)
        return FLORA_ROLE_TREE_TRUNK;
    return FLORA_ROLE_TREE_BRANCH;
}

uint TreeBodyMaterial(uint role, uint flags, uint current)
{
    if (role == FLORA_ROLE_TREE_ROOT && (flags & FLORA_FLAG_ANCHOR) == 0u)
        return current;
    if (role == FLORA_ROLE_TREE_STEM || role == FLORA_ROLE_TREE_LEAF)
        return TREE_LEAF_ID;
    return TREE_WOOD_ID;
}

bool TreeBodyPresent(uint material, uint role, uint flags)
{
    if (role == FLORA_ROLE_TREE_ROOT && (flags & FLORA_FLAG_ANCHOR) == 0u)
        return IsTreeHabitat(material);
    if (material == TREE_LEAF_ID || material == TREE_WOOD_ID) return true;
    return role == FLORA_ROLE_TREE_ROOT && (flags & FLORA_FLAG_ANCHOR) != 0u && IsTreeHabitat(material);
}

// -------------------------------------------------------------------------
// 1. LIGHT ATTENUATION
// Scans downward through columns. Attenuates through clouds, vapor, canopies, water.
// -------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void LightAttenuation(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x) return;
    int theta = (int)id.x;
    float theta01 = (float)theta / (float)_GridSize.x;
    float insolation = SolarInsolation(theta01, _WeatherC.y);
    float light = saturate(_WeatherA.x * insolation);

    for (int r = _GridSize.y - 1; r >= 0; r--)
    {
        int2 cell = int2(theta, r);
        _LightWrite[cell] = light;

        uint material = M(cell);
        float4 state = S(cell);
        float4 combustion = Comb(cell);
        MaterialGpuData definition = D(material);
        float category = definition.metadata.x;
        float opacity = 0.0;

        bool atmosphere = category == 1.0 || material == 1u
            || (material == 0u && Radius01(r, _GridSize.y) >= _AtmosphereStartRadius);

        if (atmosphere)
        {
            opacity += saturate(state.z) * 0.35;
            opacity += saturate(A(cell).x) * saturate(_WeatherH.x) * 0.35;
            opacity += saturate(combustion.z) * 0.4;
        }
        else if (material == 9u || material == 10u)
        {
            opacity += 0.18 + saturate(state.z) * 0.12;
        }
        else if (category >= 3.0)
        {
            opacity += lerp(0.55, 0.95, 1.0 - saturate(definition.biology.z));
        }

        // Unified Flora Opacity:
        uint4 identity = SampleFloraIdentity(_FloraRead, cell);
        float4 phys = SampleFloraPhysiology(_FloraRead, cell);
        if (identity.x == FLORA_ARCHETYPE_TREE)
        {
            if (identity.z == FLORA_ROLE_TREE_LEAF)
                opacity += (0.18 + saturate(phys.w) * 0.22) * saturate(_TreeH.z);
            else if (identity.z == FLORA_ROLE_TREE_STEM)
                opacity += 0.08 * saturate(_TreeH.z);
            else if (identity.z == FLORA_ROLE_TREE_TRUNK || identity.z == FLORA_ROLE_TREE_BRANCH)
                opacity += 0.45 * saturate(_TreeH.z);
        }
        else if (identity.x == FLORA_ARCHETYPE_GRASS)
        {
            opacity += saturate(phys.x) * saturate(_GrassF.w);
        }
        else if (identity.x == FLORA_ARCHETYPE_ALGAE)
        {
            opacity += saturate(phys.x) * 0.2;
        }

        light *= saturate(1.0 - opacity);
    }
}

// -------------------------------------------------------------------------
// 2. ROOT UPTAKE
// Extracts groundwater and soil nutrients for rooted flora (Grass turf, Tree roots).
// Coupled with Mycology hyphal fertility.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void RootUptake(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    float4 phys = SampleFloraPhysiology(_FloraRead, cell);
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    uint4 topo = SampleFloraTopology(_FloraRead, cell);
    uint4 genome = SampleFloraGenome(_FloraRead, cell);
    float4 prop = SampleFloraPropagule(_FloraRead, cell);

    float4 state = S(cell);
    float4 aux = A(cell);
    float4 ecology = Eco(cell);

    bool isRooted = (identity.x == FLORA_ARCHETYPE_GRASS && IsGrassSoilAnchor(M(cell)))
                 || (identity.x == FLORA_ARCHETYPE_TREE && identity.z == FLORA_ROLE_TREE_ROOT);

    if (isRooted && identity.y != FLORA_STAGE_EMPTY && identity.y != FLORA_STAGE_DEAD)
    {
        float uptakeW = identity.x == FLORA_ARCHETYPE_TREE ? max(0.0, _TreeA.x) : max(0.0, _GrassA.x);
        float uptakeN = identity.x == FLORA_ARCHETYPE_TREE ? max(0.0, _TreeA.y) : max(0.0, _GrassA.y);

        // Mycorrhizal symbiosis boost:
        float mycoBoost = 1.0 + saturate(ecology.y) * saturate(_MycologyE.z) * 0.5;

        // Demands based on deficit:
        float demandW = max(0.0, 1.0 - saturate(phys.z)) * uptakeW * _DeltaTime * mycoBoost;
        float demandN = max(0.0, 1.0 - saturate(phys.y)) * uptakeN * _DeltaTime * mycoBoost;

        // Available soil moisture (state.z surface liquid + aux.y groundwater):
        float availW = max(0.0, state.z) + max(0.0, aux.y);
        float pullW = min(demandW, availW * 0.45);

        // Debit groundwater first, then surface water:
        float pullGround = min(pullW, max(0.0, aux.y));
        aux.y = max(0.0, aux.y - pullGround);
        float pullSurface = pullW - pullGround;
        if (pullSurface > 0.0) state.z = max(0.0, state.z - pullSurface);

        // Available nutrient (aux.z):
        float availN = max(0.0, aux.z);
        float pullN = min(demandN, availN * 0.35);
        aux.z = max(0.0, aux.z - pullN);

        phys.z = saturate(phys.z + pullW);
        if (identity.x == FLORA_ARCHETYPE_TREE)
            prop.y = saturate(prop.y + pullN);
        else
            phys.y = saturate(phys.y + pullN * 0.5);
    }

    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));

    _FloraWrite[uint3((uint2)cell, FLORA_PHYSIOLOGY_SLICE)] = phys;
    _FloraWrite[uint3((uint2)cell, FLORA_IDENTITY_SLICE)] = float4(identity);
    _FloraWrite[uint3((uint2)cell, FLORA_TOPOLOGY_SLICE)] = float4(topo);
    _FloraWrite[uint3((uint2)cell, FLORA_GENOME_SLICE)] = asfloat(genome);
    _FloraWrite[uint3((uint2)cell, FLORA_PROPAGULE_SLICE)] = prop;
}

// -------------------------------------------------------------------------
// 3. PHOTOSYNTHESIS & METABOLISM
// Photosynthesis, oxygen production, maintenance, nectar/exudate, and vascular flow.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void Photosynthesis(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    float4 phys = SampleFloraPhysiology(_FloraRead, cell);
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    uint4 topo = SampleFloraTopology(_FloraRead, cell);
    uint4 genome = SampleFloraGenome(_FloraRead, cell);
    float4 prop = SampleFloraPropagule(_FloraRead, cell);

    uint material = M(cell);
    float4 state = S(cell);
    float4 aux = A(cell);
    float4 combustion = Comb(cell);
    float4 life = SampleLife(_LifeGenomeRead, cell);
    float light = max(0.0, LightOf(cell));
    HydrateAlgae(cell, phys, identity, genome);

    if (identity.x != FLORA_ARCHETYPE_NONE && identity.y != FLORA_STAGE_EMPTY && identity.y != FLORA_STAGE_DEAD)
    {
        float temp = state.x;
        bool tree = identity.x == FLORA_ARCHETYPE_TREE;
        float expr = tree ? saturate(_TreeC.x) : saturate(_FloraD.y);

        float optT = tree ? _TreeC.y : (identity.x == FLORA_ARCHETYPE_GRASS ? _GrassC.y : _FloraD.z);
        float tolT = tree ? _TreeC.z : (identity.x == FLORA_ARCHETYPE_GRASS ? _GrassC.z : _FloraD.w);
        float photoRate = tree ? _TreeA.z : (identity.x == FLORA_ARCHETYPE_GRASS ? _GrassA.z : _FloraB.w);
        float maintRate = tree ? _TreeB.y : (identity.x == FLORA_ARCHETYPE_GRASS ? _GrassB.y : _FloraG.x);
        float nightDrain = tree ? _TreeB.z : (identity.x == FLORA_ARCHETYPE_GRASS ? _GrassB.z : _FloraG.y);

        float tempFactor = saturate(1.0 - abs(temp - optT) / max(5.0, tolT));
        float lightAffinity = tree
            ? TreeExpressFactor(DecodeGene(genome, TREE_GENE_LIGHT_AFFINITY), expr)
            : FloraExpressFactor(DecodeGene(genome, FLORA_GENE_LIGHT_AFFINITY), expr);
        float metabolic = tree
            ? TreeExpressFactor(DecodeGene(genome, TREE_GENE_METABOLIC), expr)
            : FloraExpressFactor(DecodeGene(genome, FLORA_GENE_METABOLIC), expr);

        bool canPhotosynthesize = identity.x == FLORA_ARCHETYPE_ALGAE
                               || identity.x == FLORA_ARCHETYPE_GRASS
                               || (tree && (identity.z == FLORA_ROLE_TREE_LEAF || identity.z == FLORA_ROLE_TREE_STEM));

        float energyGain = 0.0;
        if (canPhotosynthesize)
        {
            energyGain = max(0.0, photoRate) * light * lightAffinity * tempFactor * saturate(phys.z) * _DeltaTime;
            phys.y = saturate(phys.y + energyGain);

            // Oxygen production:
            float oxygen = max(0.0, _FloraC.x) * saturate(phys.x) * energyGain;
            float cap = OxygenCapacity(material, D(material));
            combustion.x = min(cap, combustion.x + oxygen);
        }

        // Maintenance drain:
        float cost = maintRate * metabolic * _DeltaTime;
        if (light < 0.05) cost += nightDrain * metabolic * _DeltaTime;
        phys.y = saturate(phys.y - cost);

        // Hydration drain / transpiration:
        phys.z = saturate(phys.z - (cost * 0.5 + energyGain * 0.2));

        // Nectar / Exudate. A juvenile that matures this tick does not bloom in the same pass.
        if (identity.x == FLORA_ARCHETYPE_GRASS)
        {
            bool wasMature = identity.y == FLORA_STAGE_MATURE;
            if (wasMature && phys.y >= _GrassB.w)
                identity.w |= FLORA_FLAG_FLOWERING;
            if ((identity.w & FLORA_FLAG_FLOWERING) != 0u)
                phys.w = saturate(phys.w + _GrassE.w * energyGain * 2.0);
        }
        else if (identity.x == FLORA_ARCHETYPE_ALGAE)
        {
            float emit = _FloraC.y * saturate(phys.x) * energyGain;
            phys.w = saturate(phys.w + emit);
            aux.z = max(0.0, aux.z + emit * 0.15);
        }

        // Tree vascular flow is conservative: the child and its parent both
        // apply the same read-only flux. Water and nutrient move up; energy moves down.
        if (tree)
        {
            int2 parent = ParentCell(topo);
            bool linked = parent.y >= 0 && parent.y < _GridSize.y && !all(parent == cell)
                && TreeLiving(SampleFloraIdentity(_FloraRead, parent));
            if (linked)
            {
                float waterFlux, nutrientFlux, energyFlux;
                TreeVascularPair(parent, cell, waterFlux, nutrientFlux, energyFlux);
                phys.z = saturate(phys.z + waterFlux);
                prop.y = saturate(prop.y + nutrientFlux);
                phys.y = saturate(phys.y - energyFlux);
            }

            int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
            uint self = PackFaunaCell(cell, _GridSize);
            [unroll]
            for (int i = 0; i < 4; i++)
            {
                int2 n = cell + offsets[i];
                if (n.y < 0 || n.y >= _GridSize.y) continue;
                n = C(n);
                if (!TreeLiving(SampleFloraIdentity(_FloraRead, n))) continue;
                if (SampleFloraTopology(_FloraRead, n).x != self) continue;
                float waterFlux, nutrientFlux, energyFlux;
                TreeVascularPair(cell, n, waterFlux, nutrientFlux, energyFlux);
                phys.z = max(0.0, phys.z - waterFlux);
                prop.y = max(0.0, prop.y - nutrientFlux);
                phys.y = saturate(phys.y + energyFlux);
            }

            if (identity.z == FLORA_ROLE_TREE_LEAF)
            {
                topo.w += 1u;
                float life = max(1.0, _TreeI.x) * lerp(1.0, TreeLeafLifeScale(genome), saturate(_TreeC.x));
                if ((float)topo.w > life) identity.w |= FLORA_FLAG_SHED;
            }

            float moist = max(MoistureOf(state, aux), phys.z);
            bool survive = temp >= _TreeD.y && temp <= _TreeD.z && moist >= _TreeD.w && moist <= _TreeE.x;
            if (!survive)
                phys.w = max(0.0, phys.w - max(0.0, _TreeB.x) * _DeltaTime);
            if (phys.y <= 0.01 || phys.z <= 0.01)
                phys.w = max(0.0, phys.w - max(0.0, _TreeB.x) * _DeltaTime);
            if (identity.z == FLORA_ROLE_TREE_ROOT && TreeTouchesAir(cell))
                phys.w = max(0.0, phys.w - max(0.0, _TreeH.w) * _DeltaTime);
            if (phys.w <= 0.02) identity.y = FLORA_STAGE_DEAD;
        }
        else if (phys.y <= 0.01 || phys.z <= 0.01)
        {
            phys.x = max(0.0, phys.x - _FloraB.z * _DeltaTime);
            if (phys.x <= 0.02) identity.y = FLORA_STAGE_DEAD;
        }
        else
        {
            phys.x = saturate(phys.x + _FloraB.y * phys.y * _DeltaTime);
        }

        if (identity.x == FLORA_ARCHETYPE_ALGAE)
            phys.x = saturate(phys.x - FloraFragmentAmount(cell));

        if (identity.x == FLORA_ARCHETYPE_GRASS
            && identity.y == FLORA_STAGE_JUVENILE
            && phys.x >= _GrassE.z)
            identity.y = FLORA_STAGE_MATURE;
    }

    _FloraWrite[uint3((uint2)cell, FLORA_PHYSIOLOGY_SLICE)] = phys;
    _FloraWrite[uint3((uint2)cell, FLORA_IDENTITY_SLICE)] = float4(identity);
    _FloraWrite[uint3((uint2)cell, FLORA_TOPOLOGY_SLICE)] = float4(topo);
    _FloraWrite[uint3((uint2)cell, FLORA_GENOME_SLICE)] = asfloat(genome);
    _FloraWrite[uint3((uint2)cell, FLORA_PROPAGULE_SLICE)] = prop;

    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);

    float incoming = 0.0;
    if (IsFloraCarrier(material))
    {
        int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 neighbor = cell + offsets[i];
            if (neighbor.y < 0 || neighbor.y >= _GridSize.y) continue;
            neighbor = C(neighbor);
            float frag = FloraFragmentAmount(neighbor);
            if (frag <= 1e-8) continue;
            incoming += frag / (float)max(1, CountCarrierNeighbors(neighbor));
        }
    }
    life.x = max(0.0, life.x + incoming);
    prop.x = max(0.0, prop.x + incoming);
    _FloraWrite[uint3((uint2)cell, FLORA_PROPAGULE_SLICE)] = prop;

    float4 propLoad = _PropaguleRead.Load(int4(cell, PROPAGULE_LOAD_SLICE, 0));
    uint4 propGenome = asuint(_PropaguleRead.Load(int4(cell, PROPAGULE_GENOME_SLICE, 0)));
    propLoad.x = max(0.0, propLoad.x + incoming);
    _PropaguleWrite[uint3((uint2)cell, PROPAGULE_LOAD_SLICE)] = propLoad;
    _PropaguleWrite[uint3((uint2)cell, PROPAGULE_GENOME_SLICE)] = asfloat(propGenome);

    if (identity.x == FLORA_ARCHETYPE_ALGAE)
        WriteLifeGenome(_LifeGenomeWrite, cell, float4(life.x, saturate(phys.x), phys.z, phys.w), genome);
    else
        WriteLifeGenome(_LifeGenomeWrite, cell, life, SampleGenome(_LifeGenomeRead, cell));
}

// -------------------------------------------------------------------------
// 4. CLEAR FLORA CLAIMS
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void ClearFloraClaims(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    _FloraClaimsWrite[id.xy] = FLORA_CLAIM_EMPTY;
}

// -------------------------------------------------------------------------
// 5. CLAIM GROWTH
// Apical branching, root growth, and flower drop claims.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void ClaimGrowth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    float4 phys = SampleFloraPhysiology(_FloraRead, cell);
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    uint4 topo = SampleFloraTopology(_FloraRead, cell);
    uint4 genome = SampleFloraGenome(_FloraRead, cell);
    float nutrient = SampleFloraPropagule(_FloraRead, cell).y;

    if (TreeLiving(identity))
    {
        int2 anchor = TreeAnchorCell(cell, identity, topo);
        int height = TreeColumnHeight(anchor);
        int2 apical = height <= 0 ? anchor : int2(anchor.x, anchor.y + height);
        bool afford = TreeCanAfford(phys, nutrient);
        bool rolled = TreeGrowthRoll(cell, genome);
        bool shootNiche = TreeGrowthNiche(cell, anchor, true);
        bool rootNiche = TreeGrowthNiche(anchor, anchor, false);
        bool claimed = false;

        if (all(cell == apical) && afford && rolled && shootNiche)
        {
            int sprout = clamp((int)round(_TreeF.x), 1, 8);
            int cap = TreeCrownCap(genome);
            if (height < sprout && cell.y + 1 < _GridSize.y)
                claimed = TreeEmitOpen(cell + int2(0, 1), cell);
            else if (height == sprout && !TreeHasLateralLeaf(anchor, height))
            {
                int dir = TreeWindDir(cell, genome);
                claimed = TreeEmitOpen(C(cell + int2(dir, 0)), cell);
                if (!claimed) claimed = TreeEmitOpen(C(cell + int2(-dir, 0)), cell);
            }

            // One claim per tip. If the inverted-L leaf is already placed, or both
            // sides are blocked, keep extending the shoot up to the crown cap.
            if (!claimed && height >= sprout && height < cap && cell.y + 1 < _GridSize.y)
                claimed = TreeEmitOpen(cell + int2(0, 1), cell);
        }

        if (!claimed && identity.z == FLORA_ROLE_TREE_TRUNK && !all(cell == apical) && afford && rolled && shootNiche)
        {
            int budget = TreeSaplingBranchCount(genome, (int)round(_TreeI.w), (int)round(_TreeJ.x));
            int count = TreeBranchCount(anchor, height);
            int sapling = clamp((int)round(_TreeF.y), 1, 48);
            int stride = max(1, sapling / (budget + 1));
            int slot = (count + 1) * stride;
            if (count < budget && cell.y == anchor.y + slot)
            {
                int dir = TreeWindDir(cell, genome);
                claimed = TreeEmitOpen(C(cell + int2(dir, 0)), cell);
                if (!claimed) claimed = TreeEmitOpen(C(cell + int2(-dir, 0)), cell);
            }
        }

        if (!claimed && identity.z == FLORA_ROLE_TREE_BRANCH && afford && rolled && shootNiche && !TreeHasLeafChild(cell))
        {
            int2 parent = ParentCell(topo);
            int dir = parent.y >= 0 ? (TreeWrappedDx(parent, cell) >= 0 ? 1 : -1) : TreeWindDir(cell, genome);
            claimed = TreeEmitOpen(C(cell + int2(dir, 0)), cell);
        }

        if (!claimed && identity.z == FLORA_ROLE_TREE_ROOT && !all(cell == apical) && afford && rolled && rootNiche)
        {
            int budget = max(1, TreeRootForkBudget(genome));
            int depth = TreeRootDepth(anchor);
            int2 rootTip = depth <= 0 ? anchor : int2(anchor.x, anchor.y - depth);
            if (depth < budget && all(cell == rootTip) && cell.y > 0)
            {
                int2 down = cell + int2(0, -1);
                if (IsTreeHabitat(M(down)))
                    claimed = TreeEmit(down, cell);
            }
            if (!claimed && (identity.w & FLORA_FLAG_ANCHOR) != 0u && height >= TreeCrownCap(genome))
            {
                int width = TreeTrunkWidth(anchor);
                int maxWidth = clamp((int)round(_TreeF.w), 1, 8);
                if (width < maxWidth)
                {
                    int dir = TreeWindDir(cell, genome);
                    claimed = TreeEmitOpen(C(cell + int2(dir, 0)), cell);
                    if (!claimed) claimed = TreeEmitOpen(C(cell + int2(-dir, 0)), cell);
                }
            }
        }
    }
    // Grass flower drop claim (drops detritus on soil):
    else if (identity.x == FLORA_ARCHETYPE_GRASS)
    {
        if (identity.y == FLORA_STAGE_DEAD || (identity.w & FLORA_FLAG_SHED) != 0u)
        {
            uint packed = PackFaunaCell(cell, _GridSize);
            uint original;
            InterlockedMin(_FloraClaimsWrite[cell], packed, original);
        }
    }
}

// -------------------------------------------------------------------------
// 6. APPLY FLORA WORLD & STATE
// Material transitions, growth resolution, wood conversion, detritus drop.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void ApplyFloraWorld(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = Eco(cell);
    float4 combustion = Comb(cell);
    float4 life = SampleLife(_LifeGenomeRead, cell);
    uint4 genome = SampleGenome(_LifeGenomeRead, cell);
    float4 phys = SampleFloraPhysiology(_FloraRead, cell);
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    HydrateAlgae(cell, phys, identity, genome);
    uint claim = _FloraClaims.Load(int3(cell, 0));

    // Handle growth claim winning at this cell:
    if (claim != FLORA_CLAIM_EMPTY && identity.x == FLORA_ARCHETYPE_NONE)
    {
        int2 parentCell = UnpackFaunaCell(claim, _GridSize);
        uint4 pIdentity = SampleFloraIdentity(_FloraRead, parentCell);

        if (pIdentity.x == FLORA_ARCHETYPE_TREE)
        {
            uint4 pTopo = SampleFloraTopology(_FloraRead, parentCell);
            uint role = TreeGrowthRole(cell, parentCell, pIdentity, pTopo);
            if (role != FLORA_ROLE_TREE_ROOT)
                material = TreeBodyMaterial(role, 0u, material);
        }
    }

    // Material updates & mortality:
    if (identity.x == FLORA_ARCHETYPE_TREE)
    {
        uint4 treeTopo = SampleFloraTopology(_FloraRead, cell);
        bool shed = (identity.w & FLORA_FLAG_SHED) != 0u;
        bool dead = identity.y == FLORA_STAGE_DEAD;
        bool leafy = identity.z == FLORA_ROLE_TREE_LEAF || identity.z == FLORA_ROLE_TREE_STEM;
        bool present = TreeBodyPresent(material, identity.z, identity.w);
        if (!present && !dead && !shed)
        {
            // Fauna, fire, or burial already removed the body. Do not write it back.
        }
        else if ((shed || (dead && leafy)) && (material == TREE_LEAF_ID || material == TREE_WOOD_ID))
        {
            material = MATERIAL_DETRITUS;
            aux = SeedDetritusAux(aux);
        }
        else if (dead && (float)treeTopo.w > _TreeI.y && (material == TREE_LEAF_ID || material == TREE_WOOD_ID))
        {
            material = MATERIAL_DETRITUS;
            aux = SeedDetritusAux(aux);
        }
        else if (present)
        {
            material = TreeBodyMaterial(identity.z, identity.w, material);
        }
    }
    else if (identity.x == FLORA_ARCHETYPE_ALGAE)
    {
        if (identity.y == FLORA_STAGE_DEAD)
        {
            if (material == FLORA_ALGAE_ID)
            {
                material = MATERIAL_DETRITUS;
                aux = SeedDetritusAux(aux);
                life = 0.0;
                genome = 0u;
            }
        }
        else
        {
            material = FLORA_ALGAE_ID;
            life = float4(life.x, saturate(phys.x), phys.z, phys.w);
            genome.w = PackFloraMeta(identity.y, identity.z, FloraLineage(genome), identity.w);
        }
    }
    else if (identity.x == FLORA_ARCHETYPE_GRASS)
    {
        if (identity.y == FLORA_STAGE_DEAD)
        {
            aux.z = max(aux.z, saturate(_GrassI.z));
        }
    }

    WriteWorld(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void ApplyFloraState(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    uint material = M(cell);
    float4 phys = SampleFloraPhysiology(_FloraRead, cell);
    uint4 identity = SampleFloraIdentity(_FloraRead, cell);
    uint4 topo = SampleFloraTopology(_FloraRead, cell);
    uint4 genome = SampleFloraGenome(_FloraRead, cell);
    float4 prop = SampleFloraPropagule(_FloraRead, cell);
    HydrateAlgae(cell, phys, identity, genome);

    uint claim = _FloraClaims.Load(int3(cell, 0));

    // Handle growth claim winning at this cell:
    if (claim != FLORA_CLAIM_EMPTY && identity.x == FLORA_ARCHETYPE_NONE)
    {
        int2 parentCell = UnpackFaunaCell(claim, _GridSize);
        uint4 pIdentity = SampleFloraIdentity(_FloraRead, parentCell);
        float4 pPhys = SampleFloraPhysiology(_FloraRead, parentCell);
        uint4 pTopo = SampleFloraTopology(_FloraRead, parentCell);
        uint4 pGenome = SampleFloraGenome(_FloraRead, parentCell);

        if (TreeLiving(pIdentity))
        {
            float cost = max(0.0, _TreeE.z);
            uint role = TreeGrowthRole(cell, parentCell, pIdentity, pTopo);
            uint anchor = TreeAnchorPack(parentCell, pIdentity, pTopo);
            identity = uint4(FLORA_ARCHETYPE_TREE, FLORA_STAGE_SPROUT, role, 0u);
            topo = uint4(claim, anchor, 0u, 0u);
            genome = pGenome;
            genome.w = PackTreeMeta(FLORA_STAGE_SPROUT, TreeGeneration(pGenome), TreeLineage(pGenome), TreeToxinDose(pGenome));
            phys = float4(0.2, cost * 0.25, cost * 0.125, pPhys.w);
            prop = float4(0.0, cost * 0.125, 0.0, 0.0);
        }
    }

    bool tree = identity.x == FLORA_ARCHETYPE_TREE;
    bool created = tree && claim != FLORA_CLAIM_EMPTY && SampleFloraIdentity(_FloraRead, cell).x == FLORA_ARCHETYPE_NONE;
    bool shed = tree && (identity.w & FLORA_FLAG_SHED) != 0u;
    bool dead = tree && identity.y == FLORA_STAGE_DEAD;
    bool leafy = identity.z == FLORA_ROLE_TREE_LEAF || identity.z == FLORA_ROLE_TREE_STEM;

    if (tree && !created && !shed && !TreeBodyPresent(material, identity.z, identity.w))
    {
        ClearFlora(_FloraWrite, cell);
        return;
    }

    if (tree && (shed || (dead && leafy) || (dead && (float)topo.w > _TreeI.y)))
    {
        ClearFlora(_FloraWrite, cell);
        return;
    }

    if (!tree && (identity.y == FLORA_STAGE_DEAD || (identity.w & FLORA_FLAG_SHED) != 0u))
    {
        ClearFlora(_FloraWrite, cell);
        return;
    }

    if (tree && !dead && !shed)
    {
        int2 anchor = TreeAnchorCell(cell, identity, topo);
        int height = TreeColumnHeight(anchor);
        int sapling = clamp((int)round(_TreeF.y), 1, 48);
        int cap = TreeCrownCap(genome);
        uint stage = FLORA_STAGE_SPROUT;
        if (height >= cap) stage = FLORA_STAGE_MATURE;
        else if (height >= sapling) stage = FLORA_STAGE_VEGETATIVE;
        identity.y = stage;
        if (identity.z == FLORA_ROLE_TREE_STEM && height >= sapling)
            identity.z = FLORA_ROLE_TREE_TRUNK;
        genome.w = PackTreeMeta(stage, TreeGeneration(genome), TreeLineage(genome), TreeToxinDose(genome));

        bool anchorCell = (identity.w & FLORA_FLAG_ANCHOR) != 0u;
        if (!anchorCell)
        {
            int2 parent = ParentCell(topo);
            bool parentAlive = parent.y >= 0 && parent.y < _GridSize.y && TreeLiving(SampleFloraIdentity(_FloraRead, parent));
            topo.z = parentAlive ? 0u : topo.z + 1u;
            if ((float)topo.z > _TreeI.z) identity.y = FLORA_STAGE_DEAD;
        }

        if (!created && identity.y != FLORA_STAGE_DEAD)
        {
            float cost = max(0.0, _TreeE.z);
            if (cost > 0.0)
            {
                int pays = 0;
                uint self = PackFaunaCell(cell, _GridSize);
                int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
                [unroll]
                for (int i = 0; i < 4; i++)
                {
                    int2 n = cell + offsets[i];
                    if (n.y < 0 || n.y >= _GridSize.y) continue;
                    n = C(n);
                    if (_FloraClaims.Load(int3(n, 0)) == self) pays++;
                }
                if (pays > 0)
                {
                    phys.y = max(0.0, phys.y - cost * (float)pays);
                    phys.z = max(0.0, phys.z - cost * 0.5 * (float)pays);
                    prop.y = max(0.0, prop.y - cost * 0.5 * (float)pays);
                }
            }
        }
    }

    if (tree && identity.y == FLORA_STAGE_DEAD)
        topo.w += 1u;

    // Grass left in air, rock, or a buried grain does not survive the move.
    if (identity.x == FLORA_ARCHETYPE_GRASS
        && identity.y != FLORA_STAGE_EMPTY
        && identity.y != FLORA_STAGE_DEAD
        && !IsGrassExposedAnchor(cell.y, _GridSize.y, material, D(M(int2(cell.x, cell.y + 1))).metadata.x))
    {
        ClearFlora(_FloraWrite, cell);
        return;
    }

    _FloraWrite[uint3((uint2)cell, FLORA_PHYSIOLOGY_SLICE)] = phys;
    _FloraWrite[uint3((uint2)cell, FLORA_IDENTITY_SLICE)] = float4(identity);
    _FloraWrite[uint3((uint2)cell, FLORA_TOPOLOGY_SLICE)] = float4(topo);
    _FloraWrite[uint3((uint2)cell, FLORA_GENOME_SLICE)] = asfloat(genome);
    _FloraWrite[uint3((uint2)cell, FLORA_PROPAGULE_SLICE)] = prop;
}

bool SameCarrierClass(uint a, uint b)
{
    return (IsSporeAirCarrier(a) && IsSporeAirCarrier(b)) || (IsSporeWaterCarrier(a) && IsSporeWaterCarrier(b));
}

float4 CarrierFaceMask(int2 cell, uint material)
{
    int2 leftCell = C(cell + int2(-1, 0));
    int2 rightCell = C(cell + int2(1, 0));
    int2 downCell = C(cell + int2(0, -1));
    int2 upCell = C(cell + int2(0, 1));
    return float4(
        SameCarrierClass(material, M(leftCell)) ? 1.0 : 0.0,
        SameCarrierClass(material, M(rightCell)) ? 1.0 : 0.0,
        (cell.y > 0 && SameCarrierClass(material, M(downCell))) ? 1.0 : 0.0,
        (cell.y < _GridSize.y - 1 && SameCarrierClass(material, M(upCell))) ? 1.0 : 0.0);
}

float4 SporeFaceFlux(float2 flow, float mass, float advectionRate, float4 validFaces, float tangentialWeight)
{
    if (mass <= 1e-8 || advectionRate <= 1e-8)
        return 0.0;

    float left = max(0.0, -flow.x) * validFaces.x * tangentialWeight;
    float right = max(0.0, flow.x) * validFaces.y * tangentialWeight;
    float down = max(0.0, -flow.y) * validFaces.z;
    float up = max(0.0, flow.y) * validFaces.w;
    float weightSum = left + right + down + up;
    if (weightSum <= 1e-8)
        return 0.0;

    float cfl = saturate(_WeatherF.w);
    if (cfl <= 1e-8) cfl = 0.4;
    float moveFraction = min(cfl, weightSum * advectionRate * _DeltaTime);
    float movable = mass * moveFraction;
    float inv = 1.0 / weightSum;
    return float4(movable * left * inv, movable * right * inv, movable * down * inv, movable * up * inv);
}

// -------------------------------------------------------------------------
// 7. PROPAGULE TRANSPORT
// Advection of spores, pollen, and seeds via atmospheric winds and water flows.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void PropaguleTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    float4 prop = _PropaguleRead.Load(int4(cell, PROPAGULE_LOAD_SLICE, 0));
    uint4 propGenome = asuint(_PropaguleRead.Load(int4(cell, PROPAGULE_GENOME_SLICE, 0)));

    float2 flow = F(cell);
    float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);

    // Wind and water advection:
    float4 outFlux = SporeFaceFlux(flow, prop.x, _FloraA.x, CarrierFaceMask(cell, M(cell)), tanW);
    prop.x = max(0.0, prop.x - (outFlux.x + outFlux.y + outFlux.z + outFlux.w));

    // Gravity settling of seeds & spores onto surface:
    float settleRate = _FloraA.w;
    if (settleRate > 0.0) prop.xz = max(0.0, prop.xz - prop.xz * saturate(settleRate * _DeltaTime));

    _PropaguleWrite[uint3((uint2)cell, PROPAGULE_LOAD_SLICE)] = prop;
    _PropaguleWrite[uint3((uint2)cell, PROPAGULE_GENOME_SLICE)] = asfloat(propGenome);
}

// -------------------------------------------------------------------------
// 8. PROPAGULE GERMINATION
// Seeds and spores landing on viable soil/water germinate into new organisms.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void PropaguleGerminate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    [unroll]
    for (uint s = 0u; s < FLORA_SLICE_COUNT; s++)
        _FloraWrite[uint3((uint2)cell, s)] = _FloraRead[uint3((uint2)cell, s)];

    float4 prop = _PropaguleRead.Load(int4(cell, PROPAGULE_LOAD_SLICE, 0));
    uint4 propGenome = asuint(_PropaguleRead.Load(int4(cell, PROPAGULE_GENOME_SLICE, 0)));

    uint material = M(cell);
    float4 state = S(cell);
    float4 aux = A(cell);

    uint4 identity = SampleFloraIdentity(_FloraRead, cell);

    if (identity.x == FLORA_ARCHETYPE_NONE)
    {
        // Grass seed germination on exposed soil:
        if (IsGrassSoilAnchor(material) && prop.z > 0.08)
        {
            identity.x = FLORA_ARCHETYPE_GRASS;
            identity.y = FLORA_STAGE_JUVENILE;
            identity.z = FLORA_ROLE_GRASS_TURF;
            identity.w = FLORA_FLAG_ANCHOR;

            float4 phys = float4(_GrassH.z, _GrassH.w, 0.5, 0.0); // Initial biomass, energy, water
            uint4 genome = propGenome.x != 0u ? propGenome : RandomFloraGenome((uint2)cell, _Seed, _Tick);

            _FloraWrite[uint3((uint2)cell, FLORA_PHYSIOLOGY_SLICE)] = phys;
            _FloraWrite[uint3((uint2)cell, FLORA_IDENTITY_SLICE)] = float4(identity);
            _FloraWrite[uint3((uint2)cell, FLORA_TOPOLOGY_SLICE)] = float4(0.0, 0.0, 7.0, 0.0);
            _FloraWrite[uint3((uint2)cell, FLORA_GENOME_SLICE)] = asfloat(genome);
            _FloraWrite[uint3((uint2)cell, FLORA_PROPAGULE_SLICE)] = 0.0;
        }
        // Algae spore germination in water or wet substrate:
        else if (IsFloraSporeDepositTarget(material) && prop.x > 0.08 && MoistureOf(state, aux) > 0.15)
        {
            identity.x = FLORA_ARCHETYPE_ALGAE;
            identity.y = FLORA_STAGE_ACTIVE;
            identity.z = FLORA_ROLE_ALGAE_FILM;

            float4 phys = float4(0.35, 0.4, 0.7, 0.1);
            uint4 genome = propGenome.x != 0u ? propGenome : RandomFloraGenome((uint2)cell, _Seed, _Tick);

            _FloraWrite[uint3((uint2)cell, FLORA_PHYSIOLOGY_SLICE)] = phys;
            _FloraWrite[uint3((uint2)cell, FLORA_IDENTITY_SLICE)] = float4(identity);
            _FloraWrite[uint3((uint2)cell, FLORA_TOPOLOGY_SLICE)] = 0.0;
            _FloraWrite[uint3((uint2)cell, FLORA_GENOME_SLICE)] = asfloat(genome);
            _FloraWrite[uint3((uint2)cell, FLORA_PROPAGULE_SLICE)] = 0.0;
        }
    }
}

// -------------------------------------------------------------------------
// 9. SEED FLORA (Worldgen initialization)
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void SeedFlora(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);

    ClearFlora(_FloraWrite, cell);

    if (material == FLORA_ALGAE_ID)
    {
        uint4 identity = uint4(FLORA_ARCHETYPE_ALGAE, FLORA_STAGE_ACTIVE, FLORA_ROLE_ALGAE_FILM, 0u);
        float4 phys = float4(0.45, 0.5, 0.8, 0.1);
        uint4 genome = RandomFloraGenome((uint2)cell, _Seed, _Tick);
        WriteFlora(_FloraWrite, cell, phys, identity, 0.0, genome, 0.0);
    }
    else if (IsGrassSoilAnchor(material))
    {
        float h = HashCell(cell, 47u);
        if (h < 0.45)
        {
            uint4 identity = uint4(FLORA_ARCHETYPE_GRASS, FLORA_STAGE_MATURE, FLORA_ROLE_GRASS_TURF, FLORA_FLAG_ANCHOR);
            float4 phys = float4(_GrassH.z, _GrassH.w, 0.6, 0.2);
            uint4 genome = RandomFloraGenome((uint2)cell, _Seed, _Tick);
            uint4 topo = uint4(0u, 0u, 7u, 0u); // Root mask taps 3 neighbors
            WriteFlora(_FloraWrite, cell, phys, identity, topo, genome, 0.0);
        }
    }
}

// -------------------------------------------------------------------------
// 10. PAINT FLORA (Interactive Brush)
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void PaintFlora(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;

    [unroll]
    for (uint s = 0u; s < FLORA_SLICE_COUNT; s++)
        _FloraWrite[uint3((uint2)cell, s)] = _FloraRead[uint3((uint2)cell, s)];

    int2 center = int2(round(_FloraPaintCell.x), round(_FloraPaintCell.y));
    int radius = max(0, (int)round(_FloraPaintCell.z));
    uint archetype = (uint)round(_FloraPaintCell.w);

    int dx = abs(cell.x - center.x);
    if (dx > _GridSize.x / 2) dx = _GridSize.x - dx;
    int dy = abs(cell.y - center.y);

    if (dx * dx + dy * dy <= radius * radius)
    {
        uint4 genome = RandomFloraGenome((uint2)cell, _Seed, _Tick);
        if (archetype == FLORA_ARCHETYPE_ALGAE)
        {
            uint4 identity = uint4(FLORA_ARCHETYPE_ALGAE, FLORA_STAGE_ACTIVE, FLORA_ROLE_ALGAE_FILM, 0u);
            float4 phys = float4(0.5, 0.6, 0.8, 0.2);
            genome.w = PackFloraMeta(FLORA_STAGE_ACTIVE, 0u, FloraLineage(genome), 0u);
            WriteFlora(_FloraWrite, cell, phys, identity, 0.0, genome, 0.0);
        }
        else if (archetype == FLORA_ARCHETYPE_GRASS && (IsGrassSoilAnchor(M(cell)) || IsTreeHabitat(M(cell))))
        {
            uint4 identity = uint4(FLORA_ARCHETYPE_GRASS, FLORA_STAGE_MATURE, FLORA_ROLE_GRASS_TURF, FLORA_FLAG_ANCHOR);
            float4 phys = float4(0.5, 0.6, 0.7, 0.3);
            uint4 topo = uint4(0u, 0u, 7u, 0u);
            genome.w = PackFloraMeta(FLORA_STAGE_MATURE, 0u, FloraLineage(genome), 0u);
            WriteFlora(_FloraWrite, cell, phys, identity, topo, genome, 0.0);
        }
        else if (archetype == FLORA_ARCHETYPE_TREE && (IsTreeHabitat(M(cell)) || IsOpenHabitat(M(cell))))
        {
            bool onSoil = IsTreeHabitat(M(cell));
            uint role = onSoil ? FLORA_ROLE_TREE_ROOT : FLORA_ROLE_TREE_STEM;
            uint4 identity = uint4(FLORA_ARCHETYPE_TREE, FLORA_STAGE_SPROUT, role, FLORA_FLAG_ANCHOR);
            float4 phys = float4(0.35, saturate(_TreeG.x), saturate(_TreeG.y), saturate(_TreeG.w));
            float4 prop = float4(0.0, saturate(_TreeG.z), 0.0, 0.0);
            uint packed = PackFaunaCell(cell, _GridSize);
            uint4 topo = uint4(packed, packed, 0u, 0u);
            genome = RandomTreeGenome((uint2)cell, _Seed, _Tick);
            WriteFlora(_FloraWrite, cell, phys, identity, topo, genome, prop);
        }
    }
}

// -------------------------------------------------------------------------
// 11. FLORA MIGRATION
// Dual-pull pole drift and wind/rain shear. World+LifeGenome first (8 UAVs),
// then Flora slices follow from the same source cells.
// -------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void FloraMigration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material;
    float4 state;
    float2 flow;
    float4 aux;
    float4 ecology;
    float4 combustion;
    float4 life;
    uint4 genome;
    CopyWorld(FloraMigrationSource(cell), material, state, flow, aux, ecology, combustion, life, genome);
    WriteWorld(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void FloraMigrationFollow(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    int2 source = FloraMigrationSource(cell);
    float4 phys = SampleFloraPhysiology(_FloraRead, source);
    uint4 identity = SampleFloraIdentity(_FloraRead, source);
    uint4 topo = SampleFloraTopology(_FloraRead, source);
    uint4 genome = SampleFloraGenome(_FloraRead, source);
    float4 prop = SampleFloraPropagule(_FloraRead, source);
    HydrateAlgae(source, phys, identity, genome);
    WriteFlora(_FloraWrite, cell, phys, identity, topo, genome, prop);
}
