#pragma kernel MargolusPhaseEven
#pragma kernel MargolusPhaseOdd
#pragma target 5.1

#include "../../Shaders/Simulation/Common/MargolusCommon.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
Texture2DArray<float4> _GrassRead;
Texture2DArray<float4> _TreeRead;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;      // x = gravityStrength
float4 _MargolusParams; // x = gravityBias, y = reposeFriction, z = metricEnable, w = fluidLevelingBias
float4 _MargolusFlags;  // x = useMargolus, y = enableFluids, z = enableErosionDetachment, w = reserved
float4 _GrassI;         // root cohesion
float4 _TreeH;          // root cohesion

MaterialGpuData Mat(uint id) { return _MaterialDefinitions[min(id, 255u)]; }

MargolusCell LoadMargolusCell(int2 cell)
{
    MargolusCell c;
    c.material = _MaterialRead.Load(int3(cell, 0));
    c.state = _StateRead.Load(int3(cell, 0));
    c.flow = _FlowRead.Load(int3(cell, 0));
    c.aux = _AuxRead.Load(int3(cell, 0));
    c.shade = _ShadeRead.Load(int3(cell, 0));
    c.ecology = _EcologyRead.Load(int3(cell, 0));
    c.combustion = _CombustionRead.Load(int3(cell, 0));
    c.life = SampleLife(_LifeGenomeRead, cell);
    c.genome = SampleGenome(_LifeGenomeRead, cell);
    return c;
}

void WriteMargolusCell(int2 cell, MargolusCell c)
{
    _MaterialWrite[cell] = c.material;
    _StateWrite[cell] = SafeFinite4(c.state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(c.flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(c.aux, 0.0), 0.0);
    _ShadeWrite[cell] = c.shade;
    _EcologyWrite[cell] = SanitizeEcology(c.ecology);
    _CombustionWrite[cell] = SanitizeCombustion(c.combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, c.life, c.genome);
}

float MargolusRootCohesion(int2 cell)
{
    return (float)CountGrassRootTapsOnCell(_GrassRead, cell, _GridSize) * saturate(_GrassI.y)
        + (float)CountTreeRootsOnCell(_TreeRead, cell, _GridSize) * saturate(_TreeH.y);
}

void SwapCells(inout MargolusCell a, inout MargolusCell b)
{
    MargolusCell tmp = a;
    a = b;
    b = tmp;
}

void StepMargolusBlock(int2 p0, int2 p1, int2 p2, int2 p3)
{
    MargolusCell c0 = LoadMargolusCell(p0);
    MargolusCell c1 = LoadMargolusCell(p1);
    MargolusCell c2 = LoadMargolusCell(p2);
    MargolusCell c3 = LoadMargolusCell(p3);

    MaterialGpuData d0 = Mat(c0.material);
    MaterialGpuData d1 = Mat(c1.material);
    MaterialGpuData d2 = Mat(c2.material);
    MaterialGpuData d3 = Mat(c3.material);

    bool pin0 = IsMargolusPinned(c0, d0);
    bool pin1 = IsMargolusPinned(c1, d1);
    bool pin2 = IsMargolusPinned(c2, d2) || (MargolusRootCohesion(p2) > 0.65);
    bool pin3 = IsMargolusPinned(c3, d3) || (MargolusRootCohesion(p3) > 0.65);

    float rho0 = MargolusEffectiveDensity(c0, d0);
    float rho1 = MargolusEffectiveDensity(c1, d1);
    float rho2 = MargolusEffectiveDensity(c2, d2);
    float rho3 = MargolusEffectiveDensity(c3, d3);

    float gravity = max(0.0, _Mechanics.x) * max(0.01, _MargolusParams.x);
    if (gravity <= 1e-4)
    {
        WriteMargolusCell(p0, c0);
        WriteMargolusCell(p1, c1);
        WriteMargolusCell(p2, c2);
        WriteMargolusCell(p3, c3);
        return;
    }

    // 1. Vertical drops (gravity)
    bool leftDrop = !pin0 && !pin2 && (rho2 > rho0 + 0.05);
    bool rightDrop = !pin1 && !pin3 && (rho3 > rho1 + 0.05);

    if (leftDrop || rightDrop)
    {
        if (leftDrop) SwapCells(c0, c2);
        if (rightDrop) SwapCells(c1, c3);
    }
    else
    {
        // 2. Diagonal slides (repose failure / talus slope)
        float metric = _MargolusParams.z > 0.5 ? MargolusMetricRatio(p0.y, _GridSize) : 1.0;
        float friction = max(0.1, _MargolusParams.y);

        // Slide down-right: cell 2 into position 1
        bool slideRight = false;
        if (!pin1 && !pin2 && (rho2 > rho1 + 0.05))
        {
            bool supportedBelow = pin0 || (rho0 >= rho2 * 0.6);
            if (supportedBelow)
            {
                if (IsMargolusFluid(c2.material, d2))
                {
                    slideRight = true;
                }
                else if (IsMargolusGranular(c2.material, d2))
                {
                    float tanRepose = MargolusTanRepose(c2.material, d2) * friction;
                    if (tanRepose * metric <= 1.05)
                        slideRight = (MargolusRootCohesion(p2) < 0.35);
                }
            }
        }

        // Slide down-left: cell 3 into position 0
        bool slideLeft = false;
        if (!pin0 && !pin3 && (rho3 > rho0 + 0.05))
        {
            bool supportedBelow = pin1 || (rho1 >= rho3 * 0.6);
            if (supportedBelow)
            {
                if (IsMargolusFluid(c3.material, d3))
                {
                    slideLeft = true;
                }
                else if (IsMargolusGranular(c3.material, d3))
                {
                    float tanRepose = MargolusTanRepose(c3.material, d3) * friction;
                    if (tanRepose * metric <= 1.05)
                        slideLeft = (MargolusRootCohesion(p3) < 0.35);
                }
            }
        }

        if (slideRight && !slideLeft)
        {
            SwapCells(c1, c2);
        }
        else if (slideLeft && !slideRight)
        {
            SwapCells(c0, c3);
        }
        else if (slideRight && slideLeft)
        {
            // Symmetric tie-breaker: hash determines direction
            uint hashVal = (uint)p0.x * 73856093u ^ (uint)p0.y * 19349663u ^ (uint)_Tick * 83492791u;
            if (Hash01(hashVal) < 0.5)
                SwapCells(c1, c2);
            else
                SwapCells(c0, c3);
        }
        else if (_MargolusParams.w > 0.0)
        {
            // 3. Fluid horizontal leveling / wind-driven surface flow
            if (IsMargolusFluid(c0.material, d0) && c1.material == 1u && !pin1 && c0.flow.x > 0.45)
                SwapCells(c0, c1);
            else if (IsMargolusFluid(c1.material, d1) && c0.material == 1u && !pin0 && c1.flow.x < -0.45)
                SwapCells(c0, c1);
        }
    }

    WriteMargolusCell(p0, c0);
    WriteMargolusCell(p1, c1);
    WriteMargolusCell(p2, c2);
    WriteMargolusCell(p3, c3);
}

[numthreads(8, 8, 1)]
void MargolusPhaseEven(uint3 id : SV_DispatchThreadID)
{
    int numBlocksX = _GridSize.x / 2;
    int numBlocksY = _GridSize.y / 2;
    if (id.x >= (uint)numBlocksX || id.y >= (uint)numBlocksY) return;

    int bx = (int)id.x;
    int by = (int)id.y;

    int x0 = 2 * bx;
    int x1 = (x0 + 1) % _GridSize.x;
    int y0 = 2 * by;
    int y1 = y0 + 1;

    if (y1 >= _GridSize.y)
    {
        WriteMargolusCell(int2(x0, y0), LoadMargolusCell(int2(x0, y0)));
        WriteMargolusCell(int2(x1, y0), LoadMargolusCell(int2(x1, y0)));
        return;
    }

    StepMargolusBlock(int2(x0, y0), int2(x1, y0), int2(x0, y1), int2(x1, y1));
}

[numthreads(8, 8, 1)]
void MargolusPhaseOdd(uint3 id : SV_DispatchThreadID)
{
    int numBlocksX = _GridSize.x / 2;
    int numBlocksY = _GridSize.y / 2;
    if (id.x >= (uint)numBlocksX || id.y >= (uint)numBlocksY) return;

    int bx = (int)id.x;
    int by = (int)id.y;

    int maxOddBlocksY = (_GridSize.y - 2) / 2;

    int x0 = (2 * bx + 1) % _GridSize.x;
    int x1 = (2 * bx + 2) % _GridSize.x;

    if (by < maxOddBlocksY)
    {
        int y0 = 2 * by + 1;
        int y1 = y0 + 1;
        StepMargolusBlock(int2(x0, y0), int2(x1, y0), int2(x0, y1), int2(x1, y1));
    }
    else if (by == maxOddBlocksY)
    {
        // Boundary passthrough for row 0 and row (Ny - 1)
        WriteMargolusCell(int2(x0, 0), LoadMargolusCell(int2(x0, 0)));
        WriteMargolusCell(int2(x1, 0), LoadMargolusCell(int2(x1, 0)));
        int topY = _GridSize.y - 1;
        WriteMargolusCell(int2(x0, topY), LoadMargolusCell(int2(x0, topY)));
        WriteMargolusCell(int2(x1, topY), LoadMargolusCell(int2(x1, topY)));
    }
}
