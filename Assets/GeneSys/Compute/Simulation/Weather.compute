#pragma kernel SolarAndWind
#pragma kernel WaterCycle

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<float4> _WaterRead;
RWTexture2D<float4> _WaterWrite;
RWTexture2D<float4> _Hydrostatic;
RWTexture2D<int> _MotionIntent;
RWTexture2D<float4> _WaterFlux;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _Phase;
float4 _Pressure;

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 W(int2 value) { return _WaterRead.Load(int3(C(value), 0)); }
float H(int2 value) { return _Hydrostatic[C(value)].x; }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

bool IsAtmosphereCell(int2 cell, uint material)
{
    float radius = Radius01(cell.y, _GridSize.y);
    return radius >= _AtmosphereStartRadius || D(material).metadata.x == 1.0;
}

float TotalP(int2 cell, float4 state)
{
    return max(0.0, H(cell)) + max(0.0, state.y);
}

void WriteCell(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 water)
{
    state.z = 0.0;
    aux.x = 0.0;
    aux.y = 0.0;
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _WaterWrite[cell] = SafeFinite4(max(water, 0.0), 0.0);
}

[numthreads(8, 8, 1)]
void SolarAndWind(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 water = W(cell);
    MaterialGpuData definition = D(material);
    float radius = Radius01(cell.y, _GridSize.y);

    float theta01 = (cell.x + 0.5) / _GridSize.x;
    float angle = (theta01 - _WeatherC.y) * 6.28318530718;
    float insolation = max(0.0, cos(angle));
    float exposure = smoothstep(_PlayableInnerRadius, _AtmosphereStartRadius, radius);
    float heating = insolation * _WeatherA.x * exposure / max(0.05, definition.transport.y);
    float cooling = (state.x - _WeatherA.y) * _WeatherA.z * (1.0 - insolation) * exposure * 0.01;
    state.x += (heating - cooling) * _DeltaTime;

    float pLeft = TotalP(cell + int2(-1, 0), S(cell + int2(-1, 0)));
    float pRight = TotalP(cell + int2(1, 0), S(cell + int2(1, 0)));
    float pBelow = cell.y > 0 ? TotalP(cell + int2(0, -1), S(cell + int2(0, -1))) : TotalP(cell, state);
    float pAbove = cell.y < _GridSize.y - 1 ? TotalP(cell + int2(0, 1), S(cell + int2(0, 1))) : TotalP(cell, state);
    float2 gradient = float2(pRight - pLeft, pAbove - pBelow) * 0.5;
    flow -= gradient * _WeatherA.w * _DeltaTime;
    flow *= saturate(1.0 - _WeatherB.x * _DeltaTime);
    state.y = min(_Pressure.w, max(0.0, state.y + (water.w * _WeatherC.x - state.y * 0.005) * _DeltaTime));

    WriteCell(cell, material, state, flow, aux, water);
}

[numthreads(8, 8, 1)]
void WaterCycle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 water = W(cell);
    float radius = Radius01(cell.y, _GridSize.y);
    bool atmosphere = IsAtmosphereCell(cell, material);
    float totalP = TotalP(cell, state);
    float boilT = PressureAdjustedBoil(100.0, totalP, _Phase.y);
    float latent = max(0.1, D(9u).mechanics.y);
    float heatCapacity = max(0.001, D(material).transport.y);

    if (water.x > 0.0 && state.x > 5.0 && !atmosphere)
    {
        float evaporation = min(water.x, _WeatherB.y * saturate((state.x - 5.0) / max(8.0, boilT)) * _DeltaTime);
        water.x -= evaporation;
        water.w += evaporation;
        state.x -= evaporation * latent / heatCapacity * 0.15;
        state.y = min(_Pressure.w, state.y + evaporation * _WeatherC.x * 0.25);
    }

    float altitudeCooling = saturate((radius - _AtmosphereStartRadius) / max(0.01, 1.0 - _AtmosphereStartRadius)) * 25.0;
    float dewPoint = min(boilT - 4.0, 18.0 - altitudeCooling);
    if (atmosphere && state.x < dewPoint && water.w > 0.02)
    {
        float condensation = min(water.w, _WeatherB.z * (dewPoint - state.x + 1.0) * 0.01 * _DeltaTime);
        water.w -= condensation;
        water.x += condensation;
        state.y = max(0.0, state.y - condensation * _WeatherC.x);
        state.x += condensation * latent / heatCapacity * 0.1;
    }

    WriteCell(cell, material, state, flow, aux, water);
}
