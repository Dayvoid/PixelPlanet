#pragma kernel AtmosphericForcing
#pragma kernel AtmosphericContinuity
#pragma kernel AtmosphericDynamics
#pragma kernel AtmosphericTransport
#pragma kernel WaterCycle

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _HydrologyB;
float4 _HydrologyC;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherD; // advectionRate, vaporDiffusionRate, atmosphericBuoyancy, humidityBuoyancy
float4 _WeatherE; // saturationCapacityScale, cloudPrecipitationThreshold, unused, unused
float4 _WeatherF; // surfaceAirHeatExchange, temperatureAdvectionRate, pressureCompressibility, atmosphericCflLimit
float4 _WeatherG; // surfaceAirTemperature, atmosphericLapseRate, unused, unused
float4 _EruptionA;
float4 _EruptionB;
float4 _MoistureErosion; // dryMoistureThreshold, moistureCohesionStrength, capillaryEvaporationFraction, unused

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 E(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

bool IsAtmosphereCell(int2 cell, uint material)
{
    float category = D(material).metadata.x;
    if (category == 1.0 || material == 11u) return true;
    return material == 0u && Radius01(cell.y, _GridSize.y) >= _AtmosphereStartRadius;
}

bool IsExposedSurface(int2 cell, uint material)
{
    uint above = M(cell + int2(0, 1));
    return D(above).metadata.x <= 1.0 && material != 1u && material != 0u && material != 11u;
}

bool IsOpenCarrier(uint material)
{
    return material == 0u || material == 1u || material == 11u || D(material).metadata.x == 1.0;
}

void Write(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
}

float AtmosphericVaporCapacity(float temperature, float radius, float pressure)
{
    float altitudeCooling = saturate((radius - _AtmosphereStartRadius) / max(0.01, 1.0 - _AtmosphereStartRadius));
    float thermal = saturate((temperature + 20.0) / 60.0);
    float pressureBoost = 1.0 + saturate(pressure) * 0.25;
    return max(0.01, _WeatherE.x * thermal * (1.0 - altitudeCooling * 0.65) * pressureBoost);
}

// CFL-capped face fluxes. Angular and radial weights contribute independently so
// dominant angular wind cannot starve radial lofting.
float4 DonorFaceFlux(float2 flow, float mass, float advectionRate, float4 validFaces, float tangentialWeight)
{
    if (mass <= 1e-8 || advectionRate <= 1e-8)
        return 0.0;

    float left = max(0.0, -flow.x) * validFaces.x * tangentialWeight;
    float right = max(0.0, flow.x) * validFaces.y * tangentialWeight;
    float down = max(0.0, -flow.y) * validFaces.z;
    float up = max(0.0, flow.y) * validFaces.w;
    float weightSum = left + right + down + up;
    if (weightSum <= 1e-8)
        return 0.0;

    float cfl = saturate(_WeatherF.w);
    float moveFraction = min(cfl, weightSum * advectionRate * _DeltaTime);
    float movable = mass * moveFraction;
    float inv = 1.0 / weightSum;
    return float4(movable * left * inv, movable * right * inv, movable * down * inv, movable * up * inv);
}

float DiffusiveExchange(float selfMass, float neighborMass, float diffusionRate)
{
    return (neighborMass - selfMass) * saturate(diffusionRate * _DeltaTime) * 0.25;
}

float4 AtmosphereFaceMask(int2 cell)
{
    int2 leftCell = C(cell + int2(-1, 0));
    int2 rightCell = C(cell + int2(1, 0));
    int2 downCell = C(cell + int2(0, -1));
    int2 upCell = C(cell + int2(0, 1));
    return float4(
        IsAtmosphereCell(leftCell, M(leftCell)) ? 1.0 : 0.0,
        IsAtmosphereCell(rightCell, M(rightCell)) ? 1.0 : 0.0,
        (cell.y > 0 && IsAtmosphereCell(downCell, M(downCell))) ? 1.0 : 0.0,
        (cell.y < _GridSize.y - 1 && IsAtmosphereCell(upCell, M(upCell))) ? 1.0 : 0.0);
}

[numthreads(8, 8, 1)]
void AtmosphericForcing(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    MaterialGpuData definition = D(material);
    float radius = Radius01(cell.y, _GridSize.y);
    bool atmosphere = IsAtmosphereCell(cell, material);

    float theta01 = (cell.x + 0.5) / _GridSize.x;
    float angle = (theta01 - _WeatherC.y) * 6.28318530718;
    float insolation = max(0.0, cos(angle));
    float exposure = smoothstep(_PlayableInnerRadius, _AtmosphereStartRadius, radius);
    float heating = insolation * _WeatherA.x * exposure / max(0.05, definition.transport.y);
    float cooling = (state.x - _WeatherA.y) * _WeatherA.z * (1.0 - insolation) * exposure * 0.01;
    state.x += (heating - cooling) * _DeltaTime;

    if (atmosphere)
    {
        state.y += aux.x * _WeatherC.x * _DeltaTime;

        // Sensible heat exchange between exposed surface and the lowest Air cell.
        if (cell.y > 0)
        {
            int2 below = cell + int2(0, -1);
            uint belowMaterial = M(below);
            if (IsExposedSurface(below, belowMaterial))
            {
                float surfaceTemp = S(below).x;
                float exchange = (surfaceTemp - state.x) * saturate(_WeatherF.x * _DeltaTime);
                state.x += exchange;
            }
        }
    }

    Write(cell, material, state, flow, aux, ecology);
}

[numthreads(8, 8, 1)]
void AtmosphericContinuity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);

    if (IsAtmosphereCell(cell, material))
    {
        float4 faces = AtmosphereFaceMask(cell);
        float2 fL = F(cell + int2(-1, 0));
        float2 fR = F(cell + int2(1, 0));
        float2 fD = cell.y > 0 ? F(cell + int2(0, -1)) : float2(0.0, max(0.0, flow.y));
        float2 fU = cell.y < _GridSize.y - 1 ? F(cell + int2(0, 1)) : float2(0.0, min(0.0, flow.y));

        float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);
        // Flow is stored in cell-space units (matching pressure-gradient wind), so use
        // neighbor differences without an extra 1/dr amplification by radial resolution.
        float angularDiv = ((fR.x * faces.y) - (fL.x * faces.x)) * 0.5 * tanW;
        float radialDiv = ((fU.y * faces.w) - (fD.y * faces.z)) * 0.5;
        // Blocked radial faces convert attempted outflow into local convergence (high pressure).
        float blockedSink =
            (1.0 - faces.z) * max(0.0, -flow.y) +
            (1.0 - faces.w) * max(0.0, flow.y);
        float divergence = angularDiv + radialDiv - blockedSink;
        float compress = max(0.0, _WeatherF.z);
        float dp = clamp(-divergence * compress * _DeltaTime, -2.0, 2.0);
        state.y = max(0.0, state.y + dp);
    }

    Write(cell, material, state, flow, aux, ecology);
}

[numthreads(8, 8, 1)]
void AtmosphericDynamics(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    bool atmosphere = IsAtmosphereCell(cell, material);
    float4 faces = AtmosphereFaceMask(cell);
    float cfl = saturate(_WeatherF.w);

    float pressureLeft = S(cell + int2(-1, 0)).y;
    float pressureRight = S(cell + int2(1, 0)).y;
    float pressureBelow = cell.y > 0 ? S(cell + int2(0, -1)).y : state.y;
    float pressureAbove = cell.y < _GridSize.y - 1 ? S(cell + int2(0, 1)).y : state.y;

    float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);
    float2 gradient = float2(
        (pressureRight - pressureLeft) * 0.5 * tanW,
        (pressureAbove - pressureBelow) * 0.5);
    float2 accel = -gradient * _WeatherA.w * _DeltaTime;
    float accelMag = length(accel);
    float accelCap = max(0.05, cfl * 4.0);
    if (accelMag > accelCap)
        accel *= accelCap / accelMag;
    flow += accel;

    if (atmosphere)
    {
        // Signed buoyancy vs same-altitude Air neighbors (angular mean).
        float refTemp = 0.0;
        float refVapor = 0.0;
        float refWeight = 0.0;
        if (faces.x > 0.5)
        {
            refTemp += S(cell + int2(-1, 0)).x;
            refVapor += A(cell + int2(-1, 0)).x;
            refWeight += 1.0;
        }
        if (faces.y > 0.5)
        {
            refTemp += S(cell + int2(1, 0)).x;
            refVapor += A(cell + int2(1, 0)).x;
            refWeight += 1.0;
        }
        if (refWeight > 0.5)
        {
            refTemp /= refWeight;
            refVapor /= refWeight;
            float buoyancy = (state.x - refTemp) * _WeatherD.z + (aux.x - refVapor) * _WeatherD.w;
            flow.y += clamp(buoyancy, -2.0, 2.0) * _DeltaTime;
        }

        // Top boundary: suppress outward radial wind. Surface no-flux is enforced
        // in transport face masks; downdraft momentum remains for continuity/pressure.
        if (cell.y >= _GridSize.y - 1)
            flow.y = min(0.0, flow.y);
    }
    else
    {
        flow *= 0.5;
    }

    flow *= saturate(1.0 - _WeatherB.x * _DeltaTime);
    Write(cell, material, state, flow, aux, ecology);
}

[numthreads(8, 8, 1)]
void AtmosphericTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    bool atmosphere = IsAtmosphereCell(cell, material);
    float advectionRate = max(0.0, _WeatherD.x);
    float diffusionRate = max(0.0, _WeatherD.y);
    float tempAdvRate = max(0.0, _WeatherF.y);
    float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);

    if (atmosphere)
    {
        float vapor = max(0.0, aux.x);
        float cloud = max(0.0, state.z);
        float4 validFaces = AtmosphereFaceMask(cell);

        float4 outVapor = DonorFaceFlux(flow, vapor, advectionRate, validFaces, tanW);
        float4 outCloud = DonorFaceFlux(flow, cloud, advectionRate, validFaces, tanW);
        float4 outHeatUnit = DonorFaceFlux(flow, 1.0, tempAdvRate, validFaces, tanW);
        float vaporOut = outVapor.x + outVapor.y + outVapor.z + outVapor.w;
        float cloudOut = outCloud.x + outCloud.y + outCloud.z + outCloud.w;
        float heatOutFrac = outHeatUnit.x + outHeatUnit.y + outHeatUnit.z + outHeatUnit.w;

        float vaporIn = 0.0;
        float cloudIn = 0.0;
        float heatIn = 0.0;
        float heatInFrac = 0.0;
        float vaporDiff = 0.0;
        float cloudDiff = 0.0;

        int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 offset = offsets[i];
            if (offset.y != 0)
            {
                int neighborY = cell.y + offset.y;
                if (neighborY < 0 || neighborY >= _GridSize.y) continue;
            }

            int2 neighbor = C(cell + offset);
            uint neighborMaterial = M(neighbor);
            bool neighborAtmosphere = IsAtmosphereCell(neighbor, neighborMaterial);
            float4 neighborAux = A(neighbor);
            float4 neighborState = S(neighbor);

            if (neighborAtmosphere)
            {
                float4 neighborValid = AtmosphereFaceMask(neighbor);
                float neighborTan = TangentialEdgeWeight(neighbor.y, _GridSize.y);
                float2 neighborFlow = F(neighbor);
                float4 neighborOutVapor = DonorFaceFlux(neighborFlow, max(0.0, neighborAux.x), advectionRate, neighborValid, neighborTan);
                float4 neighborOutCloud = DonorFaceFlux(neighborFlow, max(0.0, neighborState.z), advectionRate, neighborValid, neighborTan);
                float4 neighborOutHeat = DonorFaceFlux(neighborFlow, 1.0, tempAdvRate, neighborValid, neighborTan);

                float faceVapor = 0.0;
                float faceCloud = 0.0;
                float faceHeatFrac = 0.0;
                if (offset.x == 1) { faceVapor = neighborOutVapor.x; faceCloud = neighborOutCloud.x; faceHeatFrac = neighborOutHeat.x; }
                else if (offset.x == -1) { faceVapor = neighborOutVapor.y; faceCloud = neighborOutCloud.y; faceHeatFrac = neighborOutHeat.y; }
                else if (offset.y == 1) { faceVapor = neighborOutVapor.z; faceCloud = neighborOutCloud.z; faceHeatFrac = neighborOutHeat.z; }
                else if (offset.y == -1) { faceVapor = neighborOutVapor.w; faceCloud = neighborOutCloud.w; faceHeatFrac = neighborOutHeat.w; }

                vaporIn += faceVapor;
                cloudIn += faceCloud;
                heatIn += neighborState.x * faceHeatFrac;
                heatInFrac += faceHeatFrac;

                vaporDiff += DiffusiveExchange(vapor, max(0.0, neighborAux.x), diffusionRate);
                cloudDiff += DiffusiveExchange(cloud, max(0.0, neighborState.z), diffusionRate);
            }
            else if (offset.y == -1 && IsExposedSurface(neighbor, neighborMaterial) && IsOpenCarrier(material))
            {
                float neighborVapor = max(0.0, neighborAux.x);
                float vent = min(neighborVapor, neighborVapor * saturate(0.35 + advectionRate) * _DeltaTime);
                vaporIn += vent;

                // Couple venting to a thermal plume in the first Air cell.
                float surfaceTemp = neighborState.x;
                float plumeMix = saturate(_WeatherF.x * 0.5 * _DeltaTime);
                state.x = lerp(state.x, surfaceTemp, plumeMix);
            }
        }

        aux.x = max(0.0, vapor - vaporOut + vaporIn + vaporDiff);
        state.z = max(0.0, cloud - cloudOut + cloudIn + cloudDiff);

        float remain = max(0.0, 1.0 - heatOutFrac);
        float denom = max(1e-5, remain + heatInFrac);
        state.x = (state.x * remain + heatIn) / denom;
    }
    else if (IsExposedSurface(cell, material) && aux.x > 1e-6 && cell.y < _GridSize.y - 1)
    {
        uint aboveMaterial = M(cell + int2(0, 1));
        if (IsOpenCarrier(aboveMaterial))
        {
            float vent = min(aux.x, aux.x * saturate(0.35 + advectionRate) * _DeltaTime);
            aux.x = max(0.0, aux.x - vent);
        }
    }

    Write(cell, material, state, flow, aux, ecology);
}

[numthreads(8, 8, 1)]
void WaterCycle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float radius = Radius01(cell.y, _GridSize.y);
    bool atmosphere = IsAtmosphereCell(cell, material);
    bool exposed = IsExposedSurface(cell, material);
    MaterialGpuData definition = D(material);
    float evaporativeDrive = saturate((state.x - 5.0) / 80.0);
    float evaporationBudget = _WeatherB.y * evaporativeDrive * _DeltaTime;

    if (state.x > 5.0 && !atmosphere)
    {
        float evapScale = material == 9u ? 0.75 : 1.0;
        float surfaceEvap = min(max(0.0, state.z), evaporationBudget * evapScale);
        state.z -= surfaceEvap;
        aux.x += surfaceEvap;
        state.x -= surfaceEvap * 0.25;

        float remainingBudget = max(0.0, evaporationBudget - surfaceEvap);
        if (exposed && IsGroundwaterHost(material, definition) && aux.y > 0.0 && remainingBudget > 0.0)
        {
            float capillary = min(aux.y, max(0.0, _MoistureErosion.z) * remainingBudget);
            aux.y -= capillary;
            aux.x += capillary;
            state.x -= capillary * 0.15;
        }
    }

    if (atmosphere)
    {
        float capacity = AtmosphericVaporCapacity(state.x, radius, state.y);
        if (aux.x > capacity)
        {
            float excess = aux.x - capacity;
            float condensation = min(excess, _WeatherB.z * max(excess, 0.05) * _DeltaTime);
            aux.x -= condensation;
            state.z += condensation;
            state.y = max(0.0, state.y - condensation * _WeatherC.x);
        }

        float rainThreshold = max(0.01, _WeatherE.y);
        if (state.z > rainThreshold && cell.y > 0)
        {
            uint belowMaterial = M(cell + int2(0, -1));
            if (!IsAtmosphereCell(cell + int2(0, -1), belowMaterial))
            {
                float rain = min(state.z - rainThreshold * 0.25, _WeatherB.w * _DeltaTime);
                rain = max(0.0, rain);
                float belowRoom = max(0.0, 1.0 - S(cell + int2(0, -1)).z);
                rain = min(rain, belowRoom);
                state.z -= rain;
                flow.y -= rain;
            }
        }
    }
    else
    {
        int2 above = cell + int2(0, 1);
        uint aboveMaterial = M(above);
        if (IsAtmosphereCell(above, aboveMaterial))
        {
            float rainThreshold = max(0.01, _WeatherE.y);
            float aboveCloud = S(above).z;
            if (aboveCloud > rainThreshold)
            {
                float rain = min(aboveCloud - rainThreshold * 0.25, _WeatherB.w * _DeltaTime);
                rain = max(0.0, rain);
                rain = min(rain, max(0.0, 1.0 - state.z));
                float rainTemp = S(above).x;
                state.z += rain;
                state.x = MixTemperature(state.x, definition.transport.y, rainTemp, rain, max(0.001, D(9u).transport.y));
                if ((material == 1u || material == 11u) && state.z > 0.15)
                    material = state.x < 0.0 ? 10u : 9u;
            }
        }
    }

    if (material == 9u && state.x < 0.0) material = 10u;
    else if (material == 10u && state.x > 1.0) material = 9u;
    else if (material == 11u) material = 1u;

    Write(cell, material, state, flow, aux, ecology);
}
