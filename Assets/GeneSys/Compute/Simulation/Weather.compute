#pragma kernel AtmosphericForcing
#pragma kernel AtmosphericContinuity
#pragma kernel AtmosphericDynamics
#pragma kernel AtmosphericTransport
#pragma kernel WaterCycle
#pragma kernel Precipitation

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"
#include "../../Shaders/Simulation/Common/SolarInsolation.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
Texture2D<float> _LightRead;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;

int2 _GridSize;
int _Tick;
int _Seed;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _WeatherA; // solarIntensity, spaceTemperature, atmosphereRadiativeCooling, windStrength
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherD; // advectionRate, vaporDiffusionRate, atmosphericBuoyancy, unused
float4 _WeatherE; // vaporCapacityScale, cloudRetainMass, waterPressureResponse, latentHeatScale
float4 _WeatherF; // surfaceAirHeatExchange, temperatureAdvectionRate, pressureCompressibility, atmosphericCflLimit
float4 _WeatherG; // surfaceAirTemperature, atmosphericLapseRate, terrainRadiativeCooling, verticalBuoyancyStrength
float4 _WeatherH; // atmosphereAbsorption, dewRate, unused, unused
float4 _WeatherI; // coriolisStrength, velocityAdvectionRate, prevailingWind, unused
float4 _PressureA; // diffusionRate, equilibriumGradient, equilibriumMaximum, unused
float4 _MoistureErosion; // dryMoistureThreshold, moistureCohesionStrength, unused, unused
float4 _CombustionA; // ambientOxygen, oxygenReplenish, oxygenDiffusion, unused
float4 _CombustionC; // unused, unused, unused, sootSettling

int2 C(int2 value) { return ClampCell(value, _GridSize); }
float4 S(int2 value) { return _StateRead.Load(int3(C(value), 0)); }
float2 F(int2 value) { return _FlowRead.Load(int3(C(value), 0)); }
float4 A(int2 value) { return _AuxRead.Load(int3(C(value), 0)); }
uint M(int2 value) { return _MaterialRead.Load(int3(C(value), 0)); }
float4 E(int2 value) { return _EcologyRead.Load(int3(C(value), 0)); }
float4 Comb(int2 value) { return _CombustionRead.Load(int3(C(value), 0)); }
MaterialGpuData D(uint material) { return _MaterialDefinitions[min(material, 255u)]; }

#include "../../Shaders/Simulation/Common/SurfaceWater.hlsl"
#include "../../Shaders/Simulation/Common/Climate.hlsl"

bool IsExposedSurface(int2 cell, uint material)
{
    if (cell.y >= _GridSize.y - 1) return false;
    uint above = M(cell + int2(0, 1));
    return D(above).metadata.x <= 1.0 && material != 1u && material != 0u && material != 11u;
}

float CellEffectivePressure(float4 state, float4 aux)
{
    return EffectivePressure(state.y, aux.x, _WeatherC.x);
}

float SurfaceAirHeatEnergy(int2 surfaceCell, int2 airCell)
{
    uint surfaceMat = M(surfaceCell);
    uint airMat = M(airCell);
    if (!IsExposedSurface(surfaceCell, surfaceMat) || !IsAtmosphereCell(airCell, airMat))
        return 0.0;
    float surfaceCp = max(0.001, D(surfaceMat).transport.y);
    float airCp = max(0.001, D(airMat).transport.y);
    float Qeq = (S(surfaceCell).x - S(airCell).x) * (airCp * surfaceCp) / max(1e-5, airCp + surfaceCp);
    return Qeq * saturate(_WeatherF.x * _DeltaTime);
}

void Write(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion)
{
    uint oldMaterial = M(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(D(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, SampleLife(_LifeGenomeRead, cell), SampleGenome(_LifeGenomeRead, cell));
}

float LightOf(int2 value) { return _LightRead.Load(int3(C(value), 0)); }

float LocalVaporCapacity(float temperature)
{
    return VaporSaturation(temperature, _WeatherE.x);
}

float4 DonorFaceFlux(float2 flow, float mass, float advectionRate, float4 validFaces, float tangentialWeight)
{
    return DonorFaceFlux(flow, mass, advectionRate, validFaces, tangentialWeight, _DeltaTime, _WeatherF.w);
}

float DiffusiveExchange(float selfMass, float neighborMass, float diffusionRate)
{
    return (neighborMass - selfMass) * saturate(diffusionRate * _DeltaTime) * 0.25;
}

float4 AtmosphereFaceMask(int2 cell)
{
    int2 leftCell = C(cell + int2(-1, 0));
    int2 rightCell = C(cell + int2(1, 0));
    int2 downCell = C(cell + int2(0, -1));
    int2 upCell = C(cell + int2(0, 1));
    return float4(
        IsAtmosphereCell(leftCell, M(leftCell)) ? 1.0 : 0.0,
        IsAtmosphereCell(rightCell, M(rightCell)) ? 1.0 : 0.0,
        (cell.y > 0 && IsAtmosphereCell(downCell, M(downCell))) ? 1.0 : 0.0,
        (cell.y < _GridSize.y - 1 && IsAtmosphereCell(upCell, M(upCell))) ? 1.0 : 0.0);
}

[numthreads(8, 8, 1)]
void AtmosphericForcing(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    MaterialGpuData definition = D(material);
    float radius = Radius01(cell.y, _GridSize.y);
    bool atmosphere = IsAtmosphereCell(cell, material);

    float theta01 = (cell.x + 0.5) / _GridSize.x;
    float insolation = SolarInsolation(theta01, _WeatherC.y) * ClimateInsolationScale(cell.x);
    float light = max(0.0, LightOf(cell));
    float heating = light / max(0.05, definition.transport.y);
    if (IsExposedSurface(cell, material))
        heating *= ClimateSurfaceAbsorb(cell.x);
    float coolingRate;
    if (radius > _AtmosphereStartRadius)
        coolingRate = _WeatherA.z;
    else
    {
        float depth = max(0.0, _AtmosphereStartRadius - radius);
        float eFolding = 0.04 * max(1e-5, _AtmosphereStartRadius - _PlayableInnerRadius);
        coolingRate = _WeatherG.z * exp(-depth / eFolding);
    }
    float cloudCover = atmosphere ? saturate(state.z) : 0.0;
    if (!atmosphere && cell.y < _GridSize.y - 1)
        cloudCover = saturate(S(cell + int2(0, 1)).z);
    float cooling = (state.x - _WeatherA.y) * coolingRate * (1.0 - insolation) * (1.0 - cloudCover * 0.7) * 0.01;
    state.x += (heating - cooling) * _DeltaTime;

    float heatCapacity = max(0.001, definition.transport.y);
    if (atmosphere && cell.y > 0)
    {
        float Q = SurfaceAirHeatEnergy(cell + int2(0, -1), cell);
        state.x += Q / heatCapacity;
    }
    else if (IsExposedSurface(cell, material) && cell.y < _GridSize.y - 1)
    {
        float Q = SurfaceAirHeatEnergy(cell, cell + int2(0, 1));
        state.x -= Q / heatCapacity;
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void AtmosphericContinuity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);

    if (IsAtmosphereCell(cell, material))
    {
        float4 faces = AtmosphereFaceMask(cell);
        float2 fL = F(cell + int2(-1, 0));
        float2 fR = F(cell + int2(1, 0));
        float2 fD = cell.y > 0 ? F(cell + int2(0, -1)) : float2(0.0, max(0.0, flow.y));
        float2 fU = cell.y < _GridSize.y - 1 ? F(cell + int2(0, 1)) : float2(0.0, min(0.0, flow.y));

        float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);
        // Flow is stored in cell-space units (matching pressure-gradient wind), so use
        // neighbor differences without an extra 1/dr amplification by radial resolution.
        float angularDiv = ((fR.x * faces.y) - (fL.x * faces.x)) * 0.5 * tanW;
        float radialDiv = ((fU.y * faces.w) - (fD.y * faces.z)) * 0.5;
        float divergence = angularDiv + radialDiv;
        float compress = max(0.0, _WeatherF.z);
        float dp = clamp(-divergence * compress * _DeltaTime, -2.0, 2.0);
        state.y = max(0.0, state.y + dp);
        // No-flux solids: reflect/damp the normal so one wall impact is not reintegrated
        // as compression on every later tick.
        if (faces.z < 0.5)
            flow.y = max(0.0, flow.y);
        if (faces.w < 0.5)
            flow.y = min(0.0, flow.y);
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void AtmosphericDynamics(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    bool atmosphere = IsAtmosphereCell(cell, material);
    float4 faces = AtmosphereFaceMask(cell);
    float cfl = saturate(_WeatherF.w);

    float pressureLeft = CellEffectivePressure(S(cell + int2(-1, 0)), A(cell + int2(-1, 0)));
    float pressureRight = CellEffectivePressure(S(cell + int2(1, 0)), A(cell + int2(1, 0)));
    float pressureBelow = cell.y > 0 ? CellEffectivePressure(S(cell + int2(0, -1)), A(cell + int2(0, -1))) : CellEffectivePressure(state, aux);
    float pressureAbove = cell.y < _GridSize.y - 1 ? CellEffectivePressure(S(cell + int2(0, 1)), A(cell + int2(0, 1))) : CellEffectivePressure(state, aux);

    float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);
    float2 gradient = float2(
        (pressureRight - pressureLeft) * 0.5 * tanW,
        (pressureAbove - pressureBelow) * 0.5);
    float2 accel = -gradient * _WeatherA.w * _DeltaTime;
    float accelMag = length(accel);
    float accelCap = max(0.05, cfl * 4.0);
    if (accelMag > accelCap)
        accel *= accelCap / accelMag;
    flow += accel;

    if (atmosphere)
    {
        // Signed buoyancy vs same-altitude Air neighbors (angular mean), plus a
        // lapse-adjusted vertical (radial) anomaly so a uniformly hot/humid layer
        // still rises against colder/drier air above.
        float buoyancy = 0.0;
        float refTemp = 0.0;
        float refVapor = 0.0;
        float refWeight = 0.0;
        if (faces.x > 0.5)
        {
            refTemp += S(cell + int2(-1, 0)).x;
            refVapor += A(cell + int2(-1, 0)).x;
            refWeight += 1.0;
        }
        if (faces.y > 0.5)
        {
            refTemp += S(cell + int2(1, 0)).x;
            refVapor += A(cell + int2(1, 0)).x;
            refWeight += 1.0;
        }
        if (refWeight > 0.5)
        {
            refTemp /= refWeight;
            refVapor /= refWeight;
            buoyancy += (VirtualTemperature(state.x, aux.x) - VirtualTemperature(refTemp, refVapor)) * _WeatherD.z;
        }

        // Lapse-adjusted vertical gradient. Superadiabatic contrast (hotter below /
        // colder above than the expected step) adds a shared updraft on both sides
        // of the face so vapor is not trapped by opposing donor velocities.
        float expectedStep = max(0.0, _WeatherG.y) / max(1.0, (1.0 - _AtmosphereStartRadius) * (float)_GridSize.y);
        float vertTemp = 0.0;
        float vertWeight = 0.0;
        if (faces.z > 0.5)
        {
            float4 belowState = S(cell + int2(0, -1));
            float4 belowAux = A(cell + int2(0, -1));
            vertTemp += (VirtualTemperature(belowState.x, belowAux.x) - expectedStep) - VirtualTemperature(state.x, aux.x);
            vertWeight += 1.0;
        }
        if (faces.w > 0.5)
        {
            float4 aboveState = S(cell + int2(0, 1));
            float4 aboveAux = A(cell + int2(0, 1));
            vertTemp += VirtualTemperature(state.x, aux.x) - (VirtualTemperature(aboveState.x, aboveAux.x) + expectedStep);
            vertWeight += 1.0;
        }
        if (vertWeight > 0.5)
        {
            vertTemp /= vertWeight;
            buoyancy += _WeatherG.w * vertTemp * _WeatherD.z;
        }

        flow.y += clamp(buoyancy, -2.0, 2.0) * _DeltaTime;

        float coriolis = _WeatherI.x;
        if (abs(coriolis) > 1e-6)
        {
            // 2D polar Coriolis acceleration: a = -2 * (Omega x v) = (-2 * Omega * v_r) theta_hat + (2 * Omega * v_theta) r_hat
            float2 cAccel = float2(-2.0 * coriolis * flow.y, 2.0 * coriolis * flow.x);
            flow += clamp(cAccel * _DeltaTime, -2.0, 2.0);
        }

        float prevailing = ClimateWindBias(cell.x, ClimateShellOf(Radius01(cell.y, _GridSize.y)));
        if (abs(prevailing) > 1e-6)
        {
            flow.x += prevailing * _DeltaTime;
        }

        // Top boundary: suppress outward radial wind. Surface no-flux is enforced
        // in transport face masks; downdraft momentum remains for continuity/pressure.
        if (cell.y >= _GridSize.y - 1)
            flow.y = min(0.0, flow.y);

        float roughness = 1.0;
        float radius = Radius01(cell.y, _GridSize.y);
        if (radius < _AtmosphereStartRadius + 4.0 / max(1.0, (float)_GridSize.y))
            roughness = ClimateRoughness(cell.x);
        flow *= saturate(1.0 - _WeatherB.x * roughness * _DeltaTime);
    }
    else
    {
        flow *= 0.5;
        flow *= saturate(1.0 - _WeatherB.x * _DeltaTime);
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}

[numthreads(8, 8, 1)]
void AtmosphericTransport(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    bool atmosphere = IsAtmosphereCell(cell, material);
    float advectionRate = max(0.0, _WeatherD.x);
    float diffusionRate = max(0.0, _WeatherD.y);
    float tempAdvRate = max(0.0, _WeatherF.y);
    float tanW = TangentialEdgeWeight(cell.y, _GridSize.y);

    float oxygenDiffRate = max(0.0, _CombustionA.z);
    float oxygenReplenish = max(0.0, _CombustionA.y);
    float sootSettle = max(0.0, _CombustionC.w);
    float capacity = OxygenCapacity(material, D(material));
    float ambient = saturate(_CombustionA.x) * capacity;

    if (atmosphere)
    {
        float vapor = max(0.0, aux.x);
        float cloud = max(0.0, state.z);
        float oxygen = max(0.0, combustion.x);
        float soot = max(0.0, combustion.z);
        float4 validFaces = AtmosphereFaceMask(cell);

        float velAdvRate = max(0.0, _WeatherI.y);
        float4 outFlowUnit = velAdvRate > 1e-6 ? DonorFaceFlux(flow, 1.0, velAdvRate, validFaces, tanW) : 0.0;
        float flowOutFrac = outFlowUnit.x + outFlowUnit.y + outFlowUnit.z + outFlowUnit.w;

        float4 outVapor = DonorFaceFlux(flow, vapor, advectionRate, validFaces, tanW);
        float4 outCloud = DonorFaceFlux(flow, cloud, advectionRate, validFaces, tanW);
        float4 outHeatUnit = DonorFaceFlux(flow, 1.0, tempAdvRate, validFaces, tanW);
        float4 outOxygen = DonorFaceFlux(flow, oxygen, advectionRate, validFaces, tanW);
        float4 outSoot = DonorFaceFlux(flow, soot, advectionRate, validFaces, tanW);
        float vaporOut = outVapor.x + outVapor.y + outVapor.z + outVapor.w;
        float cloudOut = outCloud.x + outCloud.y + outCloud.z + outCloud.w;
        float heatOutFrac = outHeatUnit.x + outHeatUnit.y + outHeatUnit.z + outHeatUnit.w;
        float oxygenOut = outOxygen.x + outOxygen.y + outOxygen.z + outOxygen.w;
        float sootOut = outSoot.x + outSoot.y + outSoot.z + outSoot.w;

        float2 flowIn = 0.0;
        float flowInFrac = 0.0;
        float vaporIn = 0.0;
        float cloudIn = 0.0;
        float heatIn = 0.0;
        float heatInFrac = 0.0;
        float vaporDiff = 0.0;
        float cloudDiff = 0.0;
        float oxygenIn = 0.0;
        float sootIn = 0.0;
        float oxygenDiff = 0.0;
        float sootSettled = 0.0;

        int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            int2 offset = offsets[i];
            if (offset.y != 0)
            {
                int neighborY = cell.y + offset.y;
                if (neighborY < 0 || neighborY >= _GridSize.y) continue;
            }

            int2 neighbor = C(cell + offset);
            uint neighborMaterial = M(neighbor);
            bool neighborAtmosphere = IsAtmosphereCell(neighbor, neighborMaterial);
            float4 neighborAux = A(neighbor);
            float4 neighborState = S(neighbor);
            float4 neighborCombustion = Comb(neighbor);

            if (neighborAtmosphere)
            {
                float4 neighborValid = AtmosphereFaceMask(neighbor);
                float neighborTan = TangentialEdgeWeight(neighbor.y, _GridSize.y);
                float2 neighborFlow = F(neighbor);
                float4 neighborOutVapor = DonorFaceFlux(neighborFlow, max(0.0, neighborAux.x), advectionRate, neighborValid, neighborTan);
                float4 neighborOutCloud = DonorFaceFlux(neighborFlow, max(0.0, neighborState.z), advectionRate, neighborValid, neighborTan);
                float4 neighborOutHeat = DonorFaceFlux(neighborFlow, 1.0, tempAdvRate, neighborValid, neighborTan);
                float4 neighborOutFlow = velAdvRate > 1e-6 ? DonorFaceFlux(neighborFlow, 1.0, velAdvRate, neighborValid, neighborTan) : 0.0;
                float4 neighborOutOxygen = DonorFaceFlux(neighborFlow, max(0.0, neighborCombustion.x), advectionRate, neighborValid, neighborTan);
                float4 neighborOutSoot = DonorFaceFlux(neighborFlow, max(0.0, neighborCombustion.z), advectionRate, neighborValid, neighborTan);

                float faceVapor = 0.0;
                float faceCloud = 0.0;
                float faceHeatFrac = 0.0;
                float faceFlowFrac = 0.0;
                float faceOxygen = 0.0;
                float faceSoot = 0.0;
                if (offset.x == 1) { faceVapor = neighborOutVapor.x; faceCloud = neighborOutCloud.x; faceHeatFrac = neighborOutHeat.x; faceFlowFrac = neighborOutFlow.x; faceOxygen = neighborOutOxygen.x; faceSoot = neighborOutSoot.x; }
                else if (offset.x == -1) { faceVapor = neighborOutVapor.y; faceCloud = neighborOutCloud.y; faceHeatFrac = neighborOutHeat.y; faceFlowFrac = neighborOutFlow.y; faceOxygen = neighborOutOxygen.y; faceSoot = neighborOutSoot.y; }
                else if (offset.y == 1) { faceVapor = neighborOutVapor.z; faceCloud = neighborOutCloud.z; faceHeatFrac = neighborOutHeat.z; faceFlowFrac = neighborOutFlow.z; faceOxygen = neighborOutOxygen.z; faceSoot = neighborOutSoot.z; }
                else if (offset.y == -1) { faceVapor = neighborOutVapor.w; faceCloud = neighborOutCloud.w; faceHeatFrac = neighborOutHeat.w; faceFlowFrac = neighborOutFlow.w; faceOxygen = neighborOutOxygen.w; faceSoot = neighborOutSoot.w; }

                vaporIn += faceVapor;
                cloudIn += faceCloud;
                heatIn += neighborState.x * faceHeatFrac;
                heatInFrac += faceHeatFrac;
                flowIn += neighborFlow * faceFlowFrac;
                flowInFrac += faceFlowFrac;
                oxygenIn += faceOxygen;
                sootIn += faceSoot;

                vaporDiff += DiffusiveExchange(vapor, max(0.0, neighborAux.x), diffusionRate);
                cloudDiff += DiffusiveExchange(cloud, max(0.0, neighborState.z), diffusionRate);
                oxygenDiff += DiffusiveExchange(oxygen, max(0.0, neighborCombustion.x), oxygenDiffRate);
            }
            else if (offset.y == -1 && IsExposedSurface(neighbor, neighborMaterial) && IsOpenCarrier(material))
            {
                float neighborVapor = max(0.0, neighborAux.x);
                float vent = min(neighborVapor, neighborVapor * saturate(0.35 + advectionRate) * _DeltaTime);
                vaporIn += vent;
                sootSettled += min(soot, soot * sootSettle * _DeltaTime);
            }
        }

        aux.x = max(0.0, vapor - vaporOut + vaporIn + vaporDiff);
        state.z = max(0.0, cloud - cloudOut + cloudIn + cloudDiff);
        combustion.x = saturate(oxygen - oxygenOut + oxygenIn + oxygenDiff);
        combustion.z = max(0.0, soot - sootOut + sootIn - sootSettled);

        float remain = max(0.0, 1.0 - heatOutFrac);
        float denom = max(1e-5, remain + heatInFrac);
        state.x = (state.x * remain + heatIn) / denom;
        float lapse = max(0.0, _WeatherG.y) / max(1.0, (1.0 - _AtmosphereStartRadius) * (float)_GridSize.y);
        state.x -= lapse * flow.y * _DeltaTime;

        if (velAdvRate > 1e-6)
        {
            float remainFlow = max(0.0, 1.0 - flowOutFrac);
            float denomFlow = max(1e-5, remainFlow + flowInFrac);
            flow = (flow * remainFlow + flowIn) / denomFlow;
        }
    }
    else if (IsExposedSurface(cell, material) && cell.y < _GridSize.y - 1)
    {
        // Mirror of the gather above: only vent into a cell that actually collects the vapor.
        int2 above = cell + int2(0, 1);
        uint aboveMaterial = M(above);
        if (IsAtmosphereCell(above, aboveMaterial) && IsOpenCarrier(aboveMaterial))
        {
            float vapor = max(0.0, aux.x);
            float vent = min(vapor, vapor * saturate(0.35 + advectionRate) * _DeltaTime);
            aux.x = max(0.0, vapor - vent);

            float aboveSoot = max(0.0, Comb(above).z);
            float settle = min(aboveSoot, aboveSoot * sootSettle * _DeltaTime);
            aux.z += settle;
        }
    }

    combustion.x = lerp(combustion.x, ambient, saturate(oxygenReplenish * _DeltaTime));
    combustion.x = min(max(0.0, combustion.x), capacity);

    Write(cell, material, state, flow, aux, ecology, combustion);
}

float DewTransfer(int2 surface, int2 air)
{
    uint surfaceMat = M(surface);
    uint airMat = M(air);
    if (!IsExposedSurface(surface, surfaceMat) || !IsAtmosphereCell(air, airMat) || !IsOpenCarrier(airMat))
        return 0.0;
    float4 airAux = A(air);
    float4 surfaceState = S(surface);
    float dew = DewPoint(airAux.x, _WeatherE.x);
    if (surfaceState.x >= dew)
        return 0.0;
    float available = max(0.0, airAux.x);
    float drive = max(0.0, dew - surfaceState.x);
    return min(available, max(0.0, _WeatherH.y) * drive * 0.05 * _DeltaTime);
}

// Both sides of WaterCycle must call this so ocean film leaves the pixel and lands in
// the air column. Storing evap on Water/Ice aux.x lets Hydrostatic zero it later.
float SurfaceEvaporation(int2 surface, int2 air)
{
    uint surfaceMat = M(surface);
    uint airMat = M(air);
    if (IsAtmosphereCell(surface, surfaceMat) || !IsExposedSurface(surface, surfaceMat))
        return 0.0;
    if (!IsAtmosphereCell(air, airMat) || !IsOpenCarrier(airMat))
        return 0.0;
    float4 surfaceState = S(surface);
    if (surfaceState.x <= -20.0)
        return 0.0;
    float4 airAux = A(air);
    float windMul = 1.0 + length(F(air));
    float hysteresis = max(0.001, _WeatherC.z);
    float liquidFrac = WaterLiquidFraction(surfaceState.x, hysteresis);
    float evapScale = surfaceMat == 9u ? 0.75 : 1.0;
    float phaseScale = liquidFrac + (1.0 - liquidFrac) * 0.15;
    return EvaporateToAir(surfaceState.x, airAux.x, surfaceState.z,
        max(0.0, _WeatherB.y) * windMul * evapScale * phaseScale, _DeltaTime, _WeatherE.x);
}

float CapillaryEvaporation(int2 surface, int2 air)
{
    uint surfaceMat = M(surface);
    uint airMat = M(air);
    if (IsAtmosphereCell(surface, surfaceMat) || !IsExposedSurface(surface, surfaceMat))
        return 0.0;
    if (!IsAtmosphereCell(air, airMat) || !IsOpenCarrier(airMat))
        return 0.0;
    MaterialGpuData definition = D(surfaceMat);
    if (!IsGroundwaterHost(surfaceMat, definition))
        return 0.0;
    float4 surfaceState = S(surface);
    float4 surfaceAux = A(surface);
    float hysteresis = max(0.001, _WeatherC.z);
    float liquidFrac = WaterLiquidFraction(surfaceState.x, hysteresis);
    if (surfaceState.x <= -20.0 || surfaceAux.y <= 0.0 || liquidFrac <= 0.05)
        return 0.0;
    float windMul = 1.0 + length(F(air));
    float porosity = saturate(definition.biology.z);
    return EvaporateToAir(surfaceState.x, A(air).x, surfaceAux.y,
        max(0.0, _WeatherB.y) * windMul * liquidFrac * porosity, _DeltaTime, _WeatherE.x);
}

[numthreads(8, 8, 1)]
void WaterCycle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    bool atmosphere = IsAtmosphereCell(cell, material);
    bool exposed = IsExposedSurface(cell, material);

    if (!atmosphere && exposed && cell.y < _GridSize.y - 1)
    {
        float surfaceEvap = SurfaceEvaporation(cell, cell + int2(0, 1));
        state.z -= surfaceEvap;
        state.x -= WaterLatentHeatDelta(surfaceEvap, _WeatherE.w, 0.8);

        float capillary = CapillaryEvaporation(cell, cell + int2(0, 1));
        aux.y -= capillary;
        state.x -= WaterLatentHeatDelta(capillary, _WeatherE.w, 0.6);
    }
    if (atmosphere && cell.y > 0)
    {
        aux.x += SurfaceEvaporation(cell + int2(0, -1), cell);
        aux.x += CapillaryEvaporation(cell + int2(0, -1), cell);
    }

    if (atmosphere)
    {
        float capacity = LocalVaporCapacity(state.x);
        if (aux.x > capacity)
        {
            float excess = aux.x - capacity;
            float condensation = min(excess, _WeatherB.z * max(excess, 0.05) * _DeltaTime);
            aux.x -= condensation;
            state.z += condensation;
            state.x += WaterLatentHeatDelta(condensation, _WeatherE.w, 0.8);
        }
    }

    if (exposed && cell.y < _GridSize.y - 1)
    {
        float incoming = DewTransfer(cell, cell + int2(0, 1));
        if (incoming > 1e-8)
        {
            state.z += incoming;
            state.x += WaterLatentHeatDelta(incoming, _WeatherE.w, 0.6);
        }
    }
    if (atmosphere && cell.y > 0)
    {
        float outgoing = DewTransfer(cell + int2(0, -1), cell);
        if (outgoing > 1e-8)
            aux.x = max(0.0, aux.x - outgoing);
    }

    if (material == 11u) material = 1u;

    Write(cell, material, state, flow, aux, ecology, combustion);
}

bool PrecipitationReceiverOk(int2 below, uint belowMat)
{
    if (belowMat == 9u || belowMat == 10u)
        return !IsAirborneLiquid(below, belowMat);
    if (IsAtmosphereCell(below, belowMat) && IsOpenCarrier(belowMat))
        return true;
    return belowMat != 0u && !IsAtmosphereCell(below, belowMat);
}

bool PrecipitationAirReceiver(int2 dest, uint destMat)
{
    return IsAtmosphereCell(dest, destMat) && IsOpenCarrier(destMat) && destMat != 9u && destMat != 10u;
}

bool PrecipitationClearAirDest(int2 dest, uint destMat)
{
    return PrecipitationAirReceiver(dest, destMat) && max(0.0, S(dest).z) <= PRECIP_CLOUD_BASE;
}

int2 CloudPrecipReceiver(int2 source)
{
    int2 down = source + int2(0, -1);
    uint downMat = M(down);
    bool downOk = PrecipitationReceiverOk(down, downMat);
    float h = Hash01((uint)source.x * 73856093u + (uint)source.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 9137u + 19u);
    float wind = F(source).x;
    bool frozen = LiquidPixelId(S(source).x, max(0.001, _WeatherC.z)) == 10u;
    int dx = abs(wind) > 0.12 ? (wind > 0.0 ? 1 : -1)
           : (frozen && h < 0.5 ? -1 : 1);
    // Sidestep only when the shaft is blocked. Fanning into clear air while the
    // column is still cloudy stamped a sheet of Ice/Water pixels that sat in the
    // sky as frozen cloud.
    bool trySide = !downOk || (abs(wind) > 0.12 && PrecipitationClearAirDest(down, downMat));
    if (trySide)
    {
        [unroll]
        for (int i = 0; i < 2; i++)
        {
            int2 side = int2((int)WrapTheta(source.x + dx, _GridSize.x), source.y - 1);
            uint sideMat = M(side);
            if (PrecipitationReceiverOk(side, sideMat) && PrecipitationAirReceiver(side, sideMat))
                return side;
            if (!downOk && PrecipitationReceiverOk(side, sideMat))
                return side;
            dx = -dx;
        }
    }
    return down;
}

float CloudPrecipTransfer(int2 source)
{
    uint mat = M(source);
    if (!IsAtmosphereCell(source, mat) || source.y <= 0)
        return 0.0;
    if (_WeatherB.w <= 1e-8)
        return 0.0;
    float4 state = S(source);
    float retain = max(0.01, _WeatherE.y);
    float cloud = max(0.0, state.z);
    if (cloud <= retain)
        return 0.0;
    int2 dest = CloudPrecipReceiver(source);
    uint destMat = M(dest);
    if (!PrecipitationReceiverOk(dest, destMat))
        return 0.0;
    bool destAir = PrecipitationAirReceiver(dest, destMat);
    bool materialize = PrecipitationClearAirDest(dest, destMat);
    float eq = PressureEquilibriumAt(source.y, _GridSize.y, _PressureA.y, _PressureA.z);
    float ready = PrecipitationMass(cloud, retain, state.x, CellEffectivePressure(state, A(source)), eq, F(source).y, _WeatherB.w, _WeatherE.z, _DeltaTime);
    float excess = max(0.0, cloud - retain);
    // Interior cloudy air keeps the mass as cloud so a saturated deck drains
    // instead of freezing in place or becoming a Water/Ice tower.
    if (destAir && !materialize)
        return min(ready, excess);
    uint decision = (uint)source.x * 73856093u + (uint)source.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 9137u + 41u;
    return PrecipitationEmitMass(ready, excess, destAir, decision);
}

[numthreads(8, 8, 1)]
void Precipitation(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material = M(cell);
    float4 state = S(cell);
    float2 flow = F(cell);
    float4 aux = A(cell);
    float4 ecology = E(cell);
    float4 combustion = Comb(cell);
    float hysteresis = max(0.001, _WeatherC.z);
    float waterCp = max(0.001, D(9u).transport.y);

    float outgoing = CloudPrecipTransfer(cell);
    float incoming = 0.0;
    float incomingHeat = 0.0;
    if (cell.y < _GridSize.y - 1)
    {
        int2 candidates[3] = {
            int2(cell.x, cell.y + 1),
            int2((int)WrapTheta(cell.x - 1, _GridSize.x), cell.y + 1),
            int2((int)WrapTheta(cell.x + 1, _GridSize.x), cell.y + 1)
        };
        [unroll]
        for (int i = 0; i < 3; i++)
        {
            int2 src = candidates[i];
            if (src.y >= _GridSize.y) continue;
            if (!all(CloudPrecipReceiver(src) == cell)) continue;
            float mass = CloudPrecipTransfer(src);
            if (mass > 1e-8)
            {
                incoming += mass;
                incomingHeat += S(src).x * mass;
            }
        }
    }

    if (outgoing > 1e-8)
    {
        state.z = max(0.0, state.z - outgoing);
        flow.y -= outgoing;
    }

    if (incoming > 1e-8)
    {
        if (PrecipitationAirReceiver(cell, material))
        {
            float residualCloud = max(0.0, state.z);
            float destCp = max(0.001, D(1u).transport.y);
            float destMassHeat = destCp + residualCloud * waterCp;
            float srcMassHeat = incoming * waterCp;
            state.x = (state.x * destMassHeat + incomingHeat * waterCp) / max(1e-5, destMassHeat + srcMassHeat);
            state.z = incoming + residualCloud;
            if (residualCloud <= PRECIP_CLOUD_BASE)
                material = LiquidPixelId(state.x, hysteresis);
        }
        else
        {
            float destCp = max(0.001, D(material).transport.y);
            float destMassHeat = destCp + max(0.0, state.z) * waterCp;
            float srcMassHeat = incoming * waterCp;
            state.x = (state.x * destMassHeat + incomingHeat * waterCp) / max(1e-5, destMassHeat + srcMassHeat);
            state.z += incoming;
        }
    }

    Write(cell, material, state, flow, aux, ecology, combustion);
}
