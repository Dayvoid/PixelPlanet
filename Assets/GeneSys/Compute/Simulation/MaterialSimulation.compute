#pragma kernel ApplyEdits
#pragma kernel ThermalAndPressure
#pragma kernel PhaseChange
#pragma kernel LiquidDensityExchange
#pragma kernel MaterialMotion
#pragma kernel Electrical
#pragma kernel PressureDiffusion
#pragma target 5.1

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"
// ApplyEdits already uses 8 texture UAVs (D3D11's per-kernel cap). OrganismHistory
// buffers would add two more and make GetKernelThreadGroupSizes log an error.

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
Texture2D<uint> _ShadeRead;
RWTexture2D<uint> _ShadeWrite;
Texture2D<float4> _EcologyRead;
RWTexture2D<float4> _EcologyWrite;
Texture2D<float4> _CombustionRead;
RWTexture2D<float4> _CombustionWrite;
Texture2DArray<float4> _LifeGenomeRead;
RWTexture2DArray<float4> _LifeGenomeWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;
StructuredBuffer<BrushCommand> _BrushCommands;

int2 _GridSize;
int _Tick;
int _Seed;
int _BrushCount;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _GeologyB;
float4 _Hydrology;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _WeatherE; // vaporCapacityScale, cloudRetainMass, waterPressureResponse, latentHeatScale
float4 _EruptionA;
float4 _EruptionB;
float4 _PressureA; // diffusionRate, equilibriumGradient, equilibriumMaximum, unused
float4 _PressureB; // gas, fluid, porous, rigid diffusivities
float4 _DensityExchange; // rate, epsilon, unused, unused
float4 _ThermalA; // moistureBoost, pressureEffect, coreTemperature, coreHeatRate
float4 _MycologyA; // initialSporeLoad, rareStrainChance, airTransport, waterTransport
float4 _GrassI; // seedAtWorldgen, cohesionBonus, detritusNutrient, detritusMoisture

uint ReadMaterial(int2 cell) { cell = ClampCell(cell, _GridSize); return _MaterialRead.Load(int3(cell, 0)); }
float4 ReadState(int2 cell) { cell = ClampCell(cell, _GridSize); return _StateRead.Load(int3(cell, 0)); }
float2 ReadFlow(int2 cell) { cell = ClampCell(cell, _GridSize); return _FlowRead.Load(int3(cell, 0)); }
float4 ReadAux(int2 cell) { cell = ClampCell(cell, _GridSize); return _AuxRead.Load(int3(cell, 0)); }
float4 ReadEcology(int2 cell) { cell = ClampCell(cell, _GridSize); return _EcologyRead.Load(int3(cell, 0)); }
float4 ReadCombustion(int2 cell) { cell = ClampCell(cell, _GridSize); return _CombustionRead.Load(int3(cell, 0)); }
float4 ReadLife(int2 cell) { cell = ClampCell(cell, _GridSize); return SampleLife(_LifeGenomeRead, cell); }
uint4 ReadGenome(int2 cell) { cell = ClampCell(cell, _GridSize); return SampleGenome(_LifeGenomeRead, cell); }
MaterialGpuData Mat(uint id) { return _MaterialDefinitions[min(id, 255u)]; }
int2 C(int2 value) { return ClampCell(value, _GridSize); }
uint M(int2 value) { return ReadMaterial(value); }
float4 S(int2 value) { return ReadState(value); }
MaterialGpuData D(uint material) { return Mat(material); }
float HarmonicMean(float a, float b);

#include "../../Shaders/Simulation/Common/SurfaceWater.hlsl"

void CopyCell(int2 cell, out uint material, out float4 state, out float2 flow, out float4 aux, out float4 ecology, out float4 combustion, out float4 life, out uint4 genome)
{
    material = ReadMaterial(cell);
    state = ReadState(cell);
    flow = ReadFlow(cell);
    aux = ReadAux(cell);
    ecology = ReadEcology(cell);
    combustion = ReadCombustion(cell);
    life = ReadLife(cell);
    genome = ReadGenome(cell);
}

void WriteCell(int2 cell, uint material, float4 state, float2 flow, float4 aux, float4 ecology, float4 combustion, float4 life, uint4 genome)
{
    uint oldMaterial = ReadMaterial(cell);
    uint shade = _ShadeRead.Load(int3(cell, 0));
    if (material != oldMaterial)
        shade = PickMaterialShade(Mat(material).metadata.x, (uint2)cell, material, _Seed);
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
    _ShadeWrite[cell] = shade;
    _EcologyWrite[cell] = SanitizeEcology(ecology);
    _CombustionWrite[cell] = SanitizeCombustion(combustion);
    WriteLifeGenome(_LifeGenomeWrite, cell, life, genome);
}

[numthreads(8, 8, 1)]
void ApplyEdits(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);

    for (int i = 0; i < _BrushCount; i++)
    {
        BrushCommand command = _BrushCommands[i];
        int dx = abs(cell.x - command.center.x);
        dx = min(dx, _GridSize.x - dx);
        int dy = cell.y - command.center.y;
        if (dx * dx + dy * dy > command.radius * command.radius) continue;
        int mode = (int)round(command.values.x);
        float falloff = 1.0 - saturate(sqrt((float)(dx * dx + dy * dy)) / max(1.0, (float)command.radius));
        if (mode == 0)
        {
            material = command.materialId;
            if (IsDetritusMaterial(material))
            {
                aux.y = max(aux.y, max(0.25, saturate(_GrassI.w)));
                aux.z = max(aux.z, max(0.45, saturate(_GrassI.z)));
            }
            if (material == 9u && state.x > 99.0)
                state.x = 15.0;
            else if (material == 10u && state.x >= 0.0)
                state.x = -4.0;
            if (IsFloraMaterial(material) && life.y <= 1e-6)
            {
                genome = RandomFloraGenome((uint2)cell, _Seed, _Tick);
                genome.w = PackFloraMeta(FLORA_STAGE_ACTIVE, 0u, FloraLineage(genome), 0u);
                life.y = 0.35;
                life.z = 0.1;
                life.x = max(life.x, 0.05);
            }
        }
        else if (mode == 1) state.x += command.values.y * max(0.1, falloff);
        else if (mode == 2) state.z = max(0.0, state.z + command.values.y * max(0.1, falloff));
        else if (mode == 3) state.y += command.values.y * max(0.1, falloff);
        else if (mode == 4) aux.z += command.values.y * max(0.1, falloff);
        else if (mode == 5) aux.y = max(0.0, aux.y + command.values.y * max(0.1, falloff));
        else if (mode == 6) aux.x = max(0.0, aux.x + command.values.y * max(0.1, falloff));
        else if (mode == 7)
        {
            ecology.x = max(0.0, command.values.y * max(0.1, falloff));
            if (command.values.w < 0.0)
            {
                uint traits = 0u;
                if (Hash01((uint)cell.x * 19349663u + (uint)cell.y * 83492791u + (uint)_Seed * 6151u) < saturate(_MycologyA.y))
                    traits = PickRareMycologyTraits((uint2)cell, _Seed);
                ecology.z = (float)traits;
            }
            else
            {
                ecology.y = saturate(command.values.z);
                ecology.z = (float)SanitizeMycologyTraits((uint)round(command.values.w));
            }
        }
        else if (mode == 8) state.w += command.values.y * max(0.1, falloff);
        else if (mode == 9) combustion.y = saturate(max(combustion.y, command.values.y * max(0.1, falloff)));
        else if (mode == 10) combustion.x = max(0.0, command.values.y);
        else if (mode == 12) flow.y += command.values.y * max(0.1, falloff);
        else if (mode == 13) flow.x = command.values.y;
        else if (mode == 14)
        {
            life.x = max(0.0, command.values.y * max(0.1, falloff));
            genome = RandomFloraGenome((uint2)cell, _Seed, _Tick);
        }
    }
    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void ThermalAndPressure(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
    MaterialGpuData definition = Mat(material);

    float waterCp = max(0.001, Mat(9u).transport.y);
    float waterK = max(0.0, Mat(9u).transport.x);
    bool atmosphere = IsAtmosphereMaterial(material, definition);
    float heatCapacity = EffectiveCellHeatCapacity(definition, state, aux, waterCp, atmosphere);
    float selfK = MoistureAdjustedConductivity(definition, aux.y, atmosphere ? 0.0 : state.z, waterK, _ThermalA.x);
    selfK = PressureAdjustedConductivity(selfK, material, definition, state.y,
        PressureEquilibriumAt(cell.y, _GridSize.y, _PressureA.y, _PressureA.z), _ThermalA.y);
    float energy = 0.0;
    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }

        int2 neighbor = C(cell + offset);
        uint neighborMaterial = ReadMaterial(neighbor);
        float4 neighborState = ReadState(neighbor);
        float4 neighborAux = ReadAux(neighbor);
        MaterialGpuData neighborDef = Mat(neighborMaterial);
        bool neighborAtmosphere = IsAtmosphereMaterial(neighborMaterial, neighborDef);
        float neighborCapacity = EffectiveCellHeatCapacity(neighborDef, neighborState, neighborAux, waterCp, neighborAtmosphere);
        float neighborK = MoistureAdjustedConductivity(neighborDef, neighborAux.y, neighborAtmosphere ? 0.0 : neighborState.z, waterK, _ThermalA.x);
        neighborK = PressureAdjustedConductivity(neighborK, neighborMaterial, neighborDef, neighborState.y,
            PressureEquilibriumAt(neighbor.y, _GridSize.y, _PressureA.y, _PressureA.z), _ThermalA.y);
        float edgeConductance = HarmonicMean(selfK, neighborK) * FaceGeometryWeight(cell, offset, _GridSize.y);
        energy += FaceHeatEnergy(state.x, heatCapacity, neighborState.x, neighborCapacity, edgeConductance, _Mechanics.y, _DeltaTime);
    }

    float deltaTemperature = clamp(energy / heatCapacity, -25.0, 25.0);
    state.x += deltaTemperature;
    float expansion = deltaTemperature * definition.phase.z;
    state.y = max(0.0, state.y + expansion - state.y * _Mechanics.w * 0.01 * _DeltaTime);
    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void PhaseChange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
    MaterialGpuData definition = Mat(material);
    uint packed = (uint)round(definition.metadata.y);
    uint solidId = packed & 1023u;
    uint liquidId = (packed >> 10) & 1023u;
    uint gasId = (packed >> 20) & 1023u;
    float hysteresis = max(0.001, _WeatherC.z);
    float equilibrium = PressureEquilibriumAt(cell.y, _GridSize.y, _PressureA.y, _PressureA.z);
    float boilPoint = definition.phase.y;
    if (material == 9u || material == 10u)
        boilPoint = WaterBoilTemperature(EffectivePressure(state.y, aux.x, _WeatherC.x), equilibrium, _WeatherE.z);

    // Legacy Vapor pixels migrate to Air while preserving vapor/cloud mass fields.
    if (material == 11u)
    {
        material = 1u;
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    if (IsGroundwaterHost(material, definition) && aux.y > 0.0 && _Mechanics.y > 1e-8)
    {
        float hostBoil = WaterBoilTemperature(EffectivePressure(state.y, aux.x, _WeatherC.x), equilibrium, _WeatherE.z);
        float boiled = GroundwaterBoilMass(aux.y, state.x, hostBoil + hysteresis, _DeltaTime);
        if (boiled > 1e-8)
        {
            aux.y -= boiled;
            aux.x += boiled;
            state.x -= WaterLatentHeatDelta(boiled, _WeatherE.w, 0.8);
            state.y += boiled * 0.5;
            aux.z += boiled * max(0.0, _GeologyB.x) * max(0.0, _GeologyB.y);
        }
    }

    // Isolation and frozen-thermal ticks keep existing phase; boiling still runs when heat is enabled.
    if (_Mechanics.y <= 1e-8)
    {
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }
    if (definition.metadata.x == 1.0)
    {
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }
    float heatCapacity = EffectiveCellHeatCapacity(definition, state, aux, Mat(9u).transport.y, IsAtmosphereMaterial(material, definition));
    if (gasId > 0u && state.x > boilPoint + hysteresis)
    {
        // Boiling vacates the cell to Air and moves only existing liquid/ice mass into aux.x.
        float boiled = max(0.0, state.z);
        aux.x += boiled;
        state.z = 0.0;
        state.x -= WaterLatentHeatDelta(boiled, _WeatherE.w, 2.0);
        material = 1u;
    }
    else if (liquidId > 0u && state.x > definition.phase.x + hysteresis)
    {
        float melted = max(0.0, state.z);
        material = liquidId;
        if (liquidId == 9u)
            state.x = max(WATER_MELT_TEMP + hysteresis, state.x - WaterLatentHeatDelta(melted, _WeatherE.w, 0.4));
        else
            state.x = max(definition.phase.x + hysteresis, state.x - MaterialPhaseLatentDelta(definition.motion.y, _WeatherE.w, heatCapacity));
    }
    else if (solidId > 0u && state.x < definition.phase.x - hysteresis)
    {
        float frozen = max(0.0, state.z);
        material = solidId;
        if (solidId == 10u)
            state.x = min(WATER_MELT_TEMP - hysteresis, state.x + WaterLatentHeatDelta(frozen, _WeatherE.w, 0.4));
        else
            state.x = min(definition.phase.x - hysteresis, state.x + MaterialPhaseLatentDelta(definition.motion.y, _WeatherE.w, heatCapacity));
    }
    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

bool IsMovable(uint material)
{
    if (material == 12u) return false; // Ash uses dedicated AshTransport motion.
    // Adult wasps fly: the wasp pass owns their vertical position. Letting the generic
    // solver drop them a cell per tick would outrun their altitude controller.
    if (IsWaspMaterial(material)) return false;
    if (IsTreeMaterial(material)) return false;
    if (material == 10u) return true;
    float category = Mat(material).metadata.x;
    return category == 2.0 || category == 3.0 || category == 5.0 || category == 6.0;
}

bool IsOpen(uint material)
{
    float category = Mat(material).metadata.x;
    return material == 0u || category == 1.0;
}

bool IsLiquidCategory(uint material)
{
    return Mat(material).metadata.x == 2.0;
}

bool IsDensityDisplaceable(uint material)
{
    return Mat(material).motion.x > 0.5;
}

bool ShouldExchangeDensityPair(int2 lowerCell, int2 upperCell)
{
    uint lowerMat = ReadMaterial(lowerCell);
    uint upperMat = ReadMaterial(upperCell);
    if (!IsDensityDisplaceable(lowerMat) || !IsDensityDisplaceable(upperMat)) return false;
    if (!IsLiquidCategory(lowerMat) && !IsLiquidCategory(upperMat)) return false;

    MaterialGpuData lowerDef = Mat(lowerMat);
    MaterialGpuData upperDef = Mat(upperMat);
    float densityDelta = upperDef.physical.x - lowerDef.physical.x;
    if (densityDelta <= _DensityExchange.y) return false;

    // Density alone decides direction. buoyancyBias only scales response rate.
    float bias = clamp(0.5 * (lowerDef.biology.w + upperDef.biology.w), -0.75, 0.75);
    float chance = saturate(_DensityExchange.x * _DeltaTime * (1.0 + bias));
    uint hashInput = (uint)(lowerCell.x * 73856093) ^ (uint)(lowerCell.y * 19349663) ^ ((uint)_Tick * 83492791u);
    return Hash01(hashInput) < chance;
}

[numthreads(8, 8, 1)]
void LiquidDensityExchange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);

    // Alternating disjoint radial pairs so both threads agree on the same swap.
    int parity = _Tick & 1;
    int lowerY = ((cell.y & 1) == parity) ? cell.y : cell.y - 1;
    if (lowerY < 0 || lowerY + 1 >= _GridSize.y)
    {
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    int2 lowerCell = int2(cell.x, lowerY);
    int2 upperCell = int2(cell.x, lowerY + 1);
    if (ShouldExchangeDensityPair(lowerCell, upperCell))
    {
        if (cell.y == lowerY)
        {
            material = ReadMaterial(upperCell);
            state = ReadState(upperCell);
            flow = ReadFlow(upperCell);
            aux = ReadAux(upperCell);
            ecology = ReadEcology(upperCell);
            combustion = ReadCombustion(upperCell);
            life = ReadLife(upperCell);
            genome = ReadGenome(upperCell);
        }
        else
        {
            material = ReadMaterial(lowerCell);
            state = ReadState(lowerCell);
            flow = ReadFlow(lowerCell);
            aux = ReadAux(lowerCell);
            ecology = ReadEcology(lowerCell);
            combustion = ReadCombustion(lowerCell);
            life = ReadLife(lowerCell);
            genome = ReadGenome(lowerCell);
        }
    }

    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

int2 AirbornePrecipDestination(int2 source, int2 below)
{
    bool downOpen = IsOpen(ReadMaterial(below));
    if (_Mechanics.x <= 1e-8)
        return downOpen ? below : source;

    float wind = ReadFlow(source).x;
    int dx = 0;
    if (abs(wind) > 0.12)
        dx = wind > 0.0 ? 1 : -1;
    // Chance jitter breaks columnar snow/ice. Rain only slants with wind.
    if (ReadMaterial(source) == 10u)
    {
        float h = Hash01((uint)source.x * 73856093u + (uint)source.y * 19349663u + (uint)_Tick * 83492791u + (uint)_Seed * 9137u + 7u);
        if (dx == 0)
        {
            if (h < 0.30) dx = -1;
            else if (h > 0.70) dx = 1;
        }
        else if (h < 0.20)
            dx = 0;
        else if (h > 0.90)
            dx = -dx;
    }

    if (dx != 0)
    {
        int2 diag = ClampCell(source + int2(dx, -1), _GridSize);
        if (IsOpen(ReadMaterial(diag)))
        {
            int2 competitor = ClampCell(diag + int2(0, 1), _GridSize);
            uint competitorMat = ReadMaterial(competitor);
            bool blocked = !all(competitor == source)
                && (competitorMat == 9u || competitorMat == 10u)
                && IsAirborneLiquid(competitor, competitorMat);
            if (!blocked)
                return diag;
        }
    }
    if (downOpen) return below;
    return source;
}

int2 MovementDestination(int2 source)
{
    uint sourceMaterial = ReadMaterial(source);
    if (!IsMovable(sourceMaterial) || source.y <= 0) return source;
    int2 below = ClampCell(source + int2(0, -1), _GridSize);
    if ((sourceMaterial == 9u || sourceMaterial == 10u) && IsAirborneLiquid(source, sourceMaterial))
        return AirbornePrecipDestination(source, below);
    if (IsOpen(ReadMaterial(below))) return below;

    // Solid ice falls straight down when unsupported, but does not slide diagonally like sand/fluid.
    if (sourceMaterial == 10u) return source;

    MaterialGpuData definition = Mat(sourceMaterial);
    if (definition.physical.y >= 0.9) return source;
    // Standing surface water levels by hydraulic head in enclosed basins.
    // However, if the water pixel is laterally unconfined (open air to either side),
    // allow diagonal sliding so unsupported cliffs and towers can spill and level.
    if (sourceMaterial == 9u)
    {
        int2 leftSide = ClampCell(source + int2(-1, 0), _GridSize);
        int2 rightSide = ClampCell(source + int2(1, 0), _GridSize);
        bool laterallyExposed = IsOpen(ReadMaterial(leftSide)) || IsOpen(ReadMaterial(rightSide));
        if (!laterallyExposed)
            return source;
    }
    int direction = ((source.x + _Tick) & 1) == 0 ? -1 : 1;
    int2 diagonal = ClampCell(source + int2(direction, -1), _GridSize);
    if (IsOpen(ReadMaterial(diagonal))) return diagonal;
    return source;
}

// Receiver priority: above, then left-above, then right-above. First candidate whose
// MovementDestination equals the target wins. Movers must replay this or a collision
// vacates into humid air that nobody pulled, duplicating aux.x.
int2 MovementWinner(int2 target)
{
    int2 above = ClampCell(target + int2(0, 1), _GridSize);
    if (all(MovementDestination(above) == target)) return above;
    int2 leftSource = ClampCell(target + int2(-1, 1), _GridSize);
    if (all(MovementDestination(leftSource) == target)) return leftSource;
    int2 rightSource = ClampCell(target + int2(1, 1), _GridSize);
    if (all(MovementDestination(rightSource) == target)) return rightSource;
    return target;
}

bool MoveWins(int2 source, int2 target)
{
    return all(MovementWinner(target) == source);
}

[numthreads(8, 8, 1)]
void MaterialMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);

    int2 destination = MovementDestination(cell);
    if (IsMovable(material) && !all(destination == cell) && MoveWins(cell, destination))
    {
        material = ReadMaterial(destination);
        state = ReadState(destination);
        flow = ReadFlow(destination);
        aux = ReadAux(destination);
        ecology = ReadEcology(destination);
        combustion = ReadCombustion(destination);
        life = ReadLife(destination);
        genome = ReadGenome(destination);
    }
    else if (IsOpen(material) && cell.y < _GridSize.y - 1)
    {
        int2 source = MovementWinner(cell);
        if (!all(source == cell))
        {
            material = ReadMaterial(source);
            state = ReadState(source);
            flow = ReadFlow(source);
            aux = ReadAux(source);
            ecology = ReadEcology(source);
            combustion = ReadCombustion(source);
            life = ReadLife(source);
            genome = ReadGenome(source);
            flow.y -= _Mechanics.x * _DeltaTime;
        }
    }
    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

[numthreads(8, 8, 1)]
void Electrical(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
    MaterialGpuData definition = Mat(material);
    float neighborCharge = ReadState(cell + int2(-1, 0)).w + ReadState(cell + int2(1, 0)).w
        + ReadState(cell + int2(0, -1)).w + ReadState(cell + int2(0, 1)).w;
    neighborCharge *= 0.25;
    float oldCharge = state.w;
    state.w += (neighborCharge - state.w) * definition.transport.z * _Mechanics.z * _DeltaTime;
    state.y += abs(state.w - oldCharge) * definition.phase.w;
    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}

float PressureEquilibrium(int radiusIndex)
{
    return PressureEquilibriumAt(radiusIndex, _GridSize.y, _PressureA.y, _PressureA.z);
}

float PressureConductance(uint material)
{
    MaterialGpuData definition = Mat(material);
    float category = definition.metadata.x;
    float porosity = saturate(definition.biology.z);
    float rigidity = saturate(definition.physical.y);
    float gas = max(0.0, _PressureB.x);
    float fluid = max(0.0, _PressureB.y);
    float porous = max(0.0, _PressureB.z);
    float rigid = max(0.0, _PressureB.w);

    // Empty/Gas → gas; Liquid/Magma → fluid; Granular/Biological → porosity blend;
    // Solid → porosity * (1 - rigidity) blend toward porous from rigid.
    if (category <= 1.0) return gas;
    if (category == 2.0 || category == 5.0) return fluid;
    if (category == 3.0 || category == 6.0) return lerp(rigid, porous, porosity);
    return lerp(rigid, porous, porosity * (1.0 - rigidity));
}

float HarmonicMean(float a, float b)
{
    float sum = a + b;
    if (sum <= 1e-8) return 0.0;
    return 2.0 * a * b / sum;
}

[numthreads(8, 8, 1)]
void PressureDiffusion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux; float4 ecology; float4 combustion; float4 life; uint4 genome;
    CopyCell(cell, material, state, flow, aux, ecology, combustion, life, genome);

    float rate = max(0.0, _PressureA.x);
    if (rate <= 1e-8)
    {
        WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
        return;
    }

    float alpha = 1.0 - exp(-rate * _DeltaTime);
    float selfConductance = PressureConductance(material);
    float selfEquilibrium = PressureEquilibrium(cell.y);
    float selfAnomaly = state.y - selfEquilibrium;
    float available = max(0.0, state.y);
    float edgeBudget = available * 0.25;
    float delta = 0.0;

    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        // Radial edges are no-flux; angular neighbors wrap via ClampCell.
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }

        int2 neighbor = ClampCell(cell + offset, _GridSize);
        uint neighborMaterial = ReadMaterial(neighbor);
        float4 neighborState = ReadState(neighbor);
        float edgeConductance = HarmonicMean(selfConductance, PressureConductance(neighborMaterial));
        float neighborAnomaly = neighborState.y - PressureEquilibrium(neighbor.y);
        float flux = edgeConductance * (neighborAnomaly - selfAnomaly) * alpha * 0.25;
        float neighborBudget = max(0.0, neighborState.y) * 0.25;
        if (flux > 0.0)
            flux = min(flux, neighborBudget);
        else
            flux = max(flux, -edgeBudget);
        delta += flux;
    }

    state.y = max(0.0, state.y + delta);
    WriteCell(cell, material, state, flow, aux, ecology, combustion, life, genome);
}
