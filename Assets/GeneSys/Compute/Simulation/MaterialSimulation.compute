#pragma kernel ApplyEdits
#pragma kernel ThermalAndPressure
#pragma kernel PhaseChange
#pragma kernel MaterialMotion
#pragma kernel Electrical
#pragma kernel PressureDiffusion

#include "../../Shaders/Simulation/Common/SimulationStructs.hlsl"

Texture2D<uint> _MaterialRead;
RWTexture2D<uint> _MaterialWrite;
Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;
Texture2D<float2> _FlowRead;
RWTexture2D<float2> _FlowWrite;
Texture2D<float4> _AuxRead;
RWTexture2D<float4> _AuxWrite;
StructuredBuffer<MaterialGpuData> _MaterialDefinitions;
StructuredBuffer<BrushCommand> _BrushCommands;

int2 _GridSize;
int _Tick;
int _BrushCount;
float _DeltaTime;
float _PlayableInnerRadius;
float _AtmosphereStartRadius;
float4 _Mechanics;
float4 _Geology;
float4 _Hydrology;
float4 _Erosion;
float4 _WeatherA;
float4 _WeatherB;
float4 _WeatherC;
float4 _EruptionA;
float4 _EruptionB;
float4 _PressureA; // diffusionRate, equilibriumGradient, equilibriumMaximum, unused
float4 _PressureB; // gas, fluid, porous, rigid diffusivities

uint ReadMaterial(int2 cell) { cell = ClampCell(cell, _GridSize); return _MaterialRead.Load(int3(cell, 0)); }
float4 ReadState(int2 cell) { cell = ClampCell(cell, _GridSize); return _StateRead.Load(int3(cell, 0)); }
float2 ReadFlow(int2 cell) { cell = ClampCell(cell, _GridSize); return _FlowRead.Load(int3(cell, 0)); }
float4 ReadAux(int2 cell) { cell = ClampCell(cell, _GridSize); return _AuxRead.Load(int3(cell, 0)); }
MaterialGpuData Mat(uint id) { return _MaterialDefinitions[min(id, 255u)]; }

void CopyCell(int2 cell, out uint material, out float4 state, out float2 flow, out float4 aux)
{
    material = ReadMaterial(cell);
    state = ReadState(cell);
    flow = ReadFlow(cell);
    aux = ReadAux(cell);
}

void WriteCell(int2 cell, uint material, float4 state, float2 flow, float4 aux)
{
    _MaterialWrite[cell] = material;
    _StateWrite[cell] = SafeFinite4(state, float4(15, 0, 0, 0));
    _FlowWrite[cell] = clamp(flow, -20.0, 20.0);
    _AuxWrite[cell] = SafeFinite4(max(aux, 0.0), 0.0);
}

[numthreads(8, 8, 1)]
void ApplyEdits(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux;
    CopyCell(cell, material, state, flow, aux);

    for (int i = 0; i < _BrushCount; i++)
    {
        BrushCommand command = _BrushCommands[i];
        int dx = abs(cell.x - command.center.x);
        dx = min(dx, _GridSize.x - dx);
        int dy = cell.y - command.center.y;
        if (dx * dx + dy * dy > command.radius * command.radius) continue;
        int mode = (int)round(command.values.x);
        float falloff = 1.0 - saturate(sqrt((float)(dx * dx + dy * dy)) / max(1.0, (float)command.radius));
        if (mode == 0) material = command.materialId;
        else if (mode == 1) state.x += command.values.y * max(0.1, falloff);
        else if (mode == 2) state.z = max(0.0, state.z + command.values.y * max(0.1, falloff));
        else if (mode == 3) state.y += command.values.y * max(0.1, falloff);
        else if (mode == 4) aux.z += command.values.y * max(0.1, falloff);
        else if (mode == 5) aux.y = max(0.0, aux.y + command.values.y * max(0.1, falloff));
        else if (mode == 6) aux.x = max(0.0, aux.x + command.values.y * max(0.1, falloff));
    }
    WriteCell(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void ThermalAndPressure(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux;
    CopyCell(cell, material, state, flow, aux);
    MaterialGpuData definition = Mat(material);

    float neighborTemperature = ReadState(cell + int2(-1, 0)).x + ReadState(cell + int2(1, 0)).x
        + ReadState(cell + int2(0, -1)).x + ReadState(cell + int2(0, 1)).x;
    neighborTemperature *= 0.25;
    float conductivity = definition.transport.x;
    float heatCapacity = max(0.001, definition.transport.y);
    float deltaTemperature = (neighborTemperature - state.x) * conductivity * _Mechanics.y * _DeltaTime / heatCapacity;
    state.x += clamp(deltaTemperature, -25.0, 25.0);

    float expansion = abs(deltaTemperature) * definition.phase.z;
    state.y = max(0.0, state.y + expansion - state.y * _Mechanics.w * 0.01 * _DeltaTime);
    WriteCell(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void PhaseChange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux;
    CopyCell(cell, material, state, flow, aux);
    MaterialGpuData definition = Mat(material);
    uint packed = (uint)round(definition.metadata.y);
    uint solidId = packed & 1023u;
    uint liquidId = (packed >> 10) & 1023u;
    uint gasId = (packed >> 20) & 1023u;
    float hysteresis = max(0.001, _WeatherC.z);

    // Legacy Vapor pixels migrate to Air while preserving vapor/cloud mass fields.
    if (material == 11u)
    {
        material = 1u;
        WriteCell(cell, material, state, flow, aux);
        return;
    }
    if (definition.metadata.x == 1.0)
    {
        WriteCell(cell, material, state, flow, aux);
        return;
    }
    if (gasId > 0u && state.x > definition.phase.y + hysteresis)
    {
        // Boiling vacates the cell to Air and moves only existing liquid/ice mass into aux.x.
        float boiled = max(0.0, state.z);
        aux.x += boiled;
        state.z = 0.0;
        state.y += boiled * _WeatherC.x;
        material = 1u;
    }
    else if (liquidId > 0u && state.x > definition.phase.x + hysteresis)
    {
        material = liquidId;
    }
    else if (solidId > 0u && state.x < definition.phase.x - hysteresis)
    {
        material = solidId;
    }
    WriteCell(cell, material, state, flow, aux);
}

bool IsMovable(uint material)
{
    if (material == 12u) return false; // Ash uses dedicated AshTransport motion.
    float category = Mat(material).metadata.x;
    return category == 2.0 || category == 3.0 || category == 5.0;
}

bool IsOpen(uint material)
{
    float category = Mat(material).metadata.x;
    return material == 0u || category == 1.0;
}

int2 MovementDestination(int2 source)
{
    uint sourceMaterial = ReadMaterial(source);
    if (!IsMovable(sourceMaterial) || source.y <= 0) return source;
    int2 below = ClampCell(source + int2(0, -1), _GridSize);
    if (IsOpen(ReadMaterial(below))) return below;

    MaterialGpuData definition = Mat(sourceMaterial);
    if (definition.physical.y >= 0.9) return source;
    int direction = ((source.x + _Tick) & 1) == 0 ? -1 : 1;
    int2 diagonal = ClampCell(source + int2(direction, -1), _GridSize);
    if (IsOpen(ReadMaterial(diagonal))) return diagonal;
    return source;
}

[numthreads(8, 8, 1)]
void MaterialMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux;
    CopyCell(cell, material, state, flow, aux);

    int2 destination = MovementDestination(cell);
    if (IsMovable(material) && !all(destination == cell))
    {
        material = ReadMaterial(destination);
        state = ReadState(destination);
        flow = ReadFlow(destination);
        aux = ReadAux(destination);
    }
    else if (IsOpen(material) && cell.y < _GridSize.y - 1)
    {
        int2 source = ClampCell(cell + int2(0, 1), _GridSize);
        if (!all(MovementDestination(source) == cell))
        {
            int2 leftSource = ClampCell(cell + int2(-1, 1), _GridSize);
            int2 rightSource = ClampCell(cell + int2(1, 1), _GridSize);
            if (all(MovementDestination(leftSource) == cell)) source = leftSource;
            else if (all(MovementDestination(rightSource) == cell)) source = rightSource;
            else source = cell;
        }
        if (!all(source == cell))
        {
            material = ReadMaterial(source);
            state = ReadState(source);
            flow = ReadFlow(source);
            aux = ReadAux(source);
            flow.y -= _Mechanics.x * _DeltaTime;
        }
    }
    WriteCell(cell, material, state, flow, aux);
}

[numthreads(8, 8, 1)]
void Electrical(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux;
    CopyCell(cell, material, state, flow, aux);
    MaterialGpuData definition = Mat(material);
    float neighborCharge = ReadState(cell + int2(-1, 0)).w + ReadState(cell + int2(1, 0)).w
        + ReadState(cell + int2(0, -1)).w + ReadState(cell + int2(0, 1)).w;
    neighborCharge *= 0.25;
    float oldCharge = state.w;
    state.w += (neighborCharge - state.w) * definition.transport.z * _Mechanics.z * _DeltaTime;
    state.y += abs(state.w - oldCharge) * definition.phase.w;
    WriteCell(cell, material, state, flow, aux);
}

float PressureEquilibrium(int radiusIndex)
{
    float radius = Radius01(radiusIndex, _GridSize.y);
    return min(_PressureA.z, max(0.0, (1.0 - radius) * _PressureA.y));
}

float PressureConductance(uint material)
{
    MaterialGpuData definition = Mat(material);
    float category = definition.metadata.x;
    float porosity = saturate(definition.biology.z);
    float rigidity = saturate(definition.physical.y);
    float gas = max(0.0, _PressureB.x);
    float fluid = max(0.0, _PressureB.y);
    float porous = max(0.0, _PressureB.z);
    float rigid = max(0.0, _PressureB.w);

    // Empty/Gas → gas; Liquid/Magma → fluid; Granular/Biological → porosity blend;
    // Solid → porosity * (1 - rigidity) blend toward porous from rigid.
    if (category <= 1.0) return gas;
    if (category == 2.0 || category == 5.0) return fluid;
    if (category == 3.0 || category == 6.0) return lerp(rigid, porous, porosity);
    return lerp(rigid, porous, porosity * (1.0 - rigidity));
}

float HarmonicMean(float a, float b)
{
    float sum = a + b;
    if (sum <= 1e-8) return 0.0;
    return 2.0 * a * b / sum;
}

[numthreads(8, 8, 1)]
void PressureDiffusion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridSize.x || id.y >= (uint)_GridSize.y) return;
    int2 cell = id.xy;
    uint material; float4 state; float2 flow; float4 aux;
    CopyCell(cell, material, state, flow, aux);

    float rate = max(0.0, _PressureA.x);
    if (rate <= 1e-8)
    {
        WriteCell(cell, material, state, flow, aux);
        return;
    }

    float alpha = 1.0 - exp(-rate * _DeltaTime);
    float selfConductance = PressureConductance(material);
    float selfEquilibrium = PressureEquilibrium(cell.y);
    float selfAnomaly = state.y - selfEquilibrium;
    float available = max(0.0, state.y);
    float edgeBudget = available * 0.25;
    float delta = 0.0;

    int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        int2 offset = offsets[i];
        // Radial edges are no-flux; angular neighbors wrap via ClampCell.
        if (offset.y != 0)
        {
            int neighborY = cell.y + offset.y;
            if (neighborY < 0 || neighborY >= _GridSize.y) continue;
        }

        int2 neighbor = ClampCell(cell + offset, _GridSize);
        uint neighborMaterial = ReadMaterial(neighbor);
        float4 neighborState = ReadState(neighbor);
        float edgeConductance = HarmonicMean(selfConductance, PressureConductance(neighborMaterial));
        float neighborAnomaly = neighborState.y - PressureEquilibrium(neighbor.y);
        float flux = edgeConductance * (neighborAnomaly - selfAnomaly) * alpha * 0.25;
        if (flux < 0.0)
            flux = max(flux, -edgeBudget);
        delta += flux;
    }

    state.y = max(0.0, state.y + delta);
    WriteCell(cell, material, state, flow, aux);
}
